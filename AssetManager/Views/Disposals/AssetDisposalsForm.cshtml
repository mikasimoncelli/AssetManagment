@model AssetManager.Models.Asset

<div class="container-wrapper">
    <form asp-action="AssetDisposalForm" method="post">
        <div class="form-container">
            <h2 class="text-center display-4">Disposal Form</h2>
            <p class="text-center">Please double-check all details are correct.</p>

            <h4 class="section-title">Equipment Details</h4>
            <div class="form-group row">
                <div class="col-md-6">
                    <input type="hidden" name="assetID" value="@Model.AssetID" />
                    <input type="hidden" id="userID" name="UserID" />
                    <label>Description:</label>
                    <p class="form-control-plaintext">@Model.Description</p>
                </div>
                <div class="col-md-6">
                    <label>Manufacturer:</label>
                    <p class="form-control-plaintext">@Model.Manufacturer</p>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>Asset Number:</label>
                    <p class="form-control-plaintext">@Model.AssetNumber</p>
                </div>
                <div class="col-md-6">
                    <label>Serial Number:</label>
                    <p class="form-control-plaintext">@Model.SerialNumber</p>
                </div>
            </div>

            <h4 class="section-title">Disposal Report Details</h4>

            <div class="form-group row">
                <div class="col-md-6">
                    <label>Disposal Reason:</label>
                    <select name="DisposalReason" id="damageReason" class="form-control" required onchange="toggleOtherReasonInput()">
                        <option value="">Select a reason...</option>
                        <option value="Physical Damage">Physical Damage</option>
                        <option value="Electrical Fault">Electrical Damage</option>
                        <option value="Water Damage">Water Damage</option>
                        <option value="Software Malfunction">Software Malfunction</option>
                        <option value="Hardware Failure">Hardware Failure</option>
                        <option value="Display Issue">Display Issue</option>
                        <option value="Input Issue">Keyboard or Input Issue</option>
                        <option value="Normal Wear and Tear">Old or Unused Equipment</option>
                        <option value="System Failure">Software or System Failure</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <!-- Hidden input for custom reason if "Other" is selected -->
            <div class="form-group row" id="otherReasonContainer" style="display: none;">
                <div class="col-md-6">
                    <label>Specify Other Reason:</label>
                    <input type="text" name="OtherReason" class="form-control" required placeholder="Please specify the reason">
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-6">
                    <label>Disposal Status:</label>
                    <select name="DisposalStatus" class="form-control" required>
                        <option value="Pending">Pending</option>
                        <option value="Disposed">Disposed</option>
                    </select>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-6">
                    <label>Disposal Date:</label>
                    <input name="DateDisposed" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label>Description of Disposal:</label>
                <textarea name="DisposalDescription" rows="5" required class="form-control" placeholder="Describe the damage..."></textarea>
            </div>

            <div class="form-group">
                <label>Additional Notes:</label>
                <textarea name="Notes" rows="5" class="form-control" placeholder="Add any additional notes here..."></textarea>
            </div> 

            <div class="button-group">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </form>
</div>
   

<style>
    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;
    }

    .form-container {
        width: 1000px;
        padding: 50px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    h2.text-center {
        font-weight: 600;
        color: #333;
        margin-bottom: 30px;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #555;
        border-bottom: 2px solid #ccc;
        margin-top: 30px;
        margin-bottom: 20px;
        padding-bottom: 10px;
    }

    label {
        font-weight: bold;
        color: #333;
    }

    .form-control-plaintext {
        background-color: #e9ecef;
        padding: 15px;
        border-radius: 4px;
    }

    .form-control {
        border-radius: 4px;
        padding: 12px;
    }

    textarea.form-control {
        min-height: 100px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

    .btn-primary:hover, .btn-secondary:hover {
        opacity: 0.9;
    }
</style>





<script>
    function toggleOtherReasonInput() {
        const damageReason = document.getElementById("damageReason").value;
        const otherReasonContainer = document.getElementById("otherReasonContainer");
        const otherReasonInput = document.querySelector("input[name='OtherReason']");

        if (damageReason === "Other") {
            otherReasonContainer.style.display = "block";
            otherReasonInput.required = true;
        } else {
            otherReasonContainer.style.display = "none";
            otherReasonInput.required = false;
        }
    }

    // Ensure this function runs when the form loads, in case "Other" is already selected
    document.addEventListener("DOMContentLoaded", toggleOtherReasonInput);

</script>