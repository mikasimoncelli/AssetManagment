@model IEnumerable<AssetManager.Models.AssetDisposal>
@{
    ViewData["Title"] = "All Disposals";
}
<div class="container-wrapper">
    <div class="form-container">
        <div class="logo-top-right">
            <img src="~/images/Favicon.jpg" alt="Company Logo" class="img-fluid">
        </div>
        <h3 class="text-center mt-4 mb-4 pb-3">All Disposed Assets</h3>
        <p class="text-muted mt-2 text-center" style="font-size: 0.875rem;">View all disposed assets and pending disposals below. Select a row to open and update the disposal report.</p>

        <div class="row justify-content-center mb-3">
            <div class="col-md-10">
                <h6 class="form-label">Filter by Asset Type:</h6>
                <select id="assetTypeDropdown" class="form-control mb-3" onchange="filterAssetType()">
                    <option value="">All Asset Types</option>
                    @foreach (var type in Model.Select(m => m.Asset?.EquipmentType).Distinct())
                    {
                        <option value="@type">@type</option>
                    }
                </select>

                <div class="input-group mb-3">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search disposed assets..." onkeyup="applyGlobalSearch()" style="margin-right: 20px;" />
                    <button type="button" class="btn btn-primary" onclick="resetAllFilters()">Reset Search</button>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-10">
                <h5>Pending Disposals</h5>
                <!-- Edit button, initially hidden -->
                <button id="editButton" class="btn btn-primary mb-3" style="display: none;" onclick="openEditModal(false)">Edit</button>

                <div class="table-responsive">
                    <div class="equipment-type-section">
                        <table class="table table-bordered text-center table-sm asset-table" id="pending-table">
                            <thead>
                                <tr style="background-color: #0b3d91; color: #fff;">
                                    <th><input type="checkbox" id="selectAll" onclick="toggleSelectAll()" /></th>
                                    <th>Disposal Reason</th>
                                    <th>Asset Type</th>
                                    <th>Manufacturer</th>
                                    <th>Asset Number</th>
                                    <th>Serial Number</th>
                                    <th>Date Disposed</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assetDisposal in Model.Where(ad => ad.DisposalStatus == "Pending"))
                                {
                                    <tr onclick="window.location.href='@Url.Action("EditDisposal", "Disposals", new { id = assetDisposal.AssetDisposalID })'" style="cursor: pointer;">
                                        <td><input type="checkbox" class="select-row" data-id="@assetDisposal.AssetDisposalID" onchange="toggleEditButton()" onclick="stopPropagation(event)" /></td>
                                        <td>@assetDisposal.DisposalReason</td>
                                        <td>@assetDisposal.Asset?.EquipmentType</td>
                                        <td>@assetDisposal.Asset?.Manufacturer</td>
                                        <td>@assetDisposal.Asset?.AssetNumber</td>
                                        <td>@assetDisposal.Asset?.SerialNumber</td>
                                        <td>@assetDisposal.DateDisposed?.ToString("yyyy-MM-dd")</td>
                                        <td>@assetDisposal.Notes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>


        <div class="row justify-content-center mt-5">
            <div class="col-md-10">
                <h5>Disposed Assets</h5>
                <!-- Edit button for Disposed Assets, initially hidden -->
                <p id="editDisposedButton" class="btn btn-primary mb-3" style="display: none;" onclick="openEditModal(true)">Edit</p>

                <div class="table-responsive">
                    <div class="equipment-type-section">
                        <table class="table table-bordered text-center table-sm asset-table" id="disposed-table">
                            <thead>
                                <tr style="background-color: #0b3d91; color: #fff;">
                                    <th><input type="checkbox" id="selectAllDisposed" onclick="toggleSelectAllDisposed()" /></th>
                                    <th>Disposal Reason</th>
                                    <th>Asset Type</th>
                                    <th>Manufacturer</th>
                                    <th>Asset Number</th>
                                    <th>Serial Number</th>
                                    <th>Date Disposed</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assetDisposal in Model.Where(ad => ad.DisposalStatus == "Disposed"))
                                {
                                    <tr onclick="window.location.href='@Url.Action("EditDisposal", "Disposals", new { id = assetDisposal.AssetDisposalID })'" style="cursor: pointer;">
                                        <td><input type="checkbox" class="select-row-disposed" data-id="@assetDisposal.AssetDisposalID" onchange="toggleEditDisposedButton()" onclick="stopPropagation(event)" /></td>
                                        <td>@assetDisposal.DisposalReason</td>
                                        <td>@assetDisposal.Asset?.EquipmentType</td>
                                        <td>@assetDisposal.Asset?.Manufacturer</td>
                                        <td>@assetDisposal.Asset?.AssetNumber</td>
                                        <td>@assetDisposal.Asset?.SerialNumber</td>
                                        <td>@assetDisposal.DateDisposed?.ToString("yyyy-MM-dd")</td>
                                        <td>@assetDisposal.Notes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="editModal" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Selected Disposals</h5>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <div class="form-group">
                        <label for="newStatus">Status:</label>
                        <select id="newStatus" class="form-control">
                            <option value="">Select Status</option>
                            <option value="Pending">Pending</option>
                            <option value="Disposed">Disposed</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="newDate">Date Disposed:</label>
                        <input type="date" id="newDate" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="additionalNotes">Additional Notes:</label>
                        <textarea id="additionalNotes" class="form-control" placeholder="Add notes..."></textarea>
                    </div>
                </form>
            </div>
            <div class="button-group">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="closeDisposalsModal()">Cancel</button>

                <button type="button" class="btn btn-primary" onclick="submitEditForm()" disabled>Save changes</button>
            </div>
        </div>
    </div>
</div>


<script>

    function closeDisposalsModal() {
        // Hide the modal using Bootstrap's modal method
        $('#editModal').modal('hide');

        // Reset modal dataset status (if applicable)
        document.getElementById('editModal').dataset.status = '';

        // Reset modal fields to their default values
        const statusField = document.getElementById('newStatus');
        const dateField = document.getElementById('newDate');
        const notesField = document.getElementById('additionalNotes');

        statusField.value = ''; // Reset dropdown to default
        dateField.value = '';   // Clear the date input
        notesField.value = '';  // Clear the textarea input

        // Optionally disable the Save button again if needed
const saveButton = document.querySelector('.button-group .btn-primary');
        if (saveButton) saveButton.disabled = true;
    }


    // Update the filter functions to work on both tables
    function filterAssetType() {
        const selectedType = document.getElementById("assetTypeDropdown").value.toLowerCase();
        ['pending-table', 'disposed-table'].forEach(tableId => {
            document.querySelectorAll(`#${tableId} tbody tr`).forEach(row => {
                const assetType = row.cells[1].textContent.toLowerCase();
                row.style.display = selectedType && assetType !== selectedType ? "none" : "";
            });
        });
    }

    function applyGlobalSearch() {
        const searchValue = document.getElementById('searchInput').value.toLowerCase();
        ['pending-table', 'disposed-table'].forEach(tableId => {
            document.querySelectorAll(`#${tableId} tbody tr`).forEach(row => {
                const rowText = Array.from(row.cells).map(cell => cell.textContent.toLowerCase()).join(" ");
                row.style.display = rowText.includes(searchValue) ? "" : "none";
            });
        });

    }

    function resetAllFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('assetTypeDropdown').value = '';
        ['pending-table', 'disposed-table'].forEach(tableId => {
            document.querySelectorAll(`#${tableId} tbody tr`).forEach(row => row.style.display = "");
        });
    }





    function toggleEditButton() {
        const selectedRows = document.querySelectorAll('.select-row:checked');
        document.getElementById('editButton').style.display = selectedRows.length > 0 ? 'inline-block' : 'none';
    }

    function toggleSelectAll() {
        const isChecked = document.getElementById('selectAll').checked;
        document.querySelectorAll('.select-row').forEach(checkbox => {
            checkbox.checked = isChecked;
        });
        toggleEditButton();
    }



    let isEditingDisposed = false;

    function openEditModal(isDisposed = false) {
        isEditingDisposed = isDisposed;
        $('#editModal').modal('show');
    }



function submitEditForm() {
    const selectedClass = isEditingDisposed ? '.select-row-disposed' : '.select-row';
    const selectedIds = Array.from(document.querySelectorAll(`${selectedClass}:checked`)).map(cb => cb.getAttribute('data-id'));

    const newStatus = document.getElementById('newStatus').value;  // The new status (pending/disposed)
    const newDate = document.getElementById('newDate').value;
    const additionalNotes = document.getElementById('additionalNotes').value;

    // Ensure at least one field is selected for the bulk update
    if (!newStatus && !newDate && !additionalNotes) {
        alert('Please select at least one field to update.');
        return;
    }

    const payload = {
        ids: selectedIds
    };

    // Only add fields to payload if they are not empty
    if (newStatus) payload.status = newStatus;
    if (newDate) payload.dateDisposed = newDate;
    if (additionalNotes) payload.additionalNotes = additionalNotes;

    fetch('/Disposals/BulkUpdate', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
    })
    .then((response) => {
        if (response.ok) {
            location.reload(); // Reload page to show changes
        } else {
            alert('Failed to update disposals.');
        }
    })
    .catch((error) => {
        console.error('Error:', error);
        alert('An unexpected error occurred.');
    });

    $('#editModal').modal('hide');
}






    function toggleEditDisposedButton() {
        const selectedRows = document.querySelectorAll('.select-row-disposed:checked');
        document.getElementById('editDisposedButton').style.display = selectedRows.length > 0 ? 'inline-block' : 'none';
    }

    function toggleSelectAllDisposed() {
        const isChecked = document.getElementById('selectAllDisposed').checked;
        document.querySelectorAll('.select-row-disposed').forEach(checkbox => {
            checkbox.checked = isChecked;
        });
        toggleEditDisposedButton();
    }


    function stopPropagation(event) {
        event.stopPropagation();
    }



document.addEventListener('DOMContentLoaded', () => {
    const saveButton = document.querySelector('.button-group .btn-primary');
    const statusField = document.getElementById('newStatus');
    const dateField = document.getElementById('newDate');
    const notesField = document.getElementById('additionalNotes');

    // Track which fields are modified
    const modifiedFields = {
        status: false,
        date: false,
        notes: false,
    };

    // Store initial values
    let initialValues = {
        status: statusField.value,
        date: dateField.value,
        notes: notesField.value,
    };

    // Function to check if any field is modified
    function checkForChanges() {
        modifiedFields.status = statusField.value !== initialValues.status;
        modifiedFields.date = dateField.value !== initialValues.date;
        modifiedFields.notes = notesField.value !== initialValues.notes;

        // Enable Save button if any field is modified
        const hasChanged = Object.values(modifiedFields).some(value => value);
        saveButton.disabled = !hasChanged;
    }

    // Event listeners for detecting changes
    statusField.addEventListener('change', () => {
        checkForChanges();
    });
    dateField.addEventListener('input', () => {
        checkForChanges();
    });
    notesField.addEventListener('input', () => {
        checkForChanges();
    });

    // Submit form with only modified fields
    function submitEditForm() {
        const selectedClass = isEditingDisposed ? '.select-row-disposed' : '.select-row';
        const selectedIds = Array.from(document.querySelectorAll(`${selectedClass}:checked`)).map(cb => cb.getAttribute('data-id'));

        // Create payload with only modified fields
        const payload = {
            ids: selectedIds,
        };

        if (modifiedFields.status) payload.status = statusField.value;
        if (modifiedFields.date) payload.dateDisposed = dateField.value;
        if (modifiedFields.notes) payload.additionalNotes = notesField.value;

        // Send AJAX request to update the backend
        fetch('/Disposals/BulkUpdate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
        }).then(response => {
            if (response.ok) {
                location.reload(); // Reload the page to reflect changes
            } else {
                alert('Failed to update disposals.');
            }
        });

        $('#editModal').modal('hide');
    }

    // Attach submit handler
    saveButton.addEventListener('click', submitEditForm);

    // Reset fields when modal closes
    $('#editModal').on('hidden.bs.modal', () => {
        initialValues = {
            status: '',
            date: '',
            notes: '',
        };
        modifiedFields.status = false;
        modifiedFields.date = false;
        modifiedFields.notes = false;
        saveButton.disabled = true;
    });
});



</script>
<style>
    .modal {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        top: calc(50% + 200px);
        left: calc(50% + 50px);
    }


    .modal-content {
        padding: 20px;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;
        min-height: 100vh;
    }

    .form-container {
        width: 2100px;
        padding: 20px;
        border: 2px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    .container-fluid {
        background-color: #f8f9fa;
    }

    .asset-table {
        width: 100%;
        border: solid 1px #ddd;
    }

    th, td {
        padding: 8px;
        cursor: pointer;
    }

    th:hover, tr:hover {
        background-color: #dcdcdc;
    }

    .equipment-type-section {
        margin-bottom: 30px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    .logo-top-right {
        position: absolute;
        top: 40px; /* Adjust as needed */
        right: 90px; /* Adjust as needed */
    }

        .logo-top-right img {
            max-width: 100px; /* Adjust the size as needed */
            height: auto;
        }
</style>
