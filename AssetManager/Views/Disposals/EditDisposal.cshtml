@model AssetManager.Models.AssetDisposal
@{
    ViewData["Title"] = "Edit Disposal";
}

@* Edit Disposal *@
<div class="container-wrapper">
    <form asp-action="EditDisposal" method="post">
        <input type="hidden" asp-for="AssetDisposalID" />
        <div class="form-container-small">
            <h3 class="text-center">Edit Disposal Report</h3>
            <h4 class="section-title">Equipment Details</h4>
            <div class="equipment-details-box">
                <div class="form-group row">
                    <div class="col-md-4">
                        <label>Description:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Description</p>
                    </div>
                    <div class="col-md-4">
                        <label>Manufacturer:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Manufacturer</p>
                    </div>
                    <div class="col-md-4">
                        <label>Asset Number:</label>
                        <p class="form-control-plaintext">@Model.Asset?.AssetNumber</p>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4">
                        <label>Serial Number:</label>
                        <p class="form-control-plaintext">@Model.Asset?.SerialNumber</p>
                    </div>
                    <div class="col-md-4">
                        <label>Office Name:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Office?.OfficeName</p>
                    </div>
                    <div class="col-md-4">
                        <label>Location:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Office?.Location</p>
                    </div>
                </div>
            </div>

            <h4 class="section-title display-6">Disposal Report Details</h4>

            <div class="form-group row">
                <div class="form-group row">
                    <div class="col-md-6">
                        <label>Disposal Status:</label>
                        <select asp-for="DisposalStatus" class="form-control">
                            <option value="Pending">Pending</option>
                            <option value="Disposed">Disposed</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <label>Disposal Date:</label>
                    <input asp-for="DateDisposed" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label>Description of Disposal:</label>
                <textarea asp-for="DisposalDescription" rows="5" class="form-control" placeholder="Describe the disposal..."></textarea>
            </div>

            <div class="form-group">
                <label>Additional Notes:</label>
                <textarea asp-for="Notes" rows="5" class="form-control" placeholder="Add any additional notes here..."></textarea>
            </div>
        

        <div class="button-group">
                <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Back</a>

            <button type="submit" style="width: 150px;" class="btn btn-primary">Save Changes</button>
            <button type="button" class="btn btn-danger" onclick="openDeleteModal(@Model.AssetDisposalID)">
                Delete Disposal
            </button>
        </div>
        </div>
    </form>
</div>




<!-- Delete Disposal Modal -->
<div id="deleteDisposalModal" class="modal">
    <div class="modal-content">
        <h5>Confirm Delete Disposal</h5>
        <p>Are you sure you want to delete this disposal report?</p>
        <input type="checkbox" id="confirmDeleteDisposalCheckbox" onclick="toggleDeleteDisposalButton()">
        <label for="confirmDeleteDisposalCheckbox">I understand the consequences of deleting this disposal report.</label>
        <div class="mt-3">
            <div class="button-group">
                <button onclick="closeDeleteModal()" class="btn btn-secondary">Cancel</button>

                <button id="confirmDeleteDisposalButton" class="btn btn-danger" disabled onclick="executeDeleteDisposal(@Model.AssetDisposalID)">
                    Confirm
                </button>
            </div>

        </div>
    </div>
</div>


<style>
    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;
    }

    .form-container {
        width: 1000px;
        padding: 50px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    h1.text-center {
        font-weight: 600;
        color: #333;
        margin-bottom: 30px;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #555;
        border-bottom: 2px solid #ccc;
        margin-top: 30px;
        margin-bottom: 20px;
        padding-bottom: 10px;
    }

    label {
        font-weight: bold;
        color: #333;
    }

    .form-control-plaintext {
        background-color: #e9ecef;
        padding: 15px;
        border-radius: 4px;
    }

    .form-control {
        border-radius: 4px;
        padding: 12px;
    }

    textarea.form-control {
        min-height: 100px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

        .btn-primary:hover, .btn-secondary:hover {
            opacity: 0.9;
        }

    .modal {
        display: none; /* Hidden by default */
        position: fixed;
        z-index: 1000;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7); /* Darker overlay for better readability */
        align-items: center; /* Centers modal vertically */
        justify-content: center; /* Centers modal horizontally */
    }



    .modal-content {
        background-color: #fff;
        position: relative;
        padding: 20px;
        border: 1px solid #888;
        width: 600px;
        text-align: center;
        font-size: 1.0em; /* Larger font size for readability */
        color: #333;
        margin-bottom: 20px; /* Spacing below message */

        .modal-content h5 {
            margin-bottom: 15px;
            font-size: 18px;
            color: #333;
        }

        .modal-content p {
            font-size: 16px;
            color: #666;
        }

        .modal-content label {
            display: block;
            margin-top: 10px;
        }

        .modal-content .btn {
            padding: 10px 20px;
            border-radius: 4px;
            font-size: 14px;
        }

        .modal-content .btn-danger {
            background-color: #dc3545;
            border: none;
            color: #fff;
        }

            .modal-content .btn-danger:hover {
                background-color: #c82333;
            }

        .modal-content .btn-secondary {
            background-color: #6c757d;
            border: none;
            color: #fff;
        }

            .modal-content .btn-secondary:hover {
                background-color: #5a6268;
            }

</style>

<script>
    function openDeleteModal(disposalID) {
        document.getElementById("confirmDeleteDisposalButton").setAttribute("onclick", `executeDeleteDisposal(${disposalID})`);
        document.getElementById("deleteDisposalModal").style.display = "flex";
    }

    function closeDeleteModal() {
        document.getElementById("deleteDisposalModal").style.display = "none";
    }

    function toggleDeleteDisposalButton() {
        const checkbox = document.getElementById("confirmDeleteDisposalCheckbox");
        const deleteButton = document.getElementById("confirmDeleteDisposalButton");
        deleteButton.disabled = !checkbox.checked;
    }

    function executeDeleteDisposal(disposalID) {
        fetch(`/Disposals/DeleteDisposal/${disposalID}`, {
            method: "POST"
        })
            .then(response => {
                if (response.ok) {
                    alert("Disposal report deleted successfully.");
                    window.location.href = '/Disposals'; // Redirect to disposals list
                } else {
                    alert("Failed to delete disposal report.");
                }
                closeDeleteModal();
            })
            .catch(error => {
                console.error('Error:', error);
                alert("An error occurred. Please try again.");
            });
    }
</script>

