@model AssetManager.Models.AssetDisposal

<div class="container-wrapper">
    <form asp-action="EditDisposal" method="post">
        <input type="hidden" asp-for="AssetDisposalID" />
        <div class="form-container">
            <h1 class="text-center display-4">Edit Disposal Report</h1>

            <h4 class="section-title display-6">Equipment Details</h4>
            <div class="equipment-details-box">
                <div class="form-group row">
                    <div class="col-md-4">
                        <label>Description:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Description</p>
                    </div>
                    <div class="col-md-4">
                        <label>Manufacturer:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Manufacturer</p>
                    </div>
                    <div class="col-md-4">
                        <label>Asset Number:</label>
                        <p class="form-control-plaintext">@Model.Asset?.AssetNumber</p>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-4">
                        <label>Serial Number:</label>
                        <p class="form-control-plaintext">@Model.Asset?.SerialNumber</p>
                    </div>
                </div>
            </div>

            <h4 class="section-title display-6">Disposal Report Details</h4>

            <div class="form-group row">
                <div class="form-group row">
                    <div class="col-md-6">
                        <label>Disposal Status:</label>
                        <select asp-for="DisposalStatus" class="form-control">
                            <option value="Pending">Pending</option>
                            <option value="Disposed">Disposed</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <label>Disposal Date:</label>
                    <input asp-for="DateDisposed" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label>Description of Disposal:</label>
                <textarea asp-for="DisposalDescription" rows="5" class="form-control" placeholder="Describe the disposal..."></textarea>
            </div>

            <div class="form-group">
                <label>Additional Notes:</label>
                <textarea asp-for="Notes" rows="5" class="form-control" placeholder="Add any additional notes here..."></textarea>
            </div>

            <div class="button-group">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </form>
</div>

<style>
    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;
    }

    .form-container {
        width: 1000px;
        padding: 50px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    h1.text-center {
        font-weight: 600;
        color: #333;
        margin-bottom: 30px;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #555;
        border-bottom: 2px solid #ccc;
        margin-top: 30px;
        margin-bottom: 20px;
        padding-bottom: 10px;
    }

    label {
        font-weight: bold;
        color: #333;
    }

    .form-control-plaintext {
        background-color: #e9ecef;
        padding: 15px;
        border-radius: 4px;
    }

    .form-control {
        border-radius: 4px;
        padding: 12px;
    }

    textarea.form-control {
        min-height: 100px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

        .btn-primary:hover, .btn-secondary:hover {
            opacity: 0.9;
        }
</style>
