<br /><br />
@model AssetManager.Models.User
@{
    ViewData["Title"] = "Edit User";
}
<div class="form-container">
<h3 class="text-center">Edit User</h3>

    <!-- Update User Form -->
    <form method="post" action="@Url.Action("UpdateUser", "Users")" class="mt-4">
        <input type="hidden" name="UserID" value="@Model.UserID" />
        <p class="text-muted mt-2 text-center pb-3">Edit User details below by updating information and clicking Save Changes.</p>

        <div class="form-group">
            <label for="FirstName">First Name</label>
            <input type="text" class="form-control" id="FirstName" name="FirstName" value="@Model.FirstName" placeholder="Enter first name" />
        </div>

        <div class="form-group">
            <label for="LastName">Last Name</label>
            <input type="text" class="form-control" id="LastName" name="LastName" value="@Model.LastName" placeholder="Enter last name" />
        </div>

        <div class="form-group">
            <label for="Email">Email</label>
            <input type="email" class="form-control" id="Email" name="Email" value="@Model.Email" placeholder="Enter email" />
        </div>



        <div class="button-group">
            <button type="submit" class="btn btn-primary" style="width: 150px;">Save Changes</button>
        </form>
        <button type="button" class="btn btn-secondary" style="width: 150px;" onclick="window.location.href='@Url.Action("ViewUser", "Users", new { id = Model.UserID })'">
        Back
        </button>
        <button type="button" class="btn btn-danger" style="width: 150px;" onclick="confirmDeleteUser(@Model.UserID)">
            Delete User
        </button>
        </div>

    </div>

    <!-- Delete User Modal -->
    <div id="deleteUserModal" class="modal">
        <div class="modal-content">
            <h5>Confirm Delete User</h5>
            <div id="deleteUserMessage">Are you sure you want to delete this user?</div>
            <div style="margin-top: 15px;">
            <input type="checkbox" id="confirmDeleteUserCheckbox" onclick="toggleDeleteUserButton()">
            <label for="confirmDeleteUserCheckbox"><solid>I understand the consequences of deleting this user.</solid></label>
            </div>
            <div class="mt-3">
                <div class="button-group">
                <button type="button" onclick="closeDeleteUserModal()" class="btn btn-secondary">Cancel</button>

                <button id="confirmDeleteUserButton" class="btn btn-danger" disabled>Confirm</button>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>
    function confirmDeleteUser(userID, event) {
        if (event) event.preventDefault();

        fetch(`/Users/CheckUserReferences?userID=${userID}`)
            .then(response => response.json())
            .then(data => {
                const deleteMessage = document.getElementById("deleteUserMessage");

                if (data.hasReferences) {
                    // If references exist, display details
                    deleteMessage.innerHTML = `
                        <p>This user has the following checked-out records:</p>
                        <ul class="text-center">
                                <li class="text-center"><strong>Asset:</strong> ${data.assetDescription || 'Unknown'} <strong>Date Lent:</strong> ${data.checkedOutDate || 'N/A'}</li>
                                <a class="text-center" href="/CheckedOutAssets/EditCheckedOutAsset?checkedoutid=${data.checkedOutID}" target="_blank">View Loan Record</a>

                        </ul>
                        <br>
                        <p>Do you still want to delete this user?</p>
                    `;
                } else {
                    // If no references exist, show simple confirmation
                    deleteMessage.textContent = "Are you sure you want to delete this user?";
                }

                // Set the user ID for deletion
                document.getElementById("confirmDeleteUserButton").setAttribute("onclick", `executeDeleteUser(${userID})`);
                document.getElementById("deleteUserModal").style.display = "flex";
            })
            .catch(error => console.error('Error:', error));
    }

    function executeDeleteUser(userID) {
        fetch(`/Users/DeleteUser`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ userID })
        })
            .then(response => {
                if (response.ok) {
                    alert("User deleted successfully.");
                    window.location.href = '/Users';
                } else {
                    alert("Failed to delete user.");
                }
                closeDeleteUserModal();
            })
            .catch(error => console.error('Error:', error));
    }

    function closeDeleteUserModal() {
        document.getElementById("deleteUserModal").style.display = "none";
    }

    function toggleDeleteUserButton() {
        const checkbox = document.getElementById("confirmDeleteUserCheckbox");
        const deleteButton = document.getElementById("confirmDeleteUserButton");
        deleteButton.disabled = !checkbox.checked;
    }

</script>

<style>

    .button-group {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }


    .form-container {
        padding-top: 20px;
        margin: 0 auto;
        padding: 30px;
        max-width: 1000px;
        border: 1px solid #ccc;
        border-radius: 10px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }

    h5 {
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .btn-block {
        width: 100%;
        padding: 10px;
    }


    .modal {
        display: none; /* Ensure it's hidden by default */
        position: fixed;
        z-index: 1000;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        align-items: center; /* Only applies when displayed */
        justify-content: center; /* Only applies when displayed */
    }


    .modal-content {
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
        width: 500px;
    }

        .modal-content h5 {
            margin-bottom: 15px;
        }

        .modal-content ul {
            text-align: left;
            list-style: none;
            padding: 0;
            margin: 10px 0;
        }

            .modal-content ul li {
                margin-bottom: 10px;
            }

               label {
        font-weight: bold;
        color: #333;
    }

</style>
