<br /><br />
<div class="form-container">
    <h5 class="text-center display-4">@Model.FirstName @Model.LastName</h5>

    <input type="hidden" name="UserID" value="@Model.UserID" />

    <div class="form-group">
        <label for="FirstName">First Name</label>
        <input type="text" class="form-control" id="FirstName" value="@Model.FirstName" readonly />
    </div>

    <div class="form-group">
        <label for="LastName">Last Name</label>
        <input type="text" class="form-control" id="LastName" value="@Model.LastName" readonly />
    </div>

    <div class="form-group">
        <label for="Email">Email</label>
        <input type="email" class="form-control" id="Email" value="@Model.Email" readonly />
    </div>

    <button type="button" class="btn btn-primary mt-3" onclick="location.href='@Url.Action("EditUser", "Users", new { id = Model.UserID })'">
        Edit User
    </button>

    <h5 class="mt-4 display-6">Current Loans</h5>
    @if (ViewData["CurrentLoans"] is List<CheckedOutAsset> currentLoans && currentLoans.Any())
    {
        <table class="table table-bordered mt-3 clickable-table">
            <thead>
                <tr>
                    <th>Asset Name</th>
                    <th>Date Loaned</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in currentLoans)
                {
                    <tr onclick="location.href='@Url.Action("EditCheckedOutAsset", new { checkedoutid = loan.CheckedOutID })';">
                        <td>@loan.Asset.Description</td>
                        <td>@loan.DateLentOut.ToString("dd-MM-yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No current loans available for this user.</p>
    }

    <h5 class="mt-4 display-6">Previous Loans</h5>
    @if (ViewData["PreviousLoans"] is List<CheckedOutAsset> previousLoans && previousLoans.Any())
    {
        <table class="table table-bordered mt-3 clickable-table">
            <thead>
                <tr>
                    <th>Asset Name</th>
                    <th>Date Loaned</th>
                    <th>Date Returned</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in previousLoans)
                {
                    <tr onclick="location.href='@Url.Action("EditCheckedOutAsset", new { checkedoutid = loan.CheckedOutID })';">
                        <td>@loan.Asset.Description</td>
                        <td>@loan.DateLentOut.ToString("dd-MM-yyyy")</td>
                        <td>@loan.DateReturned?.ToString("dd-MM-yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No previous loans available for this user.</p>
    }
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .form-container {
        padding-top: 20px;
        margin: 0 auto;
        padding: 30px;
        max-width: 1000px;
        border: 1px solid #ccc;
        border-radius: 10px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }

    h5 {
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .btn-block {
        width: 100%;
        padding: 10px;
    }

    table {
        margin-top: 20px;
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

        table th, table td {
            padding: 10px;
            border: 1px solid #ccc;
        }

        table th {
            background-color: #f7f7f7;
            font-weight: bold;
        }

  
    .clickable-table tr {
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

    .clickable-table tr:hover {
        background-color: #f8f9fa; /* Light gray hover background */
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); /* Subtle shadow effect */
    }

    .clickable-table tr:active {
        background-color: #e2e6ea; /* Slightly darker background on click */
    }


</style>
