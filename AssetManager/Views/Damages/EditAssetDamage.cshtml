@model AssetManager.Models.AssetDamage
@{
    ViewData["Title"] = "Edit Damage";
}

<div class="container-wrapper">
    <form asp-action="EditAssetDamage" method="post">
        <input type="hidden" asp-for="AssetDamageID" />
        <div class="form-container">
            <h3 class="text-center">Edit Damage Report</h3>

            <h5 class="section-title">Equipment Details</h5>
            <div class="equipment-details-box">
                <div class="form-group row">
                    <div class="col-md-4">
                        <label>Description:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Description</p>
                    </div>
                    <div class="col-md-4">
                        <label>Manufacturer:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Manufacturer</p>
                    </div>
                    <div class="col-md-4">
                        <label>Asset Number:</label>
                        <p class="form-control-plaintext">@Model.Asset?.AssetNumber</p>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-4">
                        <label>Serial Number:</label>
                        <p class="form-control-plaintext">@Model.Asset?.SerialNumber</p>
                    </div>
                    <div class="col-md-4">
                        <label>Office Name:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Office?.OfficeName</p>
                    </div>
                    <div class="col-md-4">
                        <label>Location:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Office?.Location</p>
                    </div>
                </div>
            </div>

            <h5 class="section-title">Damage Report Details</h5>

            <div class="form-group row">


                <div class="col-md-6">
                    <label>Date Reported:</label>
                    <input asp-for="DateReported" type="date" class="form-control" readonly />
                </div>
                <div class="col-md-6">
                    <label>Repair Date:</label>
                    <input asp-for="RepairDate" type="date" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label>Damage Status:</label>
                    <select asp-for="RepairStatus" class="form-control" required>
                        <option value="Pending">Pending</option>
                        <option value="In-Progress">In-Progress</option>
                        <option value="Resolved">Resolved</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label>Damage Type:</label>
                    <select asp-for="DamageType" class="form-control" required>
                        <option value="">Select a reason...</option>
                        <option value="Physical Damage">Physical Damage</option>
                        <option value="Normal Wear and Tear">Normal Wear and Tear</option>
                        <option value="Software Malfunction">Software Malfunction</option>
                        <option value="Hardware Failure">Hardware Failure</option>
                        <option value="Electrical Fault">Electrical Fault</option>
                        <option value="Water Damage">Water Damage</option>
                        <option value="Display Issue">Display Issue</option>
                        <option value="Input Issue">Keyboard or Input Issue</option>
                        <option value="System Failure">System Failure</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

      
            </div>

            <div class="form-group">
                <label>Description of Damage:</label>
                <textarea asp-for="DamageDescription" rows="5" class="form-control" placeholder="Describe the damage..."></textarea>
            </div>

            <div class="form-group">
                <label>Additional Notes:</label>
                <textarea asp-for="Notes" rows="5" class="form-control" placeholder="Add any additional notes here..."></textarea>
            </div>

            <div class="button-group">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                <button type="button" class="btn btn-danger" onclick="openDeleteModal(@Model.AssetDamageID)">
                    Delete Damage
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Delete Damage Modal -->
<div id="deleteDamageModal" class="modal">
    <div class="modal-content">
        <h5>Confirm Delete Damage</h5>
        <p>Are you sure you want to delete this damage report?</p>
        <input type="checkbox" id="confirmDeleteDamageCheckbox" onclick="toggleDeleteDamageButton()">
        <label for="confirmDeleteDamageCheckbox">I understand the consequences of deleting this damage report.</label>
        <div class="mt-3">
            <button id="confirmDeleteDamageButton" class="btn btn-danger" disabled onclick="executeDeleteDamage(@Model.AssetDamageID)">
                Confirm
            </button>
            <button type="button" onclick="closeDeleteModal()" class="btn btn-secondary">Cancel</button>
        </div>
    </div>
</div>


<style>
    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;
    }

    .form-container {
        width: 1600px;
        padding: 50px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    h2.text-center {
        margin-bottom: 30px;
    }

    .section-title {
        border-bottom: 2px solid #ccc;
        margin-top: 30px;
        margin-bottom: 20px;
        padding-bottom: 10px;
    }

    label {
        font-weight: bold;
        color: #333;
    }

    .equipment-details-box {
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .form-control-plaintext {
        background-color: #e9ecef; 
        border: 1px solid #ccc;
        padding: 15px;
        border-radius: 4px;
    }

    .form-control {
        background-color: #fff; 
        border-radius: 4px;
        padding: 12px;
        border: 1px solid #ccc;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

        .btn-primary:hover, .btn-secondary:hover {
            opacity: 0.9;
        }


    .modal {
        display: none; /* Ensure it's hidden by default */
        position: fixed;
        z-index: 1000;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        align-items: center; /* Only applies when displayed */
        justify-content: center; /* Only applies when displayed */
    }

    .modal-content {
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
        width: 500px;
    }

        .modal-content h5 {
            margin-bottom: 15px;
        }

        .modal-content label {
            display: block;
            margin-top: 10px;
        }

        .modal-content .mt-3 {
            margin-top: 15px;
        }

        .modal-content .btn {
            padding: 10px 20px;
            border-radius: 4px;
            font-size: 14px;
        }

        .modal-content .btn-danger {
            background-color: #dc3545;
            border: none;
            color: #fff;
        }

            .modal-content .btn-danger:hover {
                background-color: #c82333;
            }

        .modal-content .btn-secondary {
            background-color: #6c757d;
            border: none;
            color: #fff;
        }

            .modal-content .btn-secondary:hover {
                background-color: #5a6268;
            }

</style>



<script>
    function openDeleteModal(damageID) {
        // Assign the delete ID to the button's action
        document.getElementById("confirmDeleteDamageButton").setAttribute("onclick", `executeDeleteDamage(${damageID})`);
        // Display the modal
        document.getElementById("deleteDamageModal").style.display = "flex";
    }

    function closeDeleteModal() {
        // Hide the modal
        document.getElementById("deleteDamageModal").style.display = "none";
    }

    function toggleDeleteDamageButton() {
        // Enable or disable the confirm button based on the checkbox
        const checkbox = document.getElementById("confirmDeleteDamageCheckbox");
        const deleteButton = document.getElementById("confirmDeleteDamageButton");
        deleteButton.disabled = !checkbox.checked;
    }

    function executeDeleteDamage(damageID) {
        fetch(`/Damages/DeleteDamage/${damageID}`, {
            method: "POST"
        })
            .then(response => {
                if (response.ok) {
                   
                    window.location.href = '/Damages'; // Redirect to damages list
                } else {
                    alert("Failed to delete damage report.");
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
    }

    
</script>


