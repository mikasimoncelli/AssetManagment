@model IEnumerable<AssetManager.Models.AssetDamage>
@{
    ViewData["Title"] = "All Damages";
}
<div class="container-wrapper">
    <div class="form-container">
        <div class="logo-top-right">
            <img src="~/images/Favicon.jpg" alt="Company Logo" class="img-fluid">
        </div>
        <h3 class="text-center mt-4 mb-4 pb-3">All Damaged Assets</h3>
        <p class="text-muted mt-2 text-center" style="font-size: 0.875rem;">View all reported damages below. Click on a row to view and make changes to the damage report.</p>


        <!-- Filter and search inputs -->
        <div class="row justify-content-center mb-3">
            <div class="col-md-10">
                <h6 class="form-label">Filter by Asset Type:</h6>
                <select id="assetTypeDropdown" class="form-control mb-3" onchange="filterAssetType()">
                    <option value="">All Asset Types</option>
                    @foreach (var type in Model.Select(m => m.Asset.EquipmentType).Distinct())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
                <div class="input-group mb-3">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search damaged assets..." onkeyup="applyGlobalSearch()" style="margin-right: 20px;" />
                    <button type="button" class="btn btn-primary" onclick="resetAllFilters()">Reset Search</button>
                </div>
            </div>
        </div>

        <!-- Pending Repairs Table -->
        <div class="row justify-content-center">
            <div class="col-md-10">
                <h5>Pending Repairs</h5>
                <button id="editPendingButton" class="btn btn-primary mb-3" style="display: none;" onclick="openEditModal('pending')">Edit Selected</button>
                <div class="table-responsive">
                    <table class="table table-bordered text-center table-sm asset-table" id="pending-table">
                        <thead>
                            <tr style="background-color: #0b3d91; color: #fff;">
                                <th><input type="checkbox" id="selectAllPending" onclick="toggleSelectAll('pending')" /></th>
                                <th>Damage Type</th>
                                <th>Damage Description</th>
                                <th>Asset Type</th>
                                <th>Manufacturer</th>
                                <th>Asset Number</th>
                                <th>Serial Number</th>
                                <th>Date Reported</th>
                                <th>Repair Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assetDamage in Model.Where(ad => ad.RepairStatus == "Pending"))
                            {
<tr onclick="window.location.href='@Url.Action("EditAssetDamage", "Damages", new { id = assetDamage.AssetDamageID })'" style="cursor: pointer;">
                                    <td><input type="checkbox" class="select-row-pending" data-id="@assetDamage.AssetDamageID" onchange="toggleEditButton('pending')" onclick="stopPropagation(event)" /></td>
                                    <td>@assetDamage.DamageType</td>
                                    <td>@assetDamage.DamageDescription</td>
                                    <td>@assetDamage.Asset?.EquipmentType</td>
                                    <td>@assetDamage.Asset?.Manufacturer</td>
                                    <td>@assetDamage.Asset?.AssetNumber</td>
                                    <td>@assetDamage.Asset?.SerialNumber</td>
                                    <td>@assetDamage.DateReported.ToString("yyyy-MM-dd")</td>
                                    <td>@assetDamage.RepairDate?.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- In-Progress Repairs Table -->
        <div class="row justify-content-center">
            <div class="col-md-10">
                <h5>In-Progress Repairs</h5>
                <button id="editInprogressButton" class="btn btn-primary mb-3" style="display: none;" onclick="openEditModal('inprogress')">Edit Selected</button>
                <div class="table-responsive">
                    <table class="table table-bordered text-center table-sm asset-table" id="inprogress-table">
                        <thead>
                            <tr style="background-color: #0b3d91; color: #fff;">
                                <th><input type="checkbox" id="selectAllInprogress" onclick="toggleSelectAll('inprogress')" /></th>
                                <th>Damage Type</th>
                                <th>Damage Description</th>
                                <th>Asset Type</th>
                                <th>Manufacturer</th>
                                <th>Asset Number</th>
                                <th>Serial Number</th>
                                <th>Date Reported</th>
                                <th>Repair Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assetDamage in Model.Where(ad => ad.RepairStatus == "In-Progress"))
                            {
                                <tr onclick="window.location.href='@Url.Action("EditAssetDamage", "Damages", new { id = assetDamage.AssetDamageID })'" style="cursor: pointer;">
                                    <td><input type="checkbox" class="select-row-inprogress" data-id="@assetDamage.AssetDamageID" onchange="toggleEditButton('inprogress')" onclick="stopPropagation(event)" /></td>
                                    <td>@assetDamage.DamageType</td>
                                    <td>@assetDamage.DamageDescription</td>
                                    <td>@assetDamage.Asset?.EquipmentType</td>
                                    <td>@assetDamage.Asset?.Manufacturer</td>
                                    <td>@assetDamage.Asset?.AssetNumber</td>
                                    <td>@assetDamage.Asset?.SerialNumber</td>
                                    <td>@assetDamage.DateReported.ToString("yyyy-MM-dd")</td>
                                    <td>@assetDamage.RepairDate?.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>



        <!-- Resolved Repairs Table -->
        <div class="row justify-content-center">
            <div class="col-md-10">
                <h5>Resolved Repairs</h5>
                <button id="editResolvedButton" class="btn btn-primary mb-3" style="display: none;" onclick="openEditModal('resolved')">Edit Selected</button>
                <div class="table-responsive">
                    <table class="table table-bordered text-center table-sm asset-table" id="resolved-table">
                        <thead>
                            <tr style="background-color: #0b3d91; color: #fff;">
                                <th><input type="checkbox" id="selectAllResolved" onclick="toggleSelectAll('resolved')" /></th>
                                <th>Damage Type</th>
                                <th>Damage Description</th>
                                <th>Asset Type</th>
                                <th>Manufacturer</th>
                                <th>Asset Number</th>
                                <th>Serial Number</th>
                                <th>Date Reported</th>
                                <th>Repair Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assetDamage in Model.Where(ad => ad.RepairStatus == "Resolved"))
                            {
                                <tr onclick="window.location.href='@Url.Action("EditAssetDamage", "Damages", new { id = assetDamage.AssetDamageID })'" style="cursor: pointer;">
                                    <td><input type="checkbox" class="select-row-resolved" data-id="@assetDamage.AssetDamageID" onchange="toggleEditButton('resolved')" onclick="stopPropagation(event)" onclick="stopPropagation(event)" /></td>
                                    <td>@assetDamage.DamageType</td>
                                    <td>@assetDamage.DamageDescription</td>
                                    <td>@assetDamage.Asset?.EquipmentType</td>
                                    <td>@assetDamage.Asset?.Manufacturer</td>
                                    <td>@assetDamage.Asset?.AssetNumber</td>
                                    <td>@assetDamage.Asset?.SerialNumber</td>
                                    <td>@assetDamage.DateReported.ToString("yyyy-MM-dd")</td>
                                    <td>@assetDamage.RepairDate?.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Edit Modal -->
        <div id="editModal" class="modal">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Selected Damages</h5>

                    </div>
                    <div class="modal-body">
                        <form id="editForm">
                            <div class="form-group">
                                <label for="newStatus">Status:</label>
                                <select id="newStatus" class="form-control">
                                    <option value="">Select Status</option>
                                    <option value="Pending">Pending</option>
                                    <option value="In-Progress">In-Progress</option>
                                    <option value="Resolved">Resolved</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="newDateRepaired">Date Repaired:</label>
                                <input type="date" id="newDateRepaired" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label for="newNotes">Notes:</label>
                                <textarea id="newNotes" class="form-control" placeholder="Add notes..."></textarea>
                            </div>
                        </form>
                    </div>
                    <div class="button-group">
                        <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>

                        <button type="button" id="saveButton" class="btn btn-primary" onclick="submitEditForm()" disabled>Save changes</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    function closeModal() {
        // Hide the modal using Bootstrap's modal method
        $('#editModal').modal('hide');

        // Reset modal dataset status
        document.getElementById('editModal').dataset.status = '';

        // Uncheck all individual checkboxes
        ['pending', 'inprogress', 'resolved'].forEach(status => {
            document.querySelectorAll(`.select-row-${status}`).forEach(checkbox => checkbox.checked = false);
            const selectAllCheckbox = document.getElementById(`selectAll${capitalizeFirstLetter(status)}`);
            if (selectAllCheckbox) {
                selectAllCheckbox.checked = false;
            }
        });

        // Hide all Edit Selected buttons
        ['editPendingButton', 'editInprogressButton', 'editResolvedButton'].forEach(buttonId => {
            document.getElementById(buttonId).style.display = 'none';
        });

        // Reset modal fields to their defaults
        const statusField = document.getElementById('newStatus');
        const dateField = document.getElementById('newDateRepaired');
        const notesField = document.getElementById('newNotes');

        statusField.value = ''; // Reset dropdown to default
        dateField.value = '';   // Clear the date input
        notesField.value = '';  // Clear the textarea input

        // Disable the Save button again
        const saveButton = document.getElementById('saveButton');
        saveButton.disabled = true;
    }



    function filterAssetType() {
        const selectedType = document.getElementById("assetTypeDropdown").value.toLowerCase();
        ['pending-table', 'in-progress-table', 'resolved-table'].forEach(tableId => {
            document.querySelectorAll(`#${tableId} tbody tr`).forEach(row => {
                const assetType = row.cells[2].textContent.toLowerCase();
                row.style.display = selectedType && assetType !== selectedType ? "none" : "";
            });
        });
    }

    function applyGlobalSearch() {
        const searchValue = document.getElementById('searchInput').value.toLowerCase();
        ['pending-table', 'in-progress-table', 'resolved-table'].forEach(tableId => {
            document.querySelectorAll(`#${tableId} tbody tr`).forEach(row => {
                const rowText = Array.from(row.cells).map(cell => cell.textContent.toLowerCase()).join(" ");
                row.style.display = rowText.includes(searchValue) ? "" : "none";
            });
        });
    }

    function resetAllFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('assetTypeDropdown').value = '';
        ['pending-table', 'in-progress-table', 'resolved-table'].forEach(tableId => {
            document.querySelectorAll(`#${tableId} tbody tr`).forEach(row => row.style.display = "");
        });
    }





    function toggleSelectAll(status) {
        const isChecked = document.getElementById(`selectAll${capitalizeFirstLetter(status)}`).checked;
        document.querySelectorAll(`.select-row-${status}`).forEach(checkbox => {
            checkbox.checked = isChecked;
        });
        toggleEditButton(status);
    }

    function toggleEditButton(status) {
        const selectedRows = document.querySelectorAll(`.select-row-${status}:checked`);
        document.getElementById(`edit${capitalizeFirstLetter(status)}Button`).style.display = selectedRows.length > 0 ? 'inline-block' : 'none';
    }

    function openEditModal(status) {
        document.getElementById('editModal').dataset.status = status; // Save status to modal for later reference
        $('#editModal').modal('show');
    }


function submitEditForm() {
    const status = document.getElementById('editModal').dataset.status;
    const selectedClass = `.select-row-${status}`;
    const selectedIds = Array.from(document.querySelectorAll(`${selectedClass}:checked`)).map(cb => cb.getAttribute('data-id'));
    const newStatus = document.getElementById('newStatus').value;
    const newDateRepaired = document.getElementById('newDateRepaired').value;
    const newNotes = document.getElementById('newNotes').value;

    const requestData = {
        ids: selectedIds,
        status: newStatus || undefined,  // Only send if newStatus is provided
        dateRepaired: newDateRepaired ? new Date(newDateRepaired) : undefined, // Only send if newDateRepaired is valid
        notes: newNotes || undefined  // Only send if newNotes is provided
    };

    // Remove any keys with undefined values from the requestData object
    Object.keys(requestData).forEach(key => requestData[key] === undefined && delete requestData[key]);

    fetch('/Damages/BulkUpdate', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(requestData)
    }).then(response => {
        if (response.ok) {
            location.reload(); // Reload the page to reflect changes
        } else {
            alert("Failed to update damages.");
            console.error("Server response:", response);
        }
    }).catch(error => {
        alert("Failed to update damages.");
        console.error("Fetch error:", error);
    });

    $('#editModal').modal('hide');
}



    function capitalizeFirstLetter(string) {
        return string.charAt(0).toUpperCase() + string.slice(1);
    }

    function stopPropagation(event) {
        event.stopPropagation();
    }

    document.addEventListener("DOMContentLoaded", function () {
        const saveButton = document.getElementById("saveButton");
        const statusField = document.getElementById("newStatus");
        const dateField = document.getElementById("newDateRepaired");
        const notesField = document.getElementById("newNotes");

        function validateFields() {
            const isStatusSelected = statusField.value !== ""; // Check if a status is selected
            const isDateFilled = dateField.value.trim() !== ""; // Check if a date is entered
            const isNotesFilled = notesField.value.trim() !== ""; // Check if notes are entered

            // Enable the Save button if any field is filled
            saveButton.disabled = !(isStatusSelected || isDateFilled || isNotesFilled);
        }

        // Attach event listeners to fields
        statusField.addEventListener("change", validateFields);
        dateField.addEventListener("input", validateFields);
        notesField.addEventListener("input", validateFields);
    });


</script>

<style>

    .button-group {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;
        min-height: 100vh;
    }

    .form-container {
        width: 2100px;
        padding: 20px;
        border: 2px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    .container-fluid {
        background-color: #f8f9fa;
    }

    .asset-table {
        width: 100%;
        border: solid 1px #ddd;
    }

    th, td {
        padding: 8px;
        cursor: pointer;
    }

    th:hover, tr:hover {
        background-color: #dcdcdc;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }

    .equipment-type-section {
        margin-bottom: 30px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    .logo-top-right {
        position: absolute;
        top: 40px; /* Adjust as needed */
        right: 90px; /* Adjust as needed */
    }

    .logo-top-right img {
        max-width: 100px; /* Adjust the size as needed */
        height: auto;
    }

    .modal {
        position: absolute; 
        top: 50%; 
        left: 50%; 
        transform: translate(-50%, -50%); 
        top: calc(50% + 200px); 
        left: calc(50% + 50px);
    }


    .modal-content {
        padding: 20px;
    }
</style>
