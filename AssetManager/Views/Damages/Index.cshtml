@model IEnumerable<AssetManager.Models.AssetDamage>

<div class="container-wrapper">
    <div class="form-container">
        <h3 class="text-center mt-4 mb-4 display-4 pb-3">All Damaged Assets</h3>

    <div class="row justify-content-center mb-3">
        <div class="col-md-10">
            <h6 class="form-label">Filter by Asset Type:</h6>
            <select id="assetTypeDropdown" class="form-control mb-3" onchange="filterAssetType()">
                <option value="">All Asset Types</option>
                @foreach (var type in Model.Select(m => m.Asset.EquipmentType).Distinct())
                {
                    <option value="@type">@type</option>
                }
            </select>

            <div class="input-group mb-3">
                <input type="text" id="searchInput" class="form-control" placeholder="Search damaged assets..." onkeyup="applyGlobalSearch()" style="margin-right: 20px;" />
                <button type="button" class="btn btn-primary" onclick="resetAllFilters()">Reset Search</button>
            </div>
        </div>
    </div>


    <div class="row justify-content-center">

        <div class="col-md-10">
                <h6>
                    View all reported damaged assets below. Click an asset to open and edit the damage report:
                </h6>
            <div class="table-responsive">
                <div class="equipment-type-section">
                    <table class="table table-bordered text-center table-sm asset-table">
                        <thead>
                            <tr style="background-color: #0d6efd; color: #fff;">
                                <th>Repair Status</th>

                                <th>Damage Description</th>

                                <th>Asset Type</th>
                                <th>Manufacturer</th>
                                <th>Asset Number</th>
                                <th>Serial Number</th>
                                <th>Date Reported</th>
                                <th>Repair Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assetDamage in Model)
                            {
                                <tr onclick="window.location.href='@Url.Action("EditAssetDamage", "Damages", new { id = assetDamage.AssetDamageID })'" style="cursor: pointer;">
                                    <td>@assetDamage.RepairStatus</td>

                                    <td>@assetDamage.DamageDescription</td>

                                    <td>@assetDamage.Asset?.EquipmentType</td>
                                    <td>@assetDamage.Asset?.Manufacturer</td>
                                    <td>@assetDamage.Asset?.AssetNumber</td>
                                    <td>@assetDamage.Asset?.SerialNumber</td>
                                    <td>@assetDamage.DateReported.ToString("yyyy-MM-dd")</td>
                                    <td>@assetDamage.RepairDate?.ToString("yyyy-MM-dd")</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div></div>

<script>
    // Filter by asset type
    function filterAssetType() {
        const selectedType = document.getElementById("assetTypeDropdown").value.toLowerCase();
        document.querySelectorAll(".asset-table tbody tr").forEach(row => {
            const assetType = row.cells[0].textContent.toLowerCase();
            row.style.display = selectedType && assetType !== selectedType ? "none" : "";
        });
    }

    // Global search function
    function applyGlobalSearch() {
        const searchValue = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll(".asset-table tbody tr").forEach(row => {
            const rowText = Array.from(row.cells).map(cell => cell.textContent.toLowerCase()).join(" ");
            row.style.display = rowText.includes(searchValue) ? "" : "none";
        });
    }

    // Reset all filters
    function resetAllFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('assetTypeDropdown').value = '';
        document.querySelectorAll(".asset-table tbody tr").forEach(row => row.style.display = "");
    }
</script>

<style>

            .container-wrapper {
                display: flex;
                justify-content: center;
                width: 100%;
                padding: 20px;
                min-height: 100vh;
            }

            .form-container {
                width: 2100px;
                padding: 20px;
                border: 2px solid #ddd;
                border-radius: 8px;
                background-color: #fdfdfd;
                box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
            }

            .container-fluid {
                background-color: #f8f9fa;
            }

    .asset-table {
        width: 100%;
        border: solid 1px #ddd;
    }

    th, td {
        padding: 8px;
        cursor: pointer;
    }

    th:hover, tr:hover {
        background-color: #dcdcdc;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }

    .equipment-type-section {
        margin-bottom: 30px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }
</style>
