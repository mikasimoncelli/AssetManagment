@model IEnumerable<AssetManager.Models.Office>
        @{
            var offices = ViewBag.Offices;
        }
@{
    ViewData["Title"] = "All Offices";
}
        <div class="container-wrapper">
            <div class="form-container">

        <div class="row mb-4 align-items-center">
            <div class="col-sm">
                <!-- Small black label -->
                <p class="mb-0 ms-5" style="font-size: 1rem; color: black;">Total Offices:</p>
                <!-- Large blue number below the label -->
                <h2 class="mb-0 ms-5" style="font-size: 5rem; color: #0b3d91;">@ViewBag.TotalOffices</h2>

            </div>
            <div class="col-md-auto text-center">
                
                <h3 class="mx-auto" style="width: fit-content;">View All Offices</h3>
                <p class="text-muted mt-2 text-center pb-3" style="font-size: 0.875rem;">View all offices below. Select one to view more information on the assets for that office.</p>

            </div>

            <div class="col"></div>

        </div>




                <!-- Offices Table Section -->
                <div class="table-responsive centered-table">
                    <table class="table text-center table-sm office-table table-bordered bg-white">
                        <thead class="thead-dark">
                    <tr style="background-color: #0b3d91; color: #fff;">
                                <th>Office Name</th>
                                <th>Location</th>
                                <th>Number of Assets</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var office in offices)
                            {
                                <tr onclick="window.location.href='@Url.Action("ViewOfficeAssets", "Offices", new { officeID = office.OfficeID })'">
                                    <td>@office.OfficeName</td>
                                    <td>@office.Location</td>
                                    <td>@office.AssetCount</td> <!-- Display asset count from anonymous object -->
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


<!-- JavaScript for filtering and searching -->
<script>
    function filterLocation() {
        const selectedLocation = document.getElementById("officeLocationDropdown").value.toLowerCase();
        document.querySelectorAll(".office-table tbody tr").forEach(row => {
            const location = row.cells[1].textContent.toLowerCase();
            row.style.display = selectedLocation && location !== selectedLocation ? "none" : "";
        });
    }

    function applyGlobalSearch() {
        const searchValue = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll(".office-table tbody tr").forEach(row => {
            const rowText = Array.from(row.cells).map(cell => cell.textContent.toLowerCase()).join(" ");
            row.style.display = rowText.includes(searchValue) ? "" : "none";
        });
    }

    function resetAllFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('officeLocationDropdown').value = '';
        document.querySelectorAll(".office-table tbody tr").forEach(row => row.style.display = "");
    }
</script>

<!-- CSS styling to match asset table styling -->
<style>
    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        height: 600px;
        padding: 20px;
    }

    .form-container {
        width: 2100px;
        padding: 20px;
        border: 2px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    .office-table {
        width: 80%;
justify-content: center;        
border: solid 1px #ddd;
        margin: 0 auto; /* Centers the table */
    }

    th, td {
        cursor: pointer;
        padding: 12px;
    }

    th:hover, tr:hover {
        background-color: #dcdcdc;
    }

    h3 {
        font-weight: 400; /* Makes the font very thin */
    }
</style>
