
@model List<AssetManager.Models.Asset>
<div class="container-wrapper">
    <div class="form-container">
        <div class="row mb-4 align-items-center">
            <!-- Empty Column -->
            <div class="col"></div>

            <!-- Centered Title Column -->
            <div class="col-md-auto text-center">
                <h2 class="display-4 mx-auto" style="width: fit-content;">View All Assets</h2>
            </div>

            <!-- Right-Aligned Total Count Column -->
            <div class="col-sm text-end me-3">
                <!-- Small black label -->
                <p class="mb-0" style="font-size: 1rem; color: black;">Total Assets:</p>
                <!-- Large blue number below the label -->
                <h2 class="mb-0" style="font-size: 5rem; color: #0b3d91;">@ViewBag.TotalAssets</h2>
            </div>
        </div>
        <p class="text-center pb-3">View all assets in inventory below. Use filter and search to refine your results.</p>

        <div class="row justify-content-center mb-3">
            <div class="col-md-4">
                <h6 for="equipmentTypeDropdown" class="form-label" style="font-size: 1.1rem;">
                    Filter by Equipment Type:
                </h6>
                <select id="equipmentTypeDropdown" class="form-control mb-3" onchange="showSelectedType()">
                    <option value="">Select Equipment Type</option>
                    @foreach (var type in Model.Select(a => a.EquipmentType).Distinct())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <h6 for="searchInput" class="form-label" style="font-size: 1.1rem;">Search for Asset:</h6>
                <div class="input-group mb-3">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search assets..." onkeyup="applyGlobalSearch()" />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-primary ms-2" onclick="resetAllFilters()">
                            Reset Search
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assets Table Section -->
        <div class="row justify-content-center">
            <div class="col-md-12">
                @foreach (var group in Model.GroupBy(a => a.EquipmentType))
                {
                    <div class="equipment-type-section" data-type="@group.Key">
                        <h4 class="text-center mt-4 mb-3 display-6">@($"{group.Key}s")</h4>
                        <div class="table-responsive">
                            <table class="table text-center table-sm assetTable table-bordered bg-white">
                                <thead class="thead-dark" style="padding: 42px">
                                    <tr style="background-color: #0d6efd; color: #fff; padding: 32px">
                                        <th>AssetID</th>
                                        <th onclick="applySort(this, 1)">Description</th>
                                        <th onclick="applySort(this, 2)">Manufacturer</th>
                                        <th onclick="applySort(this, 3)">Asset Number</th>
                                        <th onclick="applySort(this, 4)">Serial Number</th>
                                        <th onclick="applySort(this, 5)">Office Name</th>
                                        <th onclick="applySort(this, 6)">Office Location</th>
                                    </tr>
                                    <tr>
                                        <th></th>
                                        <th>
                                            <select onchange="applyColumnFilter(this, 1)">
                                                <option value="">All</option>
                                                @foreach (var description in group.Select(a => a.Description).Distinct())
                                                {
                                                    <option value="@description">@description</option>
                                                }
                                            </select>
                                        </th>
                                        <th>
                                            <select onchange="applyColumnFilter(this, 2)">
                                                <option value="">All</option>
                                                @foreach (var manufacturer in group.Select(a => a.Manufacturer).Distinct())
                                                {
                                                    <option value="@manufacturer">@manufacturer</option>
                                                }
                                            </select>
                                        </th>
                                        <th>
                                            <select onchange="applyColumnFilter(this, 3)">
                                                <option value="">All</option>
                                                @foreach (var assetNumber in group.Select(a => a.AssetNumber).Distinct())
                                                {
                                                    <option value="@assetNumber">@assetNumber</option>
                                                }
                                            </select>
                                        </th>
                                        <th>
                                            <select onchange="applyColumnFilter(this, 4)">
                                                <option value="">All</option>
                                                @foreach (var serialNumber in group.Select(a => a.SerialNumber).Distinct())
                                                {
                                                    <option value="@serialNumber">@serialNumber</option>
                                                }
                                            </select>
                                        </th>
                                        <th>
                                            <select onchange="applyColumnFilter(this, 5)">
                                                <option value="">All</option>
                                                @foreach (var officeName in group.Select(a => a.Office.OfficeName).Distinct())
                                                {
                                                    <option value="@officeName">@officeName</option>
                                                }
                                            </select>
                                        </th>
                                        <th>
                                            <select onchange="applyColumnFilter(this, 6)">
                                                <option value="">All</option>
                                                @foreach (var location in group.Select(a => a.Office.Location).Distinct())
                                                {
                                                    <option value="@location">@location</option>
                                                }
                                            </select>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var asset in group)
                                    {
                                        <tr onclick="window.location.href='@Url.Action("EditAsset", "Assets", new { id = asset.AssetID })'">
                                            <td>@asset.AssetID</td>
                                            <td>@asset.Description</td>
                                            <td>@asset.Manufacturer</td>
                                            <td>@asset.AssetNumber</td>
                                            <td>@asset.SerialNumber</td>
                                            <td>@asset.Office.OfficeName</td>
                                            <td>@asset.Office.Location</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

    <script>
        const filterValues = {};

        function showSelectedType() {
            const selectedType = document.getElementById("equipmentTypeDropdown").value;

            document.querySelectorAll(".equipment-type-section").forEach(section => {
                section.style.display = selectedType && section.getAttribute("data-type") !== selectedType ? "none" : "block";
            });
        }

        function applyGlobalSearch() {
            const searchValue = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll(".assetTable tbody tr").forEach(row => {
                const rowText = Array.from(row.cells).map(cell => cell.textContent.toLowerCase()).join(" ");
                row.style.display = rowText.includes(searchValue) ? "" : "none";
            });

            document.querySelectorAll(".equipment-type-section").forEach(section => {
                const visibleRows = section.querySelector("tbody tr:not([style*='display: none'])");
                section.style.display = visibleRows ? "block" : "none";
            });

            document.querySelectorAll(".assetTable").forEach(table => updateFilterOptions(table));
        }

        function applyColumnFilter(select, columnIndex) {
            const table = select.closest("table");
            const filterValue = select.value.toLowerCase();

            if (filterValue === "") {
                delete filterValues[columnIndex];
            } else {
                filterValues[columnIndex] = filterValue;
            }

            applyAllFilters(table);
        }

        function applyAllFilters(table) {
            const tableBody = table.querySelector("tbody");

            Array.from(tableBody.getElementsByTagName("tr")).forEach(row => {
                let isVisible = true;

                for (const [columnIndex, value] of Object.entries(filterValues)) {
                    const cellText = row.cells[columnIndex].textContent.toLowerCase();
                    if (value && !cellText.includes(value)) {
                        isVisible = false;
                        break;
                    }
                }

                row.style.display = isVisible ? "" : "none";
            });

            const section = table.closest(".equipment-type-section");
            const visibleRows = tableBody.querySelector("tr:not([style*='display: none'])");
            section.style.display = visibleRows ? "block" : "none";

            updateFilterOptions(table);
        }

        function updateFilterOptions(table) {
            const tableBody = table.querySelector("tbody");
            const visibleRows = Array.from(tableBody.getElementsByTagName("tr")).filter(row => row.style.display !== "none");

            Array.from(table.querySelectorAll("thead select")).forEach((select, index) => {
                const columnIndex = index + 1;
                const uniqueValues = new Set(visibleRows.map(row => row.cells[columnIndex].textContent.trim()));
                const currentSelection = select.value;

                select.innerHTML = '<option value="">All</option>';

                uniqueValues.forEach(value => {
                    const option = document.createElement("option");
                    option.value = value;
                    option.textContent = value;
                    select.appendChild(option);
                });

                if (uniqueValues.has(currentSelection)) {
                    select.value = currentSelection;
                } else {
                    select.value = "";
                }
            });
        }

        function applySort(header, columnIndex) {
            const tableBody = header.closest("table").querySelector("tbody");
            let rows = Array.from(tableBody.getElementsByTagName("tr"));
            const direction = header.getAttribute("data-sort") === "asc" ? "desc" : "asc";

            header.setAttribute("data-sort", direction);

            rows.sort((a, b) => {
                const cellA = a.cells[columnIndex].textContent.trim().toLowerCase();
                const cellB = b.cells[columnIndex].textContent.trim().toLowerCase();

                return direction === "asc" ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
            });

            rows.forEach(row => tableBody.appendChild(row));
            updateFilterOptions(header.closest("table"));
        }

        function resetAllFilters() {
            document.getElementById('searchInput').value = '';
            document.querySelectorAll(".assetTable tbody tr").forEach(row => row.style.display = "");
            document.querySelectorAll(".equipment-type-section").forEach(section => section.style.display = "block");
            document.querySelectorAll(".assetTable select").forEach(select => select.value = "");

            Object.keys(filterValues).forEach(key => delete filterValues[key]);
            document.querySelectorAll(".assetTable").forEach(table => updateFilterOptions(table));
        }
    </script>

<style>
    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;
    }

    .form-container {
        width: 2100px;
        padding: 20px;
        border: 2px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    .asset-table {
        width: 100%;
        border: solid 1px #ddd;
        margin: 0 auto;
    }

    th, td {
        cursor: pointer;
        padding: 8px;
    }

        th:hover, tr:hover {
            background-color: #dcdcdc;
        }

    .equipment-type-section {
        margin-bottom: 30px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
        background-color: #fff;
        text-align: center;
    }

    h4 {
        color: #333;
        font-weight: bold;
        margin-bottom: 20px;
    }
</style>