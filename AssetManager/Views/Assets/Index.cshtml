@model List<AssetManager.Models.Asset>

<div class="container-fluid" style="min-height: 100vh; padding: 0 20px;">
    <h3 class="text-center mt-4 mb-4">View All Assets</h3>

    <div class="row justify-content-center mb-3">
        <div class="col-md-10">
            <div class="input-group">
                <input type="text" id="searchInput" class="form-control" placeholder="Search assets..." onkeyup="applyFilterAndSort()" style="margin-right: 20px;" />
                <div class="input-group-append">
                    <button type="button" class="btn btn-warning" onclick="resetFilters()">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="table-responsive">
                <table id="assetsTable" class="table table-bordered text-center table-sm">
                    <thead class="thead-dark">
                        <tr>
                            <th><span>AssetID</span></th>
                            <th><span onclick="applySort(1)">Description</span>
                                <select id="descriptionFilter" class="form-control form-control-sm" onchange="applyFilterAndSort()">
                                    <option value="">Filter</option>
                                    @foreach (var description in Model.Select(a => a.Description).Distinct())
                                    {
                                        <option value="@description">@description</option>
                                    }
                                </select>
                            </th>
                            <th><span onclick="applySort(2)">Manufacturer</span>
                                <select id="manufacturerFilter" class="form-control form-control-sm" onchange="applyFilterAndSort()">
                                    <option value="">All</option>
                                    @foreach (var manufacturer in Model.Select(a => a.Manufacturer).Distinct())
                                    {
                                        <option value="@manufacturer">@manufacturer</option>
                                    }
                                </select>
                            </th>
                            <th><span onclick="applySort(3)">Type</span>
                                <select id="typeFilter" class="form-control form-control-sm" onchange="applyFilterAndSort()">
                                    <option value="">All</option>
                                    @foreach (var type in Model.Select(a => a.EquipmentType).Distinct())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </th>
                            <th><span onclick="applySort(4)">Asset Number</span>
                                <select id="assetNumberFilter" class="form-control form-control-sm" onchange="applyFilterAndSort()">
                                    <option value="">All</option>
                                    @foreach (var assetNumber in Model.Select(a => a.AssetNumber).Distinct())
                                    {
                                        <option value="@assetNumber">@assetNumber</option>
                                    }
                                </select>
                            </th>
                            <th><span onclick="applySort(5)">Serial Number</span>
                                <select id="serialNumberFilter" class="form-control form-control-sm" onchange="applyFilterAndSort()">
                                    <option value="">All</option>
                                    @foreach (var serialNumber in Model.Select(a => a.SerialNumber).Distinct())
                                    {
                                        <option value="@serialNumber">@serialNumber</option>
                                    }
                                </select>
                            </th>
                            <th><span onclick="applySort(6)">Office Name</span>
                                <select id="officeNameFilter" class="form-control form-control-sm" onchange="applyFilterAndSort()">
                                    <option value="">All</option>
                                    @foreach (var officeName in Model.Select(a => a.Office.OfficeName).Distinct())
                                    {
                                        <option value="@officeName">@officeName</option>
                                    }
                                </select>
                            </th>
                            <th><span onclick="applySort(7)">Office Location</span>
                                <select id="officeLocationFilter" class="form-control form-control-sm" onchange="applyFilterAndSort()">
                                    <option value="">All</option>
                                    @foreach (var location in Model.Select(a => a.Office.Location).Distinct())
                                    {
                                        <option value="@location">@location</option>
                                    }
                                </select>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="assetTableBody">
                        @foreach (var asset in Model)
                        {
                            <tr onclick="window.location.href='@Url.Action("EditAsset", "Assets", new { id = asset.AssetID })'">
                                <td>@asset.AssetID</td>
                                <td>@asset.Description</td>
                                <td>@asset.Manufacturer</td>
                                <td>@asset.EquipmentType</td>
                                <td>@asset.AssetNumber</td>
                                <td>@asset.SerialNumber</td>
                                <td>@asset.Office.OfficeName</td>
                                <td>@asset.Office.Location</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    let currentSortColumn = -1;
    let currentSortDirection = "asc";

    function applyFilterAndSort() {
        filterTable();
        sortTable(currentSortColumn);
    }

    function filterTable() {
        const searchInput = document.getElementById('searchInput').value.toLowerCase();
        const descriptionFilter = document.getElementById('descriptionFilter').value.toLowerCase();
        const manufacturerFilter = document.getElementById('manufacturerFilter').value.toLowerCase();
        const typeFilter = document.getElementById('typeFilter').value.toLowerCase();
        const assetNumberFilter = document.getElementById('assetNumberFilter').value.toLowerCase();
        const serialNumberFilter = document.getElementById('serialNumberFilter').value.toLowerCase();
        const officeNameFilter = document.getElementById('officeNameFilter').value.toLowerCase();
        const officeLocationFilter = document.getElementById('officeLocationFilter').value.toLowerCase();

        const rows = Array.from(document.getElementById('assetTableBody').getElementsByTagName('tr'));

        rows.forEach(row => {
            const cells = row.getElementsByTagName('td');
            const matchesSearch = Array.from(cells).some(cell => cell.textContent.toLowerCase().includes(searchInput));
            const matchesFilters =
                (!descriptionFilter || cells[1].textContent.toLowerCase().includes(descriptionFilter)) &&
                (!manufacturerFilter || cells[2].textContent.toLowerCase().includes(manufacturerFilter)) &&
                (!typeFilter || cells[3].textContent.toLowerCase().includes(typeFilter)) &&
                (!assetNumberFilter || cells[4].textContent.toLowerCase().includes(assetNumberFilter)) &&
                (!serialNumberFilter || cells[5].textContent.toLowerCase().includes(serialNumberFilter)) &&
                (!officeNameFilter || cells[6].textContent.toLowerCase().includes(officeNameFilter)) &&
                (!officeLocationFilter || cells[7].textContent.toLowerCase().includes(officeLocationFilter));

            row.style.display = matchesSearch && matchesFilters ? '' : 'none';
        });
    }

    function applySort(columnIndex) {
        currentSortColumn = columnIndex;
        currentSortDirection = currentSortDirection === "asc" ? "desc" : "asc";
        sortTable(columnIndex);
        filterTable();
    }

    function sortTable(columnIndex) {
        if (columnIndex === -1) return;

        const rows = Array.from(document.getElementById('assetTableBody').getElementsByTagName('tr'));

        rows.sort((a, b) => {
            const cellA = a.cells[columnIndex].textContent.trim().toLowerCase();
            const cellB = b.cells[columnIndex].textContent.trim().toLowerCase();

            if (currentSortDirection === "asc") {
                return cellA > cellB ? 1 : cellA < cellB ? -1 : 0;
            } else {
                return cellA < cellB ? 1 : cellA > cellB ? -1 : 0;
            }
        });

        const tableBody = document.getElementById("assetTableBody");
        tableBody.innerHTML = "";
        rows.forEach(row => tableBody.appendChild(row));
    }

    function resetFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('descriptionFilter').value = '';
        document.getElementById('manufacturerFilter').value = '';
        document.getElementById('typeFilter').value = '';
        document.getElementById('assetNumberFilter').value = '';
        document.getElementById('serialNumberFilter').value = '';
        document.getElementById('officeNameFilter').value = '';
        document.getElementById('officeLocationFilter').value = '';
        applyFilterAndSort();
    }
</script>

<style>
    tr {
        cursor: pointer;
    }
    tr:hover {
        background-color: #f5f5f5;
    }
    th {
        cursor: pointer;
    }
    th:hover {
        background-color: #dcdcdc;
    }
</style>
