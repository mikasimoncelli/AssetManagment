@model AssetManager.Models.AssetDamage

<div class="container-wrapper">
    <form asp-action="EditAssetDamage" method="post">
        <input type="hidden" asp-for="AssetDamageID" />
        <div class="form-container">
            <h1 class="text-center display-4">Edit Damage Report</h1>

            <h4 class="section-title display-6">Equipment Details</h4>
            <div class="equipment-details-box">
                <div class="form-group row">
                    <div class="col-md-4">
                        <label>Description:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Description</p>
                    </div>
                    <div class="col-md-4">
                        <label>Manufacturer:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Manufacturer</p>
                    </div>
                    <div class="col-md-4">
                        <label>Asset Number:</label>
                        <p class="form-control-plaintext">@Model.Asset?.AssetNumber</p>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-4">
                        <label>Serial Number:</label>
                        <p class="form-control-plaintext">@Model.Asset?.SerialNumber</p>
                    </div>
                    <div class="col-md-4">
                        <label>Office Name:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Office?.OfficeName</p>
                    </div>
                    <div class="col-md-4">
                        <label>Location:</label>
                        <p class="form-control-plaintext">@Model.Asset?.Office?.Location</p>
                    </div>
                </div>
            </div>

            <h4 class="section-title display-6">Damage Report Details</h4>

            <div class="form-group row">
                <div class="col-md-6">
                    <label>Damage Status:</label>
                    <select asp-for="RepairStatus" class="form-control">
                        <option value="Pending">Pending</option>
                        <option value="In-Progress">In-Progress</option>
                        <option value="Resolved">Resolved</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label>Repair Date:</label>
                    <input asp-for="RepairDate" type="date" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label>Description of Damage:</label>
                <textarea asp-for="DamageDescription" rows="5" class="form-control" placeholder="Describe the damage..."></textarea>
            </div>

            <div class="form-group">
                <label>Additional Notes:</label>
                <textarea asp-for="Notes" rows="5" class="form-control" placeholder="Add any additional notes here..."></textarea>
            </div>

            <div class="button-group">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="AllDamagedAssets" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </form>
</div>

<style>
    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;
    }

    .form-container {
        width: 1000px;
        padding: 50px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    h2.text-center {
        margin-bottom: 30px;
    }

    .section-title {
        border-bottom: 2px solid #ccc;
        margin-top: 30px;
        margin-bottom: 20px;
        padding-bottom: 10px;
    }

    label {
        font-weight: bold;
        color: #333;
    }

    .equipment-details-box {
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .form-control-plaintext {
        background-color: #e9ecef; 
        border: 1px solid #ccc;
        padding: 15px;
        border-radius: 4px;
    }

    .form-control {
        background-color: #fff; 
        border-radius: 4px;
        padding: 12px;
        border: 1px solid #ccc;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

        .btn-primary:hover, .btn-secondary:hover {
            opacity: 0.9;
        }
</style>
