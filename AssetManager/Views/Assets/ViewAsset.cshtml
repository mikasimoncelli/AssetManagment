<br />
<br />
@{
    ViewData["Title"] = "View Asset";
}

<div class="container-wrapper">
    <div class="form-container">


        <!-- Asset Update Form -->
            <input type="hidden" name="AssetID" value="@Model.AssetID" />
            <h4 class="text-center">View Asset Details</h4>
            <hr class="section-divider">
            <p></p>

            <!-- Asset Fields -->
            <div class="form-group">
                <label for="Description">Description</label>
                <input type="text" class="form-control" id="Description" name="Description" value="@Model.Description" placeholder="Enter asset description" readonly />
            </div>

            <div class="form-group">
                <label for="Manufacturer">Manufacturer</label>
                <input type="text" class="form-control" id="Manufacturer" name="Manufacturer" value="@Model.Manufacturer" placeholder="Enter manufacturer" readonly />
            </div>
<div class="form-group">
    <label for="EquipmentType">Equipment Type</label>
    <input type="text" class="form-control" id="EquipmentType" name="EquipmentType" value="@Model.EquipmentType" placeholder="Equipment type" readonly />
</div>


        

            <div class="form-row">
                <div class="form-group col-md-6 pr-md-3">
                    <label for="AssetNumber">Asset Number</label>
                    <input type="text" class="form-control" id="AssetNumber" name="AssetNumber" value="@Model.AssetNumber" placeholder="Enter asset number" readonly />
                </div>
                <div class="form-group col-md-6 pl-md-3">
                    <label for="SerialNumber">Serial Number</label>
                    <input type="text" class="form-control" id="SerialNumber" name="SerialNumber" value="@Model.SerialNumber" placeholder="Enter serial number" readonly/>
                </div>
            </div>

            <div class="form-group">
                    <label for="OfficeID">Office</label>

                     <input type="text" class="form-control" id="OfficeID" name="OfficeID" value="@Model.Office.OfficeName" readonly/>
            </div>
                        <div class="form-group">
                    <label for="OfficeID">Location</label>

                     <input type="text" class="form-control" id="OfficeID" name="OfficeID" value="@Model.Office.Location" readonly/>
            </div>

            <div class="form-group">
                <label for="DateAdded">Date Added</label>
                <input type="text" class="form-control" id="DateAdded" name="DateAdded"
                       value="@Model.DateAdded.ToString("dd-MM-yyyy")" placeholder="Enter date added" readonly />
            </div>


</div>
</div>






<!-- Action Buttons Section -->
<div class="form-group d-flex flex-wrap justify-content-center gap-3 mt-4">
    <!-- Back to List Button -->
<!-- Back to List Button -->
    <button type="button" class="btn btn-outline-secondary" style="width: 150px;" onclick="window.location.href='@Context.Request.Query["returnUrl"]'">
    Back to List
</button>

    <!-- Delete Button (Triggers Delete Modal) -->
    <button type="button" class="btn btn-outline-secondary" style="width: 150px;" onclick="window.location.href='@Url.Action("EditAsset", "Assets", new { id = Model.AssetID })'">
        Edit Asset
    </button>

    <!-- Damage Form Button -->
    <button type="button" class="btn btn-outline-secondary" style="width: 150px;" 
            onclick="window.location.href='@Url.Action("AssetDamagesForm", "Damages", new { assetID = Model.AssetID })'">
        Damage Form
    </button>

    <!-- Disposal Form Button -->
    <button type="button" class="btn btn-outline-secondary" style="width: 150px;" 
            onclick="window.location.href='@Url.Action("AssetDisposalsForm", "Disposals", new { assetID = Model.AssetID })'">
        Disposal Form
    </button>

    <!-- Check Out Asset Button -->
    <button type="button" class="btn btn-outline-secondary" style="width: 150px;" 
            onclick="window.location.href='@Url.Action("AddNewCheckedOutAsset", "CheckedOutAssets", new { id = Model.AssetID })'">
        Check Out Asset
    </button>
</div>

<!-- Existing Delete Confirmation Modal -->
<div id="deleteModal" class="modal">
    <div class="modal-content">
        <div id="deleteMessage">Are you sure you want to delete this asset?</div>
        <div style="margin-top: 15px;">
            <input type="checkbox" id="confirmDeleteCheckbox" onclick="toggleConfirmButton()">
            <label for="confirmDeleteCheckbox">I am sure I want to delete this asset</label>
        </div>
        <button id="confirmDeleteButton" class="btn btn-danger" onclick="executeDelete()" disabled>Confirm</button>
        <button onclick="closeModal()" class="btn btn-secondary">Cancel</button>
    </div>
</div>

<!-- Existing Save Changes Confirmation Modal -->
<div id="saveChangesModal" class="modal">
    <div class="modal-content">
        <div id="saveChangesMessage">Are you sure you want to save changes?</div>
        <div id="updateDetails" style="margin-top: 15px;"></div> <!-- Place to show changes -->
        <button id="confirmSaveButton" class="btn btn-success" onclick="submitForm()">Confirm</button>
        <button onclick="closeSaveModal()" class="btn btn-secondary">Cancel</button>
    </div>
</div>


            @section Scripts {
                <script>
    function confirmDeleteUser(userID, event) {
        if (event) event.preventDefault();

        fetch(`/Users/CheckUserReferences?userID=${userID}`)
            .then(response => response.json())
            .then(data => {
                const deleteMessage = document.getElementById("deleteUserMessage");
                
                if (data.hasReferences) {
                    // If references exist, show detailed message with link
                    deleteMessage.innerHTML = `
                        <p>This user has checked-out assets associated with them:</p>
                        <ul>
                            ${data.references.map(ref => `
                                <li>
                                    <strong>Asset:</strong> ${ref.Description || 'Unknown'},
                                    <strong>Date Lent:</strong> ${ref.DateLentOut ? new Date(ref.DateLentOut).toLocaleDateString() : 'N/A'},
                                    <strong>Status:</strong> ${ref.DateReturned ? "Returned" : "Not Returned"}
                                </li>
                            `).join("")}
                        </ul>
                        <p>Do you want to delete this user along with the associated records?</p>
                        <a href="/CheckedOutAssets/EditCheckedOutAsset?checkedoutid=${data.references[0]?.CheckedOutID}" target="_blank">View Checked Out Record</a>
                    `;
                } else {
                    // If no references, show simple confirmation message
                    deleteMessage.textContent = "Are you sure you want to delete this user?";
                }

                // Set up the delete button with the user ID
                document.getElementById("confirmDeleteUserButton").setAttribute("onclick", `executeDeleteUser(${userID})`);
                document.getElementById("deleteUserModal").style.display = "flex";
            })
            .catch(error => console.error('Error:', error));
    }

                    function executeDelete(assetID) {
                        fetch(`/Assets/DeleteAsset?assetID=${assetID}`, { method: "DELETE" })
                            .then(response => {
                                if (response.ok) {
                                    alert("Asset deleted successfully.");
                                    window.location.href = '/Assets';
                                } else {
                                    alert("Failed to delete asset.");
                                }
                                closeModal();
                            })
                            .catch(error => console.error('Error:', error));
                    }

                    function closeModal() {
                        document.getElementById("deleteModal").style.display = "none";
                    }

                    function toggleConfirmButton() {
                        const checkbox = document.getElementById("confirmDeleteCheckbox");
                        const confirmButton = document.getElementById("confirmDeleteButton");

                        // Enable Confirm button if checkbox is checked
                        confirmButton.disabled = !checkbox.checked;
                    }





                    let formChanged = false;
                    const originalValues = {};

                    // Capture initial values
                    document.querySelectorAll('.form-control').forEach(input => {
                        originalValues[input.id] = input.value;

                        input.addEventListener('input', () => {
                            formChanged = true;
                        });
                    });

                    // Show confirmation modal with details of changes
                    document.querySelector('.btn-success').addEventListener('click', function (event) {
                        if (formChanged) {
                            event.preventDefault();

                            // Gather changed fields
                            const changes = [];
                            document.querySelectorAll('.form-control').forEach(input => {
                                if (input.value !== originalValues[input.id]) {
                                    changes.push(`<p><strong>${input.previousElementSibling.innerText}:</strong> ${originalValues[input.id]} → ${input.value}</p>`);
                                }
                            });

                            // Display changes in modal
                            document.getElementById("updateDetails").innerHTML = changes.join("");
                            document.getElementById("saveChangesModal").style.display = "block";
                        }
                    });

                    // Submit the form after confirmation
                    function submitForm() {
                        document.querySelector('form').submit();
                    }

                    // Close the Save Changes Modal
                    function closeSaveModal() {
                        document.getElementById("saveChangesModal").style.display = "none";
                    }


    const returnUrl = params.get('returnUrl');
    const backButton = document.getElementById('backButton');

    if (returnUrl) {
        backButton.onclick = function() {
            window.location.href = returnUrl; // Navigate to the original page
        };
    } else {
        backButton.onclick = function() {
            window.location.href = '@Url.Action("Index", "Assets")'; // Fallback to Index page
        };
    }

                </script>
            }

            <style>

                .btn-1 {
                    position: relative;
                    display: inline-block;
                    padding: 10px 20px;
                    color: #ffffff;
                    background-color: #3498db;
