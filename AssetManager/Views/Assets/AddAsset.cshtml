@model AssetManager.Models.Asset
@{
    ViewData["Title"] = "New Asset";
}

<div class="container-wrapper">

    <div class="form-container-small">
        
        <h3 class="text-center">Add New Asset</h3>
        <p class="text-muted mt-2 text-center" style="font-size: 0.875rem;">Please enter the new asset details below. Once complete, press the button below to save the new assets.</p>
        <form asp-action="AddAsset" method="post" class="mt-4">
            <div class="form-group">
                <label for="equipmentType">Equipment Type:</label>
                <select id="equipmentTypeDropdown" class="form-control" name="EquipmentType" required>
                    <option selected disabled value="">Select Equipment Type...</option>
                    @if (ViewBag.EquipmentTypes != null)
                    {
                        @foreach (var type in ViewBag.EquipmentTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    }
                    <option value="newType">Add New Type</option>
                </select>
                <input type="text" class="form-control mt-2" id="newEquipmentType" name="NewEquipmentType" placeholder="Enter new equipment type" style="display: none;">
            </div>

            <div class="form-group">
                <label for="manufacturer">Manufacturer:</label>
                <input type="text" class="form-control" id="manufacturer" name="Manufacturer" placeholder="Enter manufacturer" required>
            </div>

            <div class="form-group">
                <label for="assetDescription">Asset Description:</label>
                <input type="text" class="form-control" id="assetDescription" name="Description" placeholder="Enter asset description" required>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6 pr-md-3"> 
                    <label for="assetNumber">Asset Number:</label>
                    <input type="text" class="form-control" id="assetNumber" name="AssetNumber" placeholder="Enter asset number" required>
                </div>
                <div class="form-group col-md-6 pl-md-3"> 
                    <label for="serialNumber">Serial Number:</label>
                    <input type="text" class="form-control" id="serialNumber" name="SerialNumber" placeholder="Enter serial number" required>
                </div>
            </div>

            <div class="form-group">
                <label for="office">Office:</label>
                <select id="office" name="OfficeID" class="form-control" required>
                    <option selected disabled value="">Select Office...</option>
                    @foreach (var office in ViewBag.Offices)
                    {
                        <option value="@office.OfficeID">@office.OfficeName - @office.Location</option>
                    }
                </select>
            </div>
            <br />

            <button type="submit" class="btn btn-primary btn-block">Save New Asset</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>



    h2.text-center {
        
        color: #333;
        margin-bottom: 30px;
    }

    .form-row {
        display: flex;
        gap: 15px; 
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        font-weight: 500;
        color: #333;
    }

    .form-control {
        border-radius: 4px;
        padding: 12px;
    }

    .btn-block {
        width: 100%;
        padding: 12px;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border: none;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }

    h3 {
        font-weight: 400; /* Makes the font very thin */
    }


</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function(){
        $('#equipmentTypeDropdown').on('change', function() {
            if ($(this).val() === 'newType') {
                $('#newEquipmentType').show().attr('required', true);
            } else {
                $('#newEquipmentType').hide().attr('required', false);
            }
        });

        $('form').on('submit', function() {
            var newType = $('#newEquipmentType').val();
            if (newType) {
                $('#equipmentTypeDropdown').val(newType);
            }
        });
    });
</script>
