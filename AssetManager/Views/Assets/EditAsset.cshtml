<br />
<br />

<div class="container-wrapper">
    <div class="form-container">
        <h3 class="text-center display-4">@Model.Manufacturer - @Model.Description</h3>
        <p class="text-center">
            @{
                var office = ((List<Office>)ViewBag.Offices).FirstOrDefault(o => o.OfficeID == Model.OfficeID);
                string officeDetails = office != null ? $"{office.OfficeName} - {office.Location}" : "Office not found";
            }
            @officeDetails
        </p>

        <!-- Asset Update Form -->
        <form method="post" action="@Url.Action("UpdateAsset", "Assets")" class="mt-4">
            <input type="hidden" name="AssetID" value="@Model.AssetID" />
            <h4>Edit Asset Details</h4>
            <hr class="section-divider">
            <p>Edit Asset details below by updating information and clicking Save Changes.</p>

            <!-- Asset Fields -->
            <div class="form-group">
                <label for="Description">Description</label>
                <input type="text" class="form-control" id="Description" name="Description" value="@Model.Description" placeholder="Enter asset description" />
            </div>

            <div class="form-group">
                <label for="Manufacturer">Manufacturer</label>
                <input type="text" class="form-control" id="Manufacturer" name="Manufacturer" value="@Model.Manufacturer" placeholder="Enter manufacturer" />
            </div>

            <div class="form-group">
                <label for="EquipmentType">Equipment Type</label>
                <select class="form-control" id="EquipmentType" name="EquipmentType">
                    <option value="">Select Type</option>
                    @foreach (var type in ViewBag.EquipmentTypes)
                    {
                        <option value="@type" selected="@(Model.EquipmentType == type ? "selected" : null)">@type</option>
                    }
                </select>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6 pr-md-3">
                    <label for="AssetNumber">Asset Number</label>
                    <input type="text" class="form-control" id="AssetNumber" name="AssetNumber" value="@Model.AssetNumber" placeholder="Enter asset number" />
                </div>
                <div class="form-group col-md-6 pl-md-3">
                    <label for="SerialNumber">Serial Number</label>
                    <input type="text" class="form-control" id="SerialNumber" name="SerialNumber" value="@Model.SerialNumber" placeholder="Enter serial number" />
                </div>
            </div>

            <div class="form-group">
                <label for="OfficeID">Office</label>
                <select class="form-control" id="OfficeID" name="OfficeID">
                    <option value="">Select Office</option>
                    @foreach (var office in ViewBag.Offices)
                    {
                        <option value="@office.OfficeID" selected="@(Model.OfficeID == office.OfficeID ? "selected" : null)">@office.OfficeName - @office.Location</option>
                    }
                </select>
            </div>

            <!-- Save Changes Button -->
            <div class="form-group d-flex justify-content-around mt-4">
                <button type="submit" class="btn btn-1" style="width: 150px;">Save Changes</button>
            </div>
        </form>


        <!-- Back and Delete Buttons -->
        <div class="form-group d-flex justify-content-around mt-4">
            <button type="button" class="btn btn-secondary" style="width: 150px;" onclick="window.location.href='@Url.Action("Index", "Assets")'">Back to List</button>






            <!-- Delete Button -->
            <button type="button" onclick="confirmDelete(@Model.AssetID, event)" class="btn btn-2">Delete Asset</button>

            <div id="deleteModal" class="modal">
                <div class="modal-content">
                    <div id="deleteMessage">Are you sure you want to delete this asset?</div>

                    <!-- Confirmation Checkbox -->
                    <div style="margin-top: 15px;">
                        <input type="checkbox" id="confirmDeleteCheckbox" onclick="toggleConfirmButton()">
                        <label for="confirmDeleteCheckbox">I am sure I want to delete this asset</label>
                    </div>

                    <!-- Confirm and Cancel Buttons -->
                    <button id="confirmDeleteButton" class="btn btn-danger" onclick="executeDelete()" disabled>Confirm</button>
                    <button onclick="closeModal()" class="btn btn-secondary">Cancel</button>
                </div>
            </div>


            <div id="saveChangesModal" class="modal">
                <div class="modal-content">
                    <div id="saveChangesMessage">Are you sure you want to save changes?</div>
                    <div id="updateDetails" style="margin-top: 15px;"></div> <!-- Place to show changes -->

                    <button id="confirmSaveButton" class="btn btn-success" onclick="submitForm()">Confirm</button>
                    <button onclick="closeSaveModal()" class="btn btn-secondary">Cancel</button>
                </div>
            </div>


            @section Scripts {
                <script>
                    function confirmDelete(assetID, event) {
                        if (event) event.preventDefault();

                        fetch(`/Assets/CheckReferences?assetID=${assetID}`)
                            .then(response => response.json())
                            .then(data => {
                                const deleteMessage = document.getElementById("deleteMessage");
                                if (data.hasReferences) {
                                    // If references exist, show detailed message with link
                                    deleteMessage.innerHTML = `
                                                <p>This asset has a checked-out record associated with it:</p>
                                                <ul>
                                                    <li><strong>User:</strong> ${data.userName}</li>
                                                    <li><strong>Checked Out Date:</strong> ${data.checkedOutDate}</li>
                                                </ul>
                                                <p>Do you want to delete this asset along with its associated record?</p>
                                                <a href="/CheckedOutAssets/EditCheckedOutAsset?checkedoutid=${data.checkedOutID}" target="_blank">View Checked Out Record</a>
                                            `;
                                } else {
                                    // If no references, show simple confirmation message
                                    deleteMessage.textContent = "Are you sure you want to delete this asset?";
                                }
                                document.getElementById("confirmDeleteButton").setAttribute("onclick", `executeDelete(${assetID})`);
                                document.getElementById("deleteModal").style.display = "block";
                            })
                            .catch(error => console.error('Error:', error));
                    }

                    function executeDelete(assetID) {
                        fetch(`/Assets/DeleteAsset?assetID=${assetID}`, { method: "DELETE" })
                            .then(response => {
                                if (response.ok) {
                                    alert("Asset deleted successfully.");
                                    window.location.href = '/Assets';
                                } else {
                                    alert("Failed to delete asset.");
                                }
                                closeModal();
                            })
                            .catch(error => console.error('Error:', error));
                    }

                    function closeModal() {
                        document.getElementById("deleteModal").style.display = "none";
                    }

                    function toggleConfirmButton() {
                        const checkbox = document.getElementById("confirmDeleteCheckbox");
                        const confirmButton = document.getElementById("confirmDeleteButton");

                        // Enable Confirm button if checkbox is checked
                        confirmButton.disabled = !checkbox.checked;
                    }





                    let formChanged = false;
                    const originalValues = {};

                    // Capture initial values
                    document.querySelectorAll('.form-control').forEach(input => {
                        originalValues[input.id] = input.value;

                        input.addEventListener('input', () => {
                            formChanged = true;
                        });
                    });

                    // Show confirmation modal with details of changes
                    document.querySelector('.btn-success').addEventListener('click', function (event) {
                        if (formChanged) {
                            event.preventDefault();

                            // Gather changed fields
                            const changes = [];
                            document.querySelectorAll('.form-control').forEach(input => {
                                if (input.value !== originalValues[input.id]) {
                                    changes.push(`<p><strong>${input.previousElementSibling.innerText}:</strong> ${originalValues[input.id]} → ${input.value}</p>`);
                                }
                            });

                            // Display changes in modal
                            document.getElementById("updateDetails").innerHTML = changes.join("");
                            document.getElementById("saveChangesModal").style.display = "block";
                        }
                    });

                    // Submit the form after confirmation
                    function submitForm() {
                        document.querySelector('form').submit();
                    }

                    // Close the Save Changes Modal
                    function closeSaveModal() {
                        document.getElementById("saveChangesModal").style.display = "none";
                    }





                </script>
            }

            <style>

                .btn-1 {
                    position: relative;
                    display: inline-block;
                    padding: 10px 20px;
                    color: #ffffff;
                    background-color: #3498db;
                    overflow: hidden;
                    transition: color 0.3s ease;
                    text-decoration: none;
                    font-weight: bold;
                    z-index: 1;
                }

                    .btn-1:before {
                        content: '';
                        position: absolute;
                        top: 0;
                        left: -50px;
                        bottom: 0;
                        width: 200%;
                        background-color: rgba(40, 116, 166, 0.8); /* Darker shade of blue with transparency */
                        border-right: 50px solid transparent;
                        border-bottom: 50px solid rgba(40, 116, 166, 0.8); /* Adjust to match button height */
                        transform: translateX(-100%);
                        transition: transform 0.3s ease;
                        z-index: -1; /* Ensures overlay is behind the text */
                    }

                    .btn-1:hover {
                        color: #ffffff; /* Keep text white on hover */
                    }

                        .btn-1:hover:before {
                            transform: translateX(0);
                        }


                .btn-2 {
                    position: relative;
                    display: inline-block;
                    padding: 10px 20px;
                    color: white; /* White text */
                    background-color: red; /* Red background */
                    overflow: hidden;
                    border: none;
                    transition: color 0.3s ease;
                    text-decoration: none;
                    font-weight: bold;
                    z-index: 1;
                }

                    .btn-2:before,
                    .btn-2:after {
                        content: '';
                        position: absolute;
                        top: 0;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        border-top: 25px solid darkred; /* Darker shade of red */
                        border-bottom: 25px solid darkred;
                        transition: transform 0.4s ease;
                    }

                    .btn-2:before {
                        border-right: 25px solid transparent;
                        transform: translateX(-100%);
                    }

                    .btn-2:after {
                        border-left: 25px solid transparent;
                        transform: translateX(100%);
                    }

                    .btn-2:hover {
                        color: white; /* Keep text white on hover */
                    }

                        .btn-2:hover:before {
                            transform: translateX(-30%); /* Slide inwards on hover */
                        }

                        .btn-2:hover:after {
                            transform: translateX(30%); /* Slide inwards on hover */
                        }




                .modal {
                    display: none;
                    position: fixed;
                    z-index: 1000;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background-color: rgba(0, 0, 0, 0.7); /* Darker overlay for better readability */
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                .modal-content {
                    background-color: #fff;
                    position: relative;
                    left: 42%; /* Start positioning from the center of the screen */
                    padding: 20px;
                    border: 1px solid #888;
                    width: 600px;
                    text-align: center;
                    font-size: 1.2em; /* Larger font size for readability */
                    color: #333;
                    margin-bottom: 20px; /* Spacing below message */
                    line-height: 1.6; /* Line height for better readability */
                }

                /* Modal Message */
                #deleteMessage {
                    font-size: 1.2em; /* Larger font size for readability */
                    color: #333;
                    margin-bottom: 20px; /* Spacing below message */
                    line-height: 1.6; /* Line height for better readability */
                }

                /* List Styling inside Modal */
                .modal-content ul {
                    list-style-type: none;
                    padding: 0;
                    font-size: 1.1em;
                    color: #555;
                }

                .modal-content li {
                    margin-bottom: 10px;
                }

                /* Link Styling inside Modal */
                .modal-content a {
                    color: #007bff;
                    text-decoration: underline;
                    font-weight: bold;
                    margin-top: 15px;
                    display: inline-block;
                }

                /* Button Styling inside Modal */
                .modal-content button {
                    margin-top: 20px;
                    width: 120px;
                    padding: 10px;
                    font-size: 1em;
                }



                .modal {
                    display: none; /* Hidden by default */
                    position: fixed;
                    z-index: 1000;
                    left: 0;
                    top: 0;
                    width: 100%;
                    height: 100%;
                    overflow: auto;
                    background-color: rgba(0,0,0,0.5); /* Black background with opacity */
                }

                .modal-content {
                    background-color: #fff;
                    position: relative;
                    top: 15%; /* Distance from the top */
                    right: 30%; /* Shift modal more to the right of the viewport */
                    transform: translateX(10%); /* Additional shift for fine-tuning */
                    padding: 20px;
                    border: 1px solid #888;
                    width: 600px;
                    text-align: center;
                }




                .container-wrapper {
                    display: flex;
                    justify-content: center;
                    width: 100%;
                    padding: 20px;
                }

                .form-container {
                    width: 1000px;
                    padding: 50px;
                    border: 1px solid #ddd;
                    border-radius: 8px;
                    background-color: #fdfdfd;
                    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
                }

                .section-title {
                    font-size: 1.25rem;
                    font-weight: 600;
                    color: #333;
                    margin-bottom: 10px;
                }

                .section-divider {
                    border: 0;
                    height: 1px;
                    background-color: #ddd;
                    margin-bottom: 20px;
                }

                .form-row {
                    display: flex;
                    gap: 15px;
                }

                .form-group {
                    margin-bottom: 20px;
                }

                    .form-group label {
                        font-weight: bold;
                        color: #333;
                    }

                .form-control {
                    border-radius: 4px;
                    padding: 12px;
                }

                .btn-success {
                    background-color: #378b15;
                    color: #fff;
                    border: none;
                }

                .btn-secondary {
                    background-color: #6c757d;
                    color: #fff;
                    border: none;
                }

                .btn-primary {
                    background-color: #007bff;
                    color: #fff;
                    border: none;
                }

                .btn-danger {
                    background-color: #e81e1e;
                    color: #fff;
                    border: none;
                }

                    .btn-success:hover, .btn-secondary:hover, .btn-primary:hover, .btn-danger:hover {
                        opacity: 0.9;
                    }

                .btn-custom {
                    width: 150px;
                    padding: 10px 0;
                    font-size: 1rem;
                    text-align: center;
                }
            </style>
