<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Download Reports</title>
    <style>
   
            .container-box h1 {
                font-size: 1.5em;
                margin-bottom: 15px;
            }

            .container-box ul {
                list-style-type: none;
                padding: 0;
                margin: 0;
            }

            .container-box li {
                margin: 10px 0;
            }

            .container-box a {
                text-decoration: none;
                color: #007bff;
                transition: color 0.3s;
            }

                .container-box a:hover {
                    color: #0056b3;
                }


        .container-wrapper {
            display: flex;
            justify-content: center;
            width: 100%;
            padding: 20px;
            height: 500px;
        }

        .form-container {
            width: 1000px;
            padding: 50px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #fdfdfd;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
            margin-top: 20px;

    </style>
</head>
<body>

    <div class="container-wrapper">

        <div class="form-container">
            <h1 class="text-center display-4">Download Reports</h1>
            <ul>
                <li><a href="@Url.Action("ReportAssets", "Home")">Report Assets</a></li>
                <li><a href="@Url.Action("ReportLoanedAssets", "Home")">Report Loaned Assets</a></li>
                <li><a href="@Url.Action("ReportUsers", "Home")">Report Users</a></li>
            </ul>
        </div>
    </div>

</body>
</html>
