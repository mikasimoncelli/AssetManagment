<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

</head>
@{
    ViewData["Title"] = "Reports";
}
<body>

    <div class="container-wrapper" style="padding: 20px; background-color: #f9f9f9; border-radius: 8px;">
        <div class="form-container">
            <h3 class="mb-4" style="color: #343a40;">Download Reports</h3>
            <div class="mb-3">
                <a href="@Url.Action("AssetsReport", "Home")" class="btn btn-primary btn-sm" role="button" style="width: 200px;">
                    Assets Report
                </a>
                <p class="text-muted mt-2" style="font-size: 0.875rem;">View a report of all assets in the inventory.</p>
            </div>
            <div class="mb-3">
                <a href="@Url.Action("LoanedAssetsReport", "Home")" class="btn btn-secondary btn-sm" role="button" style="width: 200px;">
                    Loaned Assets Report
                </a>
                <p class="text-muted mt-2" style="font-size: 0.875rem;">View a report of all loans, past and current.</p>
            </div>
            <div>
                <a href="@Url.Action("UsersReport", "Home")" class="btn btn-success btn-sm" role="button" style="width: 200px;">
                    Users Report
                </a>
                <p class="text-muted mt-2" style="font-size: 0.875rem;">View a report of all users.</p>
            </div>
        </div>
    </div>


    <style>
        .container-wrapper {
            display: flex;
            justify-content: center;
            width: 100%;
            padding: 20px;
            height: 500px;
        }

        .form-container {
            width: 1000px;
            padding: 40px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #fdfdfd;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
            margin-top: 20px;
            text-align: center;
        }

            .form-container h1 {
                margin-bottom: 40px;
                color: #333;
            }

            .form-container ul {
                list-style-type: none;
                padding: 0;
                margin: 0;
            }

            .form-container li {
                margin: 15px 0;
            }

          
                .form-container a:hover {
                    background-color: #0056b3;
                    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.2);
                }
    </style>

</body>
</html>
