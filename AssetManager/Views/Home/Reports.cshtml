<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

</head>
@{
    ViewData["Title"] = "Reports";
}
<body>

    <div class="container-wrapper">
        <div class="form-container">
            <h1 class="display-4">Download Reports</h1>
            <ul>
                <li><a href="@Url.Action("AssetsReport", "Home")">Assets Report</a></li>
                <li><a href="@Url.Action("LoanedAssetsReport", "Home")">Loaned Assets Report</a></li>
                <li><a href="@Url.Action("UsersReport", "Home")">Users Report</a></li>
            </ul>
        </div>
    </div>


    <style>
        .container-wrapper {
            display: flex;
            justify-content: center;
            width: 100%;
            padding: 20px;
            height: 500px;
        }

        .form-container {
            width: 1000px;
            padding: 40px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #fdfdfd;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
            margin-top: 20px;
            text-align: center;
        }

            .form-container h1 {
                margin-bottom: 40px;
                border-bottom: 2px solid;
                color: #333;
            }

            .form-container ul {
                list-style-type: none;
                padding: 0;
                margin: 0;
            }

            .form-container li {
                margin: 15px 0;
            }

            .form-container a {
                display: block;
                padding: 15px;
                background-color: #007bff;
                color: #fff;
                border-radius: 5px;
                text-decoration: none;
                font-size: 1.1em;
                font-weight: 500;
                transition: background-color 0.3s ease;
                box-shadow: 0px 2px 6px rgba(0, 0, 0, 0.1);
            }

                .form-container a:hover {
                    background-color: #0056b3;
                    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.2);
                }
    </style>

</body>
</html>
