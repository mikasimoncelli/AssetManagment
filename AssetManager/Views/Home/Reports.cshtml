<!DOCTYPE html>
<html lang="en">
<head>
    @{
    ViewData["Title"] = "Reports";
}

    <title>Reports</title>
    
</head>
<body>

    <div class="container-wrapper" style="padding: 20px; border-radius: 8px;">
        <div class="form-container-small text-center">
            <h3 class="mb-4" style="color: #343a40;">Download Reports</h3>

            <div class="mb-3">
                <a href="@Url.Action("AssetsReport", "Home")" class="btn btn-success btn-sm" role="button" style="width: 200px;">
                    Assets Report
                </a>
                <p class="text-muted mt-2" style="font-size: 0.875rem;">View a report of all assets in the inventory.</p>
            </div>
            <div class="mb-3">
                <a href="@Url.Action("LoanedAssetsReport", "Home")" class="btn btn-success btn-sm" role="button" style="width: 200px;">
                    Loaned Assets Report
                </a>
                <p class="text-muted mt-2" style="font-size: 0.875rem;">View a report of all loans, past and current.</p>
            </div>

            <div>
                <a href="@Url.Action("DamagesReport", "Home")" class="btn btn-success btn-sm" role="button" style="width: 200px;">
                    Damages Report
                </a>
                <p class="text-muted mt-2" style="font-size: 0.875rem;">View a report of all damaged assets.</p>
            </div>

            <div>
                <a href="@Url.Action("DisposalsReport", "Home")" class="btn btn-success btn-sm" role="button" style="width: 200px;">
                    Disposals Report
                </a>
                <p class="text-muted mt-2" style="font-size: 0.875rem;">View a report of all disposed of assets.</p>
            </div>

            <div>
                <a href="@Url.Action("UsersReport", "Home")" class="btn btn-success btn-sm" role="button" style="width: 200px;">
                    Users Report
                </a>
                <p class="text-muted mt-2" style="font-size: 0.875rem;">View a report of all users.</p>
            </div>

        </div>
    </div>
    </body>
</html>

