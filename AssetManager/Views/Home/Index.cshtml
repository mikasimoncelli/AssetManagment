@{
    ViewData["Title"] = "Admin Dashboard";
    var assetCount = ViewBag.assetCount as IEnumerable<dynamic>;
    var phoneAvailability = ViewBag.phoneAvailability ?? 0;
    var laptopAvailability = ViewBag.laptopAvailability ?? 0;
}

<div class="container-fluid" style="padding: 40px;">
    <div class="text-center mb-5">
        <h1 class="display-4">Asset Management Console</h1>
        <p>Overview of asset distribution and availability</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="text-center">Distribution and Total Assets</h4>
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div style="width: 100%; height: 400px;">
                                <canvas id="assetChart"></canvas>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center justify-content-center">
                            <div class="text-center">
                                <h5>Total Assets</h5>
                                <h1 class="display-1" style="font-weight: bold; color: #0b3d91; font-size:150px">
                                    @ViewBag.totalAssets
                                </h1>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="text-center">Availability Overview</h4>
                    <div class="row">
                        <div class="col-md-6 text-center">
                            <h5>Phone Availability</h5>
                            <canvas id="phoneChart" style="width: 250px; height: 150px;"></canvas>
                        </div>
                        <div class="col-md-6 text-center">
                            <h5>Laptop Availability</h5>
                            <canvas id="laptopChart" style="width: 250px; height: 150px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div id="notificationsContainer" class="card mb-4">
                <div class="card-body">
                    <h5 class="text-center">Notifications</h5>
                    <ul id="notifications" class="list-group">
                        <li class="list-group-item">You have no new notifications!</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

<script>
    // Data for Bar Chart
    var officeLabels = [];
    var officeIDs = [];
    var assetsCount = [];
    @foreach (var item in assetCount)
    {
        <text>
            officeLabels.push("@item.OfficeName");
            officeIDs.push("@item.OfficeID");
            assetsCount.push(@item.AssetsCount);
        </text>
    }

    const ctxBar = document.getElementById('assetChart').getContext('2d');
    const maxAssetsCount = Math.max(...assetsCount);

    const assetChart = new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: officeLabels,
            datasets: [{
                label: 'Assets Count',
                data: assetsCount,
                backgroundColor: ['#0b3d91', '#1259a3', '#1768ad', '#2085bf', '#2993c8', '#42a2d9', '#85c1e9'],
                borderColor: ['#0b3d91', '#1259a3', '#1768ad', '#2085bf', '#2993c8', '#42a2d9', '#85c1e9'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                datalabels: {
                    anchor: 'end',
                    align: 'top',
                    formatter: Math.round,
                    color: '#333',
                    font: { size: 14 }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: maxAssetsCount * 1.1 
                }
            },
            onClick: (event, elements) => {
                if (elements.length > 0) { 
                    const index = elements[0].index;
                    const officeID = officeIDs[index]; 
                    
                    // Redirect to the asset view page for the selected office
                    window.location.href = `/Assets/Office/${officeID}`;
                }
            }
        },
        plugins: [ChartDataLabels]
    });

    // Pie Chart: Phone Availability
    const ctxPhone = document.getElementById('phoneChart').getContext('2d');
    const phoneChart = new Chart(ctxPhone, {
        type: 'pie',
        data: {
            labels: ['Available', 'Checked Out'],
            datasets: [{
                data: [@phoneAvailability, 100 - @phoneAvailability],
                backgroundColor: ['#1b5daa', '#ddd'],
                borderColor: ['#1b5daa', '#ddd']
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: true },
                datalabels: {
                    color: '#333',
                    font: { size: 14 },
                    formatter: (value) => value + '%'
                }
            }
        },
        plugins: [ChartDataLabels]
    });

    // Pie Chart: Laptop Availability
    const ctxLaptop = document.getElementById('laptopChart').getContext('2d');
    const laptopChart = new Chart(ctxLaptop, {
        type: 'pie',
        data: {
            labels: ['Available', 'Checked Out'],
            datasets: [{
                data: [@laptopAvailability, 100 - @laptopAvailability],
                backgroundColor: ['#4b7ddd', '#ddd'],
                borderColor: ['#4b7ddd', '#ddd']
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: true },
                datalabels: {
                    color: '#333',
                    font: { size: 14 },
                    formatter: (value) => value + '%'
                }
            }
        },
        plugins: [ChartDataLabels]
    });
</script>

<style>
    .container-fluid {
        background-color: #f8f9fa;
    }

    .card {
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        border: none;
    }

    .card-title {
        font-weight: bold;
        color: #333;
    }

    #assetChart {
        height: 400px;
    }

    #phoneChart, #laptopChart {
        width: 350px !important; 
        height: 350px !important; 
    }

    #notificationsContainer {
        width: 500px;
        height: 600px;
        max-height: 600px;
        overflow-y: auto;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        z-index: 1000;
    }
</style>
