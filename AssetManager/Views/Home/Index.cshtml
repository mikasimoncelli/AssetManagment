@{
    ViewData["Title"] = "Dashboard";
    var assetCount = ViewBag.assetCount as IEnumerable<dynamic>;
    var phoneAvailability = ViewBag.phoneAvailability ?? 0;
    var laptopAvailability = ViewBag.laptopAvailability ?? 0;
}

<div class="container-wrapper">
    <div class="form-container">
        <div class="logo-top-right">
            <img src="~/images/Favicon.jpg" alt="Company Logo" class="img-fluid">
        </div>

    <div class="text-center mb-5">
        <h3>Dashboard</h3>
    </div>

        <div class="row justify-content-center p-0">
            <div class="col-md-8" style="padding-right: 0; margin-right: 0;">
                <!-- Distribution and Total Assets Section -->
                <div class="card mb-3" style="width: 95%;">
                    <div class="card-body">
                        <h5 class="text-center">Distribution and Total Assets</h5>
                        <div class="row">
                            <div class="col-md-8">
                                <div class="asset-distribution">
                                    <canvas id="assetChart"></canvas>
                                </div>
                            </div>
                            <div class="col-md-4 d-flex justify-content-center">
                                <div class="text-center">
                                    <h6>Total Assets:</h6>
                                    <h1 class="display-1 asset-title" style="font-weight: bold; color: #0b3d91; font-size: 120px;">
                                        <div class="asset-title">@ViewBag.totalAssets</div>
                                    </h1>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Availability Overview Section -->
                <div class="card mb-2" style="width: 95%;">
                    <div class="card-body">
                        <h5 class="text-center">Availability Overview</h5>
                        <div class="row">
                            <div class="col-md-6 text-center">
                                <h6>Phone Availability</h6>
                                <canvas id="phoneChart"></canvas>
                            </div>
                            <div class="col-md-6 text-center">
                                <h6>Laptop Availability</h6>
                                <canvas id="laptopChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loan Notifications Section -->
            <div class="col-md-4" style="width: 500px; margin-left: 0; padding-left:0;">
                <div id="notificationsContainer" class="card mb-4" syle="height: 200px;" >
                    <div class="card-body">
                        <h5 class="text-center">Loan Notifications</h5>

                        <!-- Overdue Returns -->
                        @if (ViewBag.OverdueReturns != null && ViewBag.OverdueReturns.Count > 0)
                        {
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th class="text-danger">OVERDUE</th>
                                        <th>Return Date</th>
                                        <th>User</th>
                                    </tr>
                                </thead>
                            </table>
                            <div style="max-height: 150px; overflow-y: auto;">
                                <table class="table table-hover mb-0">
                                    <tbody>
                                        @foreach (var overdueItem in ViewBag.OverdueReturns)
                                        {
                                            <tr onclick="window.location.href='/CheckedOutAssets/EditCheckedOutAsset?checkedoutid=@overdueItem.CheckedOutID&returnUrl=' + encodeURIComponent(window.location.href)" style="cursor:pointer;">
                                                <td>@overdueItem.AssetName</td>
                                                <td>@overdueItem.DueDate?.ToString("MMM dd, yyyy")</td>
                                                <td>@overdueItem.UserName</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        <br />

                        <!-- Upcoming Returns -->
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>UPCOMING</th>
                                    <th>Return Date</th>
                                    <th>User</th>
                                </tr>
                            </thead>
                        </table>
                        <div style="max-height: 150px; overflow-y: auto;">
                            <table class="table table-hover mb-0">
                                <tbody>
                                    @if (ViewBag.UpcomingReturns != null && ViewBag.UpcomingReturns.Count > 0)
                                    {
                                        @foreach (var returnItem in ViewBag.UpcomingReturns)
                                        {
                                            var daysUntilReturn = (returnItem.DueDate - DateTime.Now).Days;
                                            var daysText = returnItem.DueDate.Date == DateTime.Now.Date
                                            ? "Today"
                                            : daysUntilReturn == 0
                                            ? "Tomorrow"
                                            : $"{daysUntilReturn} days";
                                            <tr onclick="window.location.href='/CheckedOutAssets/EditCheckedOutAsset?checkedoutid=@returnItem.CheckedOutID&returnUrl=' + encodeURIComponent(window.location.href)" style="cursor: pointer;">
                                                <td>@returnItem.AssetName</td>
                                                <td><strong>@daysText</strong> on @returnItem.DueDate?.ToString("MMM dd, yyyy")</td>
                                                <td>@returnItem.UserName</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center">You have no upcoming returns!</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- New Card Underneath Loan Notifications -->
                <div id="newCard" class="card">
                    <div class="card-body" style="height: 550px; overflow-y: auto;">
                        <h5 class="text-center">System Activity</h5>
                        <ul class="list-group">
                            @if (ViewBag.RecentActivities != null && ViewBag.RecentActivities.Count > 0)
                            {
                                foreach (var activity in ViewBag.RecentActivities)
                                {
                                    <li class="list-group-item">
                                        <strong>@activity.ActivityType:</strong> @activity.Description
                                        <br />
                                        <small>By: @activity.User.Email on @activity.CreatedAt.ToString("g")</small>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item text-center">No recent activity available.</li>
                            }
                        </ul>
                    </div>
                </div>




            </div>
        </div>





            </div>


    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

<script>
    // Data for Bar Chart
    var officeLabels = [];
    var officeIDs = [];
    var assetsCount = [];
    @foreach (var item in assetCount)
    {
        <text>
            officeLabels.push("@item.OfficeName");
            officeIDs.push("@item.OfficeID");
            assetsCount.push(@item.AssetsCount);
        </text>
    }

    const ctxBar = document.getElementById('assetChart').getContext('2d');
    const maxAssetsCount = Math.max(...assetsCount);

    const assetChart = new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: officeLabels,
            datasets: [{
                label: 'Assets Count',
                data: assetsCount,
                backgroundColor: ['#0b3d91', '#1259a3', '#1768ad', '#2085bf', '#2993c8', '#42a2d9', '#85c1e9'],
                borderColor: ['#0b3d91', '#1259a3', '#1768ad', '#2085bf', '#2993c8', '#42a2d9', '#85c1e9'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                datalabels: {
                    anchor: 'end',
                    align: 'top',
                    formatter: Math.round,
                    color: '#333',
                    font: { size: 14 }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: maxAssetsCount * 1.1 
                }
            },
            onClick: (event, elements) => {
                if (elements.length > 0) { 
                    const index = elements[0].index;
                    const officeID = officeIDs[index]; 
                    
                    // Redirect to the asset view page for the selected office
                    window.location.href = `/Assets/Office/${officeID}`;
                }
            }
        },
        plugins: [ChartDataLabels]
    });

    // Pie Chart: Phone Availability
    const ctxPhone = document.getElementById('phoneChart').getContext('2d');
    const phoneChart = new Chart(ctxPhone, {
        type: 'pie',
        data: {
            labels: ['Available', 'Checked Out'],
            datasets: [{
                data: [@phoneAvailability, 100 - @phoneAvailability],
                backgroundColor: ['#1b5daa', '#ddd'],
                borderColor: ['#1b5daa', '#ddd']
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: true },
                datalabels: {
                    color: '#333',
                    font: { size: 14 },
                    formatter: (value) => value + '%'
                }
            },
            onClick: (event, elements) => {
                if (elements.length > 0) {
                    const index = elements[0].index; // Get the index of the clicked segment
                    const label = phoneChart.data.labels[index]; // Get the label of the clicked segment

                    if (label === 'Available') {
                        // Navigate to ViewAvailableAssets and pass a query parameter
                        window.location.href = `CheckedOutAssets/ViewAvailableAssets?assetType=Phone`;
                    }
                    else if (label === 'Checked Out') {
                        window.location.href = `CheckedOutAssets/?assetType=Phone`;

                    }
                }
            }
        },
        plugins: [ChartDataLabels]
    });


// Pie Chart: Laptop Availability
const ctxLaptop = document.getElementById('laptopChart').getContext('2d');
const laptopChart = new Chart(ctxLaptop, {
    type: 'pie',
    data: {
        labels: ['Available', 'Checked Out'],
        datasets: [{
            data: [@laptopAvailability, 100 - @laptopAvailability],
            backgroundColor: ['#023e83', '#ddd'],
            borderColor: ['#023e83', '#ddd']
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: true },
            datalabels: {
                color: '#333',
                font: { size: 14 },
                formatter: (value) => value + '%'
            }
        },
        onClick: (event, elements) => {
            if (elements.length > 0) {
                const index = elements[0].index; // Get the index of the clicked segment
                const label = laptopChart.data.labels[index]; // Get the label of the clicked segment

                if (label === 'Available') {
                    window.location.href = `CheckedOutAssets/ViewAvailableAssets?assetType=Laptop`;
                } else if (label === 'Checked Out') {
                    window.location.href = `CheckedOutAssets?assetType=Laptop`;
                }
            }
        }
    },
    plugins: [ChartDataLabels]
});




</script>

<style>
        h1 {
            font-weight: 100; /* Makes the font very thin */
            text-decoration: solid;
        }

            .container-wrapper {
                display: flex;
                justify-content: center;
                width: 100%;
                padding: 20px;
            }

            .form-container {
                width: 2100px;
                padding: 50px;
                border: 2px solid #ddd;
                border-radius: 8px;
                background-color: #fdfdfd;
                box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
            }
    
    .container-fluid {
        background-color: #f8f9fa;
    }



    .card {
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        border: none;
    }

    .card-title {
        font-weight: bold;
        color: #333;
    }

    #assetChart {
        height: 500px;
    }

    #assetChart {
        cursor: default; /* Sets the default cursor for the canvas */
    }

        #assetChart:hover {
            cursor: pointer; /* Optional fallback for canvas hover */
        }


    #phoneChart, #laptopChart {
        width: 350px !important; 
        height: 350px !important; 
    }

    #phoneChart, #laptopChart {
        cursor: pointer;
    }

        #notificationsContainer {
            width: 100%;
            max-height: 450px;
            overflow-y: auto;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            background-color: #fff;
        }

        /* Ensure the notifications container takes full height within its column */
        .col-md-4 > #notificationsContainer {
            height: 100%;
            
        }


        #notifications .list-group-item {
            color: #333;
            background-color: #f8f9fa;
            border: none;
        }

            #notifications .list-group-item:nth-child(even) {
                background-color: #e9ecef;
            }


        .logo-top-right {
            position: absolute;
            top: 40px; /* Adjust as needed */
            right: 90px; /* Adjust as needed */
        }

        .logo-top-right img {
            max-width: 100px; /* Adjust the size as needed */
            height: auto;
        }


        body {
            overflow-y: hidden;
        }
</style>
