@{
    ViewData["Title"] = "Dashboard";
    var assetCount = ViewBag.assetCount as IEnumerable<dynamic>;
    var phoneAvailability = ViewBag.phoneAvailability ?? 0;
    var laptopAvailability = ViewBag.laptopAvailability ?? 0;
}

<div class="container-wrapper">
    <div class="form-container">
        <div class="logo-top-right">
            <img src="~/images/Favicon.jpg" alt="Company Logo" class="img-fluid">
        </div>
    <div class="text-center mb-5">
        <h1 class="display-4">Dashboard</h1>
        <p>Overview of asset distribution and availability</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="text-center">Distribution and Total Assets</h5>
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div style="width: 100%; height: 400px;">
                                <canvas id="assetChart"></canvas>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center justify-content-center">
                            <div class="text-center">
                                <h5>Total Assets</h5>
                                <h1 class="display-1" style="font-weight: bold; color: #0b3d91; font-size:150px">
                                    @ViewBag.totalAssets
                                </h1>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="text-center">Availability Overview</h5>
                    <div class="row">
                        <div class="col-md-6 text-center">
                            <h5>Phone Availability</h5>
                            <canvas id="phoneChart" style="width: 250px; height: 150px;"></canvas>
                        </div>
                        <div class="col-md-6 text-center">
                            <h5>Laptop Availability</h5>
                            <canvas id="laptopChart" style="width: 250px; height: 150px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

            <div class="col-md-4">

<div id="notificationsContainer" class="card mb-4">
    <div class="card-body">
        <h5 class="text-center">Loan Notifications</h5>

        <!-- Overdue Returns -->
        @if (ViewBag.OverdueReturns != null && ViewBag.OverdueReturns.Count > 0)
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
            <th class="text-danger">OVERDUE</th>
                        <th>Return Date</th>
                        <th>User</th>
                    </tr>
                </thead>
            </table>
            <div style="max-height: 150px; overflow-y: auto;"> <!-- Scrollable section for rows -->
                <table class="table table-striped table-hover mb-0">
                    <tbody>
                        @foreach (var overdueItem in ViewBag.OverdueReturns)
                        {
                            <tr onclick="window.location.href='@Url.Action("EditCheckedOutAsset", "CheckedOutAssets", new { checkedoutid = overdueItem.CheckedOutID })'" style="cursor: pointer;">
                                <td>@overdueItem.AssetName</td>
                                <td>@overdueItem.DueDate?.ToString("MMM dd, yyyy")</td>
                                <td>@overdueItem.UserName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <br />
        <!-- Upcoming Returns -->
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Upcoming</th>
                    <th>Return Date</th>
                    <th>User</th>
                </tr>
            </thead>
        </table>
        <div style="max-height: 150px; overflow-y: auto;"> <!-- Scrollable section for rows -->
            <table class="table table-striped table-hover mb-0">
                <tbody>
                    @if (ViewBag.UpcomingReturns != null && ViewBag.UpcomingReturns.Count > 0)
                    {
                        @foreach (var returnItem in ViewBag.UpcomingReturns)
                        {
                            var daysUntilReturn = (returnItem.DueDate - DateTime.Now).Days;
                            var daysText = returnItem.DueDate.Date == DateTime.Now.Date
                                ? "Today"
                                : daysUntilReturn == 0
                                ? "Tomorrow"
                                : $"{daysUntilReturn} days";
                            <tr onclick="window.location.href='@Url.Action("EditCheckedOutAsset", "CheckedOutAssets", new { checkedoutid = returnItem.CheckedOutID })'" style="cursor: pointer;">
                                <td>@returnItem.AssetName</td>
                                <td><strong>@daysText</strong> on @returnItem.DueDate?.ToString("MMM dd, yyyy")</td>
                                <td>@returnItem.UserName</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">You have no new notifications!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

            </div>


    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

<script>
    // Data for Bar Chart
    var officeLabels = [];
    var officeIDs = [];
    var assetsCount = [];
    @foreach (var item in assetCount)
    {
        <text>
            officeLabels.push("@item.OfficeName");
            officeIDs.push("@item.OfficeID");
            assetsCount.push(@item.AssetsCount);
        </text>
    }

    const ctxBar = document.getElementById('assetChart').getContext('2d');
    const maxAssetsCount = Math.max(...assetsCount);

    const assetChart = new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: officeLabels,
            datasets: [{
                label: 'Assets Count',
                data: assetsCount,
                backgroundColor: ['#0b3d91', '#1259a3', '#1768ad', '#2085bf', '#2993c8', '#42a2d9', '#85c1e9'],
                borderColor: ['#0b3d91', '#1259a3', '#1768ad', '#2085bf', '#2993c8', '#42a2d9', '#85c1e9'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                datalabels: {
                    anchor: 'end',
                    align: 'top',
                    formatter: Math.round,
                    color: '#333',
                    font: { size: 14 }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: maxAssetsCount * 1.1 
                }
            },
            onClick: (event, elements) => {
                if (elements.length > 0) { 
                    const index = elements[0].index;
                    const officeID = officeIDs[index]; 
                    
                    // Redirect to the asset view page for the selected office
                    window.location.href = `/Assets/Office/${officeID}`;
                }
            }
        },
        plugins: [ChartDataLabels]
    });

    // Pie Chart: Phone Availability
    const ctxPhone = document.getElementById('phoneChart').getContext('2d');
    const phoneChart = new Chart(ctxPhone, {
        type: 'pie',
        data: {
            labels: ['Available', 'Checked Out'],
            datasets: [{
                data: [@phoneAvailability, 100 - @phoneAvailability],
                backgroundColor: ['#1b5daa', '#ddd'],
                borderColor: ['#1b5daa', '#ddd']
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: true },
                datalabels: {
                    color: '#333',
                    font: { size: 14 },
                    formatter: (value) => value + '%'
                }
            }
        },
        plugins: [ChartDataLabels]
    });

    // Pie Chart: Laptop Availability
    const ctxLaptop = document.getElementById('laptopChart').getContext('2d');
    const laptopChart = new Chart(ctxLaptop, {
        type: 'pie',
        data: {
            labels: ['Available', 'Checked Out'],
            datasets: [{
                data: [@laptopAvailability, 100 - @laptopAvailability],
                backgroundColor: ['#023e83', '#ddd'],
                    borderColor: ['#023e83', '#ddd']
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: true },
                datalabels: {
                    color: '#333',
                    font: { size: 14 },
                    formatter: (value) => value + '%'
                }
            }
        },
        plugins: [ChartDataLabels]
    });
</script>

<style>

            .container-wrapper {
                display: flex;
                justify-content: center;
                width: 100%;
                padding: 20px;
            }

            .form-container {
                width: 2100px;
                padding: 50px;
                border: 2px solid #ddd;
                border-radius: 8px;
                background-color: #fdfdfd;
                box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
            }
    
    .container-fluid {
        background-color: #f8f9fa;
    }



    .card {
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        border: none;
    }

    .card-title {
        font-weight: bold;
        color: #333;
    }

    #assetChart {
        height: 400px;
    }

    #phoneChart, #laptopChart {
        width: 350px !important; 
        height: 350px !important; 
    }

        #notificationsContainer {
            width: 100%;
            max-height: 950px;
            overflow-y: auto;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            background-color: #fff;
        }

        /* Ensure the notifications container takes full height within its column */
        .col-md-4 > #notificationsContainer {
            height: 100%;
        }


        #notifications .list-group-item {
            color: #333;
            background-color: #f8f9fa;
            border: none;
        }

            #notifications .list-group-item:nth-child(even) {
                background-color: #e9ecef;
            }


        .logo-top-right {
            position: absolute;
            top: 40px; /* Adjust as needed */
            right: 90px; /* Adjust as needed */
        }

            .logo-top-right img {
                max-width: 100px; /* Adjust the size as needed */
                height: auto;
            }
</style>
