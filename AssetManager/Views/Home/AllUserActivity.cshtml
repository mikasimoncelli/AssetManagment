@model IEnumerable<AssetManager.Models.ActivityLog>

@{
    ViewData["Title"] = "All User Activities";
}

<div class="container-wrapper">
    <div class="form-container-small">
        <h3 class="text-center">All Activity for @Model.First().User.FirstName @Model.First().User.LastName</h3>

        <!-- Timezone and Date Range Selection -->
        <div class="filter-section">
            <div class="filter-left">
                <label for="timezone-select">Time:</label>
                <select id="timezone-select" name="timezone" onchange="filterActivities()" class="custom-select">
                    <option value="last7days">Last 7 Days</option>
                    <option value="last30days">Last 30 Days</option>
                    <option value="last3months">Last 3 Months</option>
                    <option value="custom">Custom Range</option>
                </select>
            </div>

            <div id="custom-date-range" class="custom-date-range" style="display: none;">
                <label for="start-date">Start Date:</label>
                <input type="date" id="start-date" name="start-date" class="custom-date-picker">
                <label for="end-date">End Date:</label>
                <input type="date" id="end-date" name="end-date" class="custom-date-picker">
                <button onclick="filterActivities()" class="apply-btn">Apply</button>
            </div>
        </div>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Activity Type</th>
                    <th>Description</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody id="activity-log-body">
                @foreach (var log in Model)
                {
                    string url = ""; // Initialize url to avoid null reference issues

                    var descriptionParts = log.Description.Split(' ');
                    var lastNumberString = descriptionParts.Length > 0 ? descriptionParts[descriptionParts.Length - 1] : string.Empty;
                    if (int.TryParse(lastNumberString, out int id))
                    {
                        switch (log.ActivityType)
                        {
                            case "CreateAsset":
                            case "EditAsset":
                                url = Url.Action("ViewAsset", "Assets", new { id = id });
                                break;
                            case "CreateLoan":
                            case "EditLoan":
                            case "LoanReturned":
                                url = Url.Action("EditCheckedOutAsset", "CheckedOutAssets", new { checkedoutid = id });
                                break;
                            case "EditDisposal":
                            case "CreateDisposal":
                                url = Url.Action("EditDisposal", "Disposals", new { id = id });
                                break;
                            case "CreateDamage":
                            case "EditDamage":
                                url = Url.Action("EditAssetDamage", "Damages", new { id = id });
                                break;
                        }
                    }

                    <tr onclick="location.href='@url'" class="clickable-row">
                        <td>
                            @{
                                var activityTypeDisplay = log.ActivityType switch
                                {
                                    "CreateAsset" => "Created New Asset",
                                    "EditAsset" => "Edited Asset",
                                    "CreateLoan" => "Created New Loan",
                                    "EditLoan" => "Edited Loan",
                                    "LoanReturned" => "Loan Returned",
                                    "EditDisposal" => "Edited Disposal Form",
                                    "CreateDisposal" => "Created Disposal Form",
                                    "CreateDamage" => "Created Damage Report",
                                    "EditDamage" => "Edited Damage Report",
                                    _ => log.ActivityType
                                };
                            }
                            @activityTypeDisplay
                        </td>
                        <td>@log.Description</td>
                        <td>@log.CreatedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" class="btn btn-secondary" style="width: 150px;" onclick="window.location.href='@Url.Action("Account", "Home")'">
            Back
        </button>
    </div>
</div>

<style>
    .container-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px;
    }

    .form-container-small {
        margin-top: 20px;
        padding: 30px;
        background-color: #ffffff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
    }

    h3 {
        margin-bottom: 20px;
        font-weight: 600;
        color: #333;
    }

    .table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
    }

        .table th, .table td {
            padding: 10px;
            text-align: left;
            vertical-align: middle;
        }

        .table th {
            background-color: #f2f2f2;
            color: #333;
            font-weight: 600;
        }

    .table-striped tbody tr:nth-child(odd) {
        background-color: #f9f9f9;
    }

    .table-bordered {
        border: 1px solid #ddd;
    }

    .clickable-row {
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .clickable-row:hover {
            background-color: #f1f1f1;
        }

    .filter-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        font-family: 'Arial', sans-serif;
    }

    .filter-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .custom-select {
        width: 180px;
        cursor: pointer;
        background-color: #fff;
        border-color: #ccc;
        padding: 8px 12px;
        font-size: 14px;
        border-radius: 5px;
    }

    .custom-date-range {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .custom-date-picker {
        padding: 8px 12px;
        border-radius: 5px;
        border: 1px solid #ccc;
        font-size: 14px;
    }

    .apply-btn {
        background-color: #5e9fff;
        color: white;
        border: none;
        cursor: pointer;
        padding: 8px 12px;
        font-size: 14px;
        border-radius: 5px;
    }

        .apply-btn:hover {
            background-color: #4a8cd1;
        }
</style>

<script>
    function filterActivities() {
        var selectedRange = document.getElementById('timezone-select').value;
        var customRangeSection = document.getElementById('custom-date-range');
        var startDateInput = document.getElementById('start-date').value;
        var endDateInput = document.getElementById('end-date').value;

        if (selectedRange === 'custom') {
            customRangeSection.style.display = 'block';
        } else {
            customRangeSection.style.display = 'none';
        }

        var startDate = new Date(startDateInput);
        var endDate = new Date(endDateInput);

        var rows = document.querySelectorAll('#activity-log-body tr');
        rows.forEach(row => {
            var dateCell = row.cells[2]; // Adjusted for correct date column index
            var rowDate = new Date(dateCell.innerText);

            if (selectedRange === 'custom') {
                if (startDateInput && endDateInput) {
                    if (rowDate >= startDate && rowDate <= endDate) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                } else {
                    row.style.display = '';
                }
            } else {
                row.style.display = ''; // Implement other range filtering logic if needed
            }
        });
    }
</script>
