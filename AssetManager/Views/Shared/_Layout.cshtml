                    </button>
                    <div class="collapse" id="checkedout-collapse">
                        <ul class="list-unstyled fw-normal pt-2 ms-5">
                            <li><a asp-controller="CheckedOutAssets" asp-action="Index" class="link-dark rounded">View All Loans</a></li>

                            <li><a asp-controller="CheckedOutAssets" asp-action="ViewAvailableAssets" class="link-dark rounded">Create New Loan</a></li>
                            <li><a asp-controller="CheckedOutAssets" asp-action="ReturnedAssets" class="link-dark rounded">View Returned Loans</a></li>
                        </ul>
                    </div>
                </li>


                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed arrow-item" data-bs-toggle="collapse" data-bs-target="#damages-collapse" aria-expanded="false">
                        <span><i class="bi bi-exclamation-triangle-fill me-3 ms-4"></i>Damages</span>
                    </button>
                    <div class="collapse" id="damages-collapse">
                        <ul class="list-unstyled fw-normal pt-2 ms-5">
                            <li><a asp-controller="Damages" asp-action="Index" class="link-dark rounded">View All Damages</a></li>

                            <li><a asp-controller="Damages" asp-action="ReportNewDamage" class="link-dark rounded">Report New Damage</a></li>
                        </ul>
                    </div>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed arrow-item" data-bs-toggle="collapse" data-bs-target="#disposals-collapse" aria-expanded="false">
                        <span> <i class="bi bi-trash-fill me-3 ms-4"></i> Disposals</span>
                    </button>
                    <div class="collapse" id="disposals-collapse">
                        <ul class="list-unstyled fw-normal pt-2 ms-5">
                            <li><a asp-controller="Disposals" asp-action="Index" class="link-dark rounded">View All Disposals</a></li>

                            <li><a asp-controller="Disposals" asp-action="ReportNewDisposal" class="link-dark rounded">Report New Disposal</a></li>
                        </ul>
                    </div>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed arrow-item" data-bs-toggle="collapse" data-bs-target="#users-collapse" aria-expanded="false">
                        <span><i class="bi bi-people-fill me-3 ms-4"></i> Manage Users</span>
                    </button>
                    <div class="collapse" id="users-collapse">
                        <ul class="list-unstyled fw-normal pt-2 ms-5">
                            <li><a asp-controller="Users" asp-action="Index" class="link-dark rounded">View All Users</a></li>
                            <li><a asp-controller="Users" asp-action="AddUser" class="link-dark rounded">Add New User</a></li>
                        </ul>
                    </div>
                </li>
                <li class="mb-1">
                    <button id="home-toggle" class="btn btn-toggle align-items-center rounded" onclick="location.href='@Url.Action("Reports", "Home")'">
                        <i class="bi bi-file-earmark-pdf-fill me-3 ms-4"></i> Reports
                    </button>

                </li>
            </ul>

            
        </div>

        <div class="container-fluid">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>


<div class="search-overlay" id="searchOverlay">
    <input type="text" id="searchInput" class="search-bar" placeholder="Search for assets, users, or offices..." oninput="filterResults()">
    <button id="closeSearch" onclick="closeSearch()">Close</button>
    <div id="searchResults" class="results-container"></div>
</div>






    <footer>
        <div class="social-icons">
            <a href="https://facebook.com" target="_blank"><i class="bi bi-facebook"></i></a>
            <a href="https://twitter.com" target="_blank"><i class="bi bi-twitter"></i></a>
            <a href="https://linkedin.com" target="_blank"><i class="bi bi-linkedin"></i></a>
        </div>
        <p>&copy; 2024 Your Company. All Rights Reserved.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var collapsibles = document.querySelectorAll('.btn-toggle');

            collapsibles.forEach(function (button) {
                var target = button.getAttribute('data-bs-target');

                var isExpanded = localStorage.getItem(target);
                if (isExpanded === 'true') {
                    var collapseElement = document.querySelector(target);
                    var bsCollapse = new bootstrap.Collapse(collapseElement, {
                        toggle: false
                    });
                    bsCollapse.show();
                }

                button.addEventListener('click', function () {
                    var isCurrentlyExpanded = button.getAttribute('aria-expanded') === 'true';
                    localStorage.setItem(target, isCurrentlyExpanded ? 'true' : 'false');
                });
            });
        });



// Function to open the search overlay
function openSearch() {
    document.getElementById('searchOverlay').style.display = 'flex';
    document.getElementById('searchInput').focus();
}

// Function to close the search overlay
function closeSearch() {
    document.getElementById('searchOverlay').style.display = 'none';
    document.getElementById('searchInput').value = '';
    document.getElementById('searchResults').innerHTML = '';
}


       // Prepare data from ViewBag
        const assets = @Html.Raw(Json.Serialize(ViewBag.Assets));
        const users = @Html.Raw(Json.Serialize(ViewBag.Users));
        const offices = @Html.Raw(Json.Serialize(ViewBag.Offices));
        
        // Combine all entities into a single array
        const allData = [
            ...assets.map(a => ({ type: "Asset", name: a.Description, id: a.AssetID })),
            ...users.map(u => ({ type: "User", name: `${u.FirstName} ${u.LastName}`, id: u.UserID })),
            ...offices.map(o => ({ type: "Office", name: o.OfficeName, id: o.OfficeID }))
        ];

        // Function to filter results based on input
        function filterResults() {
            const query = document.getElementById("searchInput").value.toLowerCase();
            const resultsContainer = document.getElementById("searchResults");
            resultsContainer.innerHTML = ""; // Clear previous results

            // Filter and display matching results
            const filteredResults = allData.filter(item => item.name.toLowerCase().includes(query));
            if (filteredResults.length > 0) {
                filteredResults.forEach(result => {
                    const resultDiv = document.createElement("div");
                    resultDiv.classList.add("result-item");
                    resultDiv.textContent = `${result.type}: ${result.name}`;
                    resultDiv.onclick = () => window.location.href = `/${result.type}s/Edit/${result.id}`;
                    resultsContainer.appendChild(resultDiv);
                });
            } else {
                resultsContainer.innerHTML = "<p>No results found</p>";
            }
        }

        // Function to close the search overlay
        function closeSearch() {
            document.getElementById("searchOverlay").style.display = "none";
            document.getElementById("searchInput").value = "";
            document.getElementById("searchResults").innerHTML = "";
        }





    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

<style>
    
.results-container {
    margin-top: 20px;
    max-height: 200px;
    overflow-y: auto;
    width: 60%;
    background-color: #fff;
    border-radius: 4px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    padding: 10px;
}

.result-item {
    padding: 10px;
    cursor: pointer;
}

.result-item:hover {
    background-color: #f0f0f0;
}

/* Overlay Background */
.search-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1000;
    align-items: flex-start;
    padding-top: 40px; /* Space from the top of the screen */
}

/* Centered Search Bar */
.search-bar {
    position: relative;
    width: 50%; /* Make it wider */
    max-width: 1200px;
    margin: 0 auto;
    padding: 10px; /* Reduced padding for a shorter height */
    font-size: 18px;
    border: none;
    border-radius: 5px;
    background-color: #e0e0e0; /* Light grey background */
    color: #333;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
        transform: translateX(20%) translateY(200px);

}

/* Close Button */
.close-btn {
    background: transparent;
    color: #333;
    font-size: 24px;
    border: none;
    cursor: pointer;
    position: absolute;
    top: 15px;
    right: 15px;
}


/* Search Results Styling */
.search-results {
    max-height: 300px;
    overflow-y: auto;
    text-align: left;
}



    .sidebar .btn-toggle i,
