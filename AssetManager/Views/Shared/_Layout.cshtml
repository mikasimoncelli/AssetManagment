                            <li><a asp-controller="CheckedOutAssets" asp-action="ViewAvailableAssets" class="link-dark rounded">Create New Loan</a></li>
                            <li><a asp-controller="CheckedOutAssets" asp-action="ReturnedAssets" class="link-dark rounded">View Returned Loans</a></li>
                        </ul>
                    </div>
                </li>


                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed arrow-item" data-bs-toggle="collapse" data-bs-target="#damages-collapse" aria-expanded="false">
                        <span><i class="bi bi-exclamation-triangle-fill me-3 ms-4"></i>Damages</span>
                    </button>
                    <div class="collapse" id="damages-collapse">
                        <ul class="list-unstyled fw-normal pt-2 ms-5">
                            <li><a asp-controller="Damages" asp-action="Index" class="link-dark rounded">View All Damages</a></li>

                            <li><a asp-controller="Damages" asp-action="ReportNewDamage" class="link-dark rounded">Report New Damage</a></li>
                        </ul>
                    </div>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed arrow-item" data-bs-toggle="collapse" data-bs-target="#disposals-collapse" aria-expanded="false">
                        <span> <i class="bi bi-trash-fill me-3 ms-4"></i> Disposals</span>
                    </button>
                    <div class="collapse" id="disposals-collapse">
                        <ul class="list-unstyled fw-normal pt-2 ms-5">
                            <li><a asp-controller="Disposals" asp-action="Index" class="link-dark rounded">View All Disposals</a></li>

                            <li><a asp-controller="Disposals" asp-action="ReportNewDisposal" class="link-dark rounded">Report New Disposal</a></li>
                        </ul>
                    </div>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed arrow-item" data-bs-toggle="collapse" data-bs-target="#users-collapse" aria-expanded="false">
                        <span><i class="bi bi-people-fill me-3 ms-4"></i> Manage Users</span>
                    </button>
                    <div class="collapse" id="users-collapse">
                        <ul class="list-unstyled fw-normal pt-2 ms-5">
                            <li><a asp-controller="Users" asp-action="Index" class="link-dark rounded">View All Users</a></li>
                            <li><a asp-controller="Users" asp-action="AddUser" class="link-dark rounded">Add New User</a></li>
                        </ul>
                    </div>
                </li>
                <li class="mb-1">
                    <button id="home-toggle" class="btn btn-toggle align-items-center rounded" onclick="location.href='@Url.Action("Reports", "Home")'">
                        <i class="bi bi-file-earmark-pdf-fill me-3 ms-4"></i> Reports
                    </button>

                </li>
            </ul>

            
        </div>

        <div class="container-fluid">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>


<div class="search-overlay" id="searchOverlay">
    <div style="position: relative; width: 100%; text-align: center;">
        <input
            type="text"
            id="searchInput"
            class="search-bar"
            placeholder="Search for assets, users, or offices..."
            oninput="filterResults()"
        />
        <button id="closeSearch" onclick="closeSearch()">Close</button>
    </div>
    <div id="searchResults" class="results-container"></div>
</div>






    <footer>
        <div class="social-icons">
            <a href="https://facebook.com" target="_blank"><i class="bi bi-facebook"></i></a>
            <a href="https://twitter.com" target="_blank"><i class="bi bi-twitter"></i></a>
            <a href="https://linkedin.com" target="_blank"><i class="bi bi-linkedin"></i></a>
        </div>
        <p>&copy; 2024 Your Company. All Rights Reserved.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var collapsibles = document.querySelectorAll('.btn-toggle');

            collapsibles.forEach(function (button) {
                var target = button.getAttribute('data-bs-target');

                var isExpanded = localStorage.getItem(target);
                if (isExpanded === 'true') {
                    var collapseElement = document.querySelector(target);
                    var bsCollapse = new bootstrap.Collapse(collapseElement, {
                        toggle: false
                    });
                    bsCollapse.show();
                }

                button.addEventListener('click', function () {
                    var isCurrentlyExpanded = button.getAttribute('aria-expanded') === 'true';
                    localStorage.setItem(target, isCurrentlyExpanded ? 'true' : 'false');
                });
            });
        });

document.addEventListener('DOMContentLoaded', function () {
    // DOM Elements
    const searchButton = document.getElementById('search-toggle');
    const closeButton = document.getElementById('closeSearch');
    const searchOverlay = document.getElementById('searchOverlay');
    const searchInput = document.getElementById('searchInput');
    const resultsContainer = document.getElementById('searchResults');

    // Load data from the backend via ViewBag
    const assets = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.AssetsData));
        console.log("Assets Data:", assets); // Check in browser console if data is loaded

    // Open the search overlay
    searchButton.addEventListener('click', () => {
        searchOverlay.style.display = 'flex'; // Show overlay
        searchInput.focus(); // Focus on the input field
    });

    // Close the search overlay
    closeButton.addEventListener('click', () => {
        searchOverlay.style.display = 'none'; // Hide overlay
        searchInput.value = ''; // Clear the input field
        resultsContainer.innerHTML = ''; // Clear previous results
        resultsContainer.style.display = 'none'; // Hide results container
    });

    // Real-time search filtering
    searchInput.addEventListener('input', function () {
        const query = searchInput.value.toLowerCase(); // Get user input
        resultsContainer.innerHTML = ''; // Clear previous results

        if (!query) {
            resultsContainer.style.display = 'none'; // Hide results container if no query
            return;
        }

        // Filter results by the 'name' field
        const filteredResults = assets.filter(item =>
            item.name.toLowerCase().includes(query)
        );

        // Display results
        resultsContainer.style.display = 'block';

        if (filteredResults.length > 0) {
            filteredResults.forEach(result => {
                const resultDiv = document.createElement('div');
                resultDiv.classList.add('result-item');
                resultDiv.textContent = `${result.type}: ${result.name}`; // Show type and name
                resultDiv.onclick = () => window.location.href = `/${result.type}s/Edit/${result.id}`; // Navigate to edit page
                resultsContainer.appendChild(resultDiv); // Add to results container
            });
        } else {
            resultsContainer.innerHTML = '<p>No results found</p>';
        }
    });
});






    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

<style>
/* Search Overlay Styles */
.search-overlay {
    display: none; /* Hidden by default */
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7); /* Semi-transparent background */
    z-index: 1000; /* Ensure it overlays other elements */
    justify-content: center;
    align-items: flex-start;
    padding-top: 100px;
}

/* Search Bar Styling */
.search-bar {
    width: 60%;
    max-width: 800px;
    margin: 0 auto;
    padding: 10px;
    font-size: 18px;
    border: none;
    border-radius: 5px;
    background-color: #fff;
    color: #333;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}

/* Close Button Styling */
#closeSearch {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: transparent;
    border: none;
    color: #fff;
    font-size: 18px;
    cursor: pointer;
}

/* Search Results Container */
.results-container {
    display: none; /* Hidden until results are shown */
    margin-top: 20px;
    position: absolute;
    width: 60%;
    max-width: 800px;
    background-color: #fff;
    border-radius: 4px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    padding: 10px;
    max-height: 300px;
    overflow-y: auto;
    z-index: 2001; /* Ensure it's above the overlay */
}

/* Individual Result Item */
.result-item {
    padding: 10px;
    font-size: 16px;
    color: #333;
    cursor: pointer;
    border-bottom: 1px solid #ddd;
    transition: background-color 0.3s ease;
}

.result-item:hover {
    background-color: #f0f0f0;
}

/* Equipment Type Section */
.equipment-type-section {
    margin-bottom: 30px;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 5px;
    background-color: #fff;
}

/* Table Styling */
.table-responsive {
    overflow-x: auto;
}

.assetTable {
    width: 100%;
}

th, td {
    padding: 8px;
}

th {
    background-color: #0b3d91;
    color: #fff;
}

/* Placeholder for "No Results" */
.results-container p {
    text-align: center;
    font-size: 18px;
    color: #666;
    margin: 20px 0;
}




