    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>


        document.addEventListener('DOMContentLoaded', function () {
            // Use unique selectors
            const searchButton = document.getElementById('search-toggle');
            const closeButton = document.getElementById('closeSearch-page1');
            const searchOverlay = document.getElementById('searchOverlay-page1');
            const searchInput = document.getElementById('searchInput-page1');
            const assetsTable = document.getElementById('assetsTable-page1');
            const assetsTableBody = document.getElementById('assetsTableBody-page1');

            let allData = []; // To store fetched data (assets, users, and offices)

            // Open search overlay and fetch data
            searchButton?.addEventListener('click', (event) => {
                event.stopPropagation();
                searchOverlay.style.display = 'block';
                searchInput.focus();

                if (allData.length === 0) {
                    fetch('/Home/GetAllData')
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Error fetching data');
                            }
                            return response.json();
                        })
                        .then(data => {
                            allData = data;
                        })
                        .catch(error => {
                            console.error('Error fetching data:', error);
                        });
                }
            });

            // Close search overlay
            closeButton?.addEventListener('click', () => {
                clearSearch();
            });

            // Event listener to close the overlay when clicking outside the search bar or overlay
            document.addEventListener('click', function (event) {
                // Check if the clicked element is not the search input and not part of the overlay
                if (
                    searchOverlay.style.display === 'block' && // Only trigger if the overlay is visible
                    !searchInput.contains(event.target) && // Click is not on the input field
                    !searchOverlay.contains(event.target) // Click is not on the overlay itself
                ) {
                    clearSearch();
                }
            });

            searchOverlay.addEventListener('click', (event) => {
                event.stopPropagation();
            });

            function clearSearch() {
                searchOverlay.style.display = 'none';
                searchInput.value = '';
                assetsTable.style.display = 'none';
                assetsTableBody.innerHTML = '';
            }

            searchInput?.addEventListener('input', () => {
                const query = searchInput.value.toLowerCase().trim();

                if (!query) {
                    assetsTable.style.display = 'none';
                    return;
                }

                const filteredData = allData.filter(item =>
                    Object.values(item).some(value =>
                        String(value).toLowerCase().includes(query)
                    )
                );

                populateTable(filteredData);
            });

            function populateTable(filteredData) {
                assetsTableBody.innerHTML = '';

                if (filteredData.length === 0) {
                    assetsTableBody.innerHTML = `<tr><td colspan="4">No results found</td></tr>`;
                    return;
                }

                filteredData.forEach(item => {
                    const row = document.createElement('tr');

                    if (item.type === 'Asset') {
                        row.className = 'type-asset';
                        row.innerHTML = `
                            <td>${item.description || ''}</td>
                            <td>${item.manufacturer || ''}</td>
                            <td>${item.assetNumber || ''}</td>
                            <td>${item.serialNumber || ''}</td>
                        `;
                        row.addEventListener('click', () => {
                            window.location.href = `/Assets/EditAsset/${item.assetID}`;
                        });
                    } else if (item.type === 'Office') {
                        row.className = 'type-office';
                        row.innerHTML = `
                            <td>${item.officeName || ''}</td>
                            <td>${item.location || ''}</td>
                            <td></td>
                            <td></td>
                        `;
                        row.addEventListener('click', () => {
                            window.location.href = `/Offices/EditOffice/${item.officeID}`;
                        });
                    } else if (item.type === 'User') {
                        row.className = 'type-user';
                        row.innerHTML = `
                            <td>${item.fullName || ''}</td>
                            <td>${item.email || ''}</td>
                            <td></td>
                            <td></td>
                        `;
                        row.addEventListener('click', () => {
                            window.location.href = `/Users/EditUser/${item.userID}`;
                        });
                    }

                    assetsTableBody.appendChild(row);
                });

                assetsTable.style.display = 'table';
            }
        });



        document.addEventListener("DOMContentLoaded", function () {
            const collapsibles = document.querySelectorAll('.btn-toggle[data-bs-toggle="collapse"]');
            const staticButtons = ['home-toggle', 'reports-toggle']; // Static buttons that don't affect collapsibles

            // Function to handle collapsible toggling
            function handleCollapsibleToggling(button) {
                button.addEventListener('click', function () {
                    const target = document.querySelector(this.getAttribute('data-bs-target'));
                    const bootstrapCollapse = bootstrap.Collapse.getInstance(target) || new bootstrap.Collapse(target);

                    // Toggle the clicked collapsible
                    if (target.classList.contains('show')) {
                        bootstrapCollapse.hide(); // Close it if already open
                    } else {
                        // Close all other collapsibles
                        collapsibles.forEach(btn => {
                            const otherTarget = document.querySelector(btn.getAttribute('data-bs-target'));
                            const otherCollapse = bootstrap.Collapse.getInstance(otherTarget);
                            if (otherTarget !== target && otherTarget.classList.contains('show')) {
                                if (otherCollapse) {
                                    otherCollapse.hide();
                                }
                            }
                        });
                        bootstrapCollapse.show(); // Open the clicked one
                    }

                    // Save the state in localStorage (true if expanded, false if collapsed)
                    const isExpanded = target.classList.contains('show');
                    localStorage.setItem(target.id, isExpanded ? 'true' : 'false');
                });
            }

            // Function to restore the state of collapsibles
            function restoreCollapsibleState() {
                collapsibles.forEach(button => {
                    const target = document.querySelector(button.getAttribute('data-bs-target'));
                    const id = target?.getAttribute('id');

                    if (id) {
                        // Retrieve the saved state from localStorage
                        const isExpanded = localStorage.getItem(id) === 'true';

                        // Restore the UI state based on localStorage
                        if (isExpanded) {
                            target.classList.add('show'); // Bootstrap 'show' class
                            button.setAttribute('aria-expanded', 'true');
                        } else {
                            target.classList.remove('show');
                            button.setAttribute('aria-expanded', 'false');
                        }
                    }
                });
            }

            // Function to handle static buttons (home and reports)
            function handleStaticButtons() {
                staticButtons.forEach(id => {
                    const button = document.getElementById(id);
                    if (button) {
                        button.addEventListener('click', function () {
                            // Ensure static buttons do not affect collapsible state
                            // Optionally clear all collapsible states when navigating
                            // localStorage.clear(); // Uncomment if desired
                        });
                    }
                });
            }

            // Initialize all collapsible buttons, restore their states, and handle static buttons
            collapsibles.forEach(handleCollapsibleToggling);
            restoreCollapsibleState();
            handleStaticButtons();
        });


    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

