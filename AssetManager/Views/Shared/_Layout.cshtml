                <span class="display-5 text-white">Asset Manager</span>
            </a>
            <hr>

            <ul class="list-unstyled">
<li class="mb-1">
<button id="search-toggle" class="btn btn-toggle align-items-center rounded">
    <span><i class="bi bi-search me-3 ms-4"></i> Search</span>
</button>

</li>




                </li>
                <li class="mb-1">
                    <button id="home-toggle" class="btn btn-toggle align-items-center rounded" onclick="location.href='@Url.Action("Index", "Home")'">
                        <span><i class="bi bi-house-door-fill me-3 ms-4"></i> Home</span>
                    </button>

                </li>

                <li class="mb-1">
