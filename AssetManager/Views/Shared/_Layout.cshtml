<div class="search-overlay" id="searchOverlay" style="overflow-x: auto">
    <div style="position: relative; width: 100%; text-align: center; margin-bottom: 20px;">
        <input
            type="text"
            id="searchInput"
            class="search-bar"
            placeholder="Search for assets, users, or offices..."
            oninput="filterAssets()"
        />
        <button id="closeSearch" onclick="closeSearch()">Close</button>
    </div>
    <div class="table-responsive">
        <table id="assetsTable" class="table table-sm table-bordered text-center bg-light">
            <thead>
                <tr>

                    <th>Description</th>
                    <th>Manufacturer</th>
                    <th>Asset Number</th>
                    <th>Serial Number</th>
              
                </tr>
            </thead>
            <tbody id="assetsTableBody">
                <!-- Rows will be dynamically added -->
            </tbody>
        </table>
    </div>
</div>






    <footer>
        <div class="social-icons">
            <a href="https://facebook.com" target="_blank"><i class="bi bi-facebook"></i></a>
            <a href="https://twitter.com" target="_blank"><i class="bi bi-twitter"></i></a>
            <a href="https://linkedin.com" target="_blank"><i class="bi bi-linkedin"></i></a>
        </div>
        <p>&copy; 2024 Your Company. All Rights Reserved.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var collapsibles = document.querySelectorAll('.btn-toggle');

            collapsibles.forEach(function (button) {
                var target = button.getAttribute('data-bs-target');

                var isExpanded = localStorage.getItem(target);
                if (isExpanded === 'true') {
                    var collapseElement = document.querySelector(target);
                    var bsCollapse = new bootstrap.Collapse(collapseElement, {
                        toggle: false
                    });
                    bsCollapse.show();
                }

                button.addEventListener('click', function () {
                    var isCurrentlyExpanded = button.getAttribute('aria-expanded') === 'true';
                    localStorage.setItem(target, isCurrentlyExpanded ? 'true' : 'false');
                });
            });
        });




document.addEventListener('DOMContentLoaded', function () {
    const searchButton = document.getElementById('search-toggle');
    const closeButton = document.getElementById('closeSearch');
    const searchOverlay = document.getElementById('searchOverlay');
    const searchInput = document.getElementById('searchInput');
    const assetsTable = document.getElementById('assetsTable');
    const assetsTableBody = document.getElementById('assetsTableBody');

    let allAssets = []; // To store fetched assets for filtering

    // Initially hide the table
    assetsTable.style.display = 'none';

    // Function to populate the table
    function populateTable(assets) {
        assetsTableBody.innerHTML = ""; // Clear existing rows

        if (assets.length === 0) {
            const row = document.createElement('tr');
            row.innerHTML = `<td colspan="6">No assets found</td>`;
            assetsTableBody.appendChild(row);
            return;
        }

        assets.forEach(asset => {
            const row = document.createElement('tr');
            row.onclick = () => navigateToEditAsset(asset.assetID); // Attach click event

            row.innerHTML = `
                <td>${asset.description || ''}</td>
                <td>${asset.manufacturer || ''}</td>
                <td>${asset.assetNumber || ''}</td>
                <td>${asset.serialNumber || ''}</td>
                
            `;
            assetsTableBody.appendChild(row);
        });
    }

    // Function to filter assets
    function filterAssets() {
        const query = searchInput.value.toLowerCase();

        // Show the table only if there's input
        if (query.trim() === '') {
            assetsTable.style.display = 'none';
            return;
        }

        assetsTable.style.display = 'table'; // Show the table if input exists
        const filteredAssets = allAssets.filter(asset => {
            return Object.values(asset).some(value =>
                String(value).toLowerCase().includes(query)
            );
        });
        populateTable(filteredAssets);
    }

    // Open search overlay and fetch assets
    searchButton.addEventListener('click', () => {
        searchOverlay.style.display = 'block'; // Show the overlay
        searchInput.focus(); // Focus the search input

        // Fetch assets if not already fetched
        if (allAssets.length === 0) {
            fetch('/Home/GetAllAssets')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`Error fetching assets: ${response.statusText}`);
                    }
                    return response.json();
                })
                .then(assets => {
                    allAssets = assets;
                })
                .catch(error => console.error('Error fetching assets:', error));
        }
    });

    // Close search overlay
    closeButton.addEventListener('click', () => {
        searchOverlay.style.display = 'none'; // Hide the overlay
        searchInput.value = ''; // Clear the search input
        assetsTable.style.display = 'none'; // Hide the table
        assetsTableBody.innerHTML = ''; // Clear the table
    });

    // Filter assets on input
    searchInput.addEventListener('input', filterAssets);

        // Close search bar when clicking outside
    document.addEventListener('click', function (event) {
        if (!searchOverlay.contains(event.target) && event.target !== searchButton) {
            closeSearch();
        }
    });


    function navigateToEditAsset(id) {
        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.value = ''; // Clear search input
        }
        window.location.href = `/Assets/EditAsset/${id}`;
}


});



    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

<style>
/* Search Overlay Styles */
.search-overlay {
    display: none; /* Hidden by default */
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7); /* Semi-transparent background */
    z-index: 1000; /* Ensure it overlays other elements */
    justify-content: center;
    align-items: flex-start;
    padding-top: 100px;
}

/* Search Bar Styling */
.search-bar {
    width: 60%;
    max-width: 800px;
    margin: 0 auto;
    padding: 10px;
    font-size: 18px;
    border: none;
    border-radius: 5px;
    background-color: #fff;
    color: #333;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}

/* Close Button Styling */
#closeSearch {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: transparent;
    border: none;
    color: #fff;
    font-size: 18px;
    cursor: pointer;
}

/* Search Results Container */
