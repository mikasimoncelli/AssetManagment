<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asset</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.7.2/font/bootstrap-icons.min.css" integrity="sha384-Qas6B3lNjWxC/Z+z69Jp3Byc9LvAedS2C8A11yI+/jRj9+vN7y+vn1ddvCk4E+i3" crossorigin="anonymous">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">
        <div class="d-flex flex-column flex-shrink-0 p-3 bg-dark sidebar" style="width: 320px;">
            <a href="@Url.Action("Index", "Home")"
               class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-dark text-decoration-none">
                <svg class="bi me-2" width="40" height="32"><use xlink:href="#bootstrap"></use></svg>
                <span class="display-5 text-white">Asset Manager</span>
            </a>
            <hr>

            <ul class="list-unstyled">
                <li class="mb-1">
                    <a id="home-toggle" asp-controller="Home" asp-action="Index" class="btn btn-toggle align-items-center rounded">
                        Home<span class="bi bi-house-door-fill"></span>

                    </a>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed" data-bs-toggle="collapse" data-bs-target="#assets-collapse" aria-expanded="false">
                        Manage Assets
                    </button>
                    <div class="collapse" id="assets-collapse">
                        <ul class="list-unstyled fw-normal pt-2">
                            <li><a asp-controller="Assets" asp-action="Index" class="link-dark rounded">View All Assets</a></li>
                            <li><a asp-controller="Assets" asp-action="AddAsset" class="link-dark rounded">Add New Asset</a></li>
                            <li><a asp-controller="Offices" asp-action="Index" class="link-dark rounded">View Office Assets</a></li>



                        </ul>
                    </div>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed" data-bs-toggle="collapse" data-bs-target="#checkedout-collapse" aria-expanded="false">
                        Loans
                    </button>
                    <div class="collapse" id="checkedout-collapse">
                        <ul class="list-unstyled fw-normal pt-2">
                            <li><a asp-controller="CheckedOutAssets" asp-action="Index" class="link-dark rounded">View All Loans</a></li>

                            <li><a asp-controller="CheckedOutAssets" asp-action="ViewAvailableAssets" class="link-dark rounded">Create New Loan</a></li>
                            <li><a asp-controller="CheckedOutAssets" asp-action="ReturnedAssets" class="link-dark rounded">View Returned Loans</a></li>
                        </ul>
                    </div>
                </li>


                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed" data-bs-toggle="collapse" data-bs-target="#damages-collapse" aria-expanded="false">
                        Damages
                    </button>
                    <div class="collapse" id="damages-collapse">
                        <ul class="list-unstyled fw-normal pt-2">
                            <li><a asp-controller="Damages" asp-action="Index" class="link-dark rounded">View All Damages</a></li>

                            <li><a asp-controller="Damages" asp-action="ReportNewDamage" class="link-dark rounded">Report New Damage</a></li>
                        </ul>
                    </div>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed" data-bs-toggle="collapse" data-bs-target="#disposals-collapse" aria-expanded="false">
                        Disposals
                    </button>
                    <div class="collapse" id="disposals-collapse">
                        <ul class="list-unstyled fw-normal pt-2">
                            <li><a asp-controller="Disposals" asp-action="Index" class="link-dark rounded">View All Disposals</a></li>

                            <li><a asp-controller="Disposals" asp-action="ReportNewDisposal" class="link-dark rounded">Report New Disposal</a></li>
                        </ul>
                    </div>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed" data-bs-toggle="collapse" data-bs-target="#users-collapse" aria-expanded="false">
                        Manage Users
                    </button>
                    <div class="collapse" id="users-collapse">
                        <ul class="list-unstyled fw-normal pt-2">
                            <li><a asp-controller="Users" asp-action="Index" class="link-dark rounded">View All Users</a></li>
                            <li><a asp-controller="Users" asp-action="AddUser" class="link-dark rounded">Add New User</a></li>
                        </ul>
                    </div>
                </li>
                <li class="mb-1">
                    <a id="home-toggle" asp-controller="Home" asp-action="Reports" class="btn btn-toggle align-items-center rounded">
                        Reports
                    </a>
                </li>
            </ul>
        </div>

        <div class="container-fluid">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer>
        <div class="social-icons">
            <a href="https://facebook.com" target="_blank"><i class="bi bi-facebook"></i></a>
            <a href="https://twitter.com" target="_blank"><i class="bi bi-twitter"></i></a>
            <a href="https://linkedin.com" target="_blank"><i class="bi bi-linkedin"></i></a>
        </div>
        <p>&copy; 2024 Your Company. All Rights Reserved.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var collapsibles = document.querySelectorAll('.btn-toggle');

            collapsibles.forEach(function (button) {
                var target = button.getAttribute('data-bs-target');

                var isExpanded = localStorage.getItem(target);
                if (isExpanded === 'true') {
                    var collapseElement = document.querySelector(target);
                    var bsCollapse = new bootstrap.Collapse(collapseElement, {
                        toggle: false
                    });
                    bsCollapse.show();
                }

                button.addEventListener('click', function () {
                    var isCurrentlyExpanded = button.getAttribute('aria-expanded') === 'true';
                    localStorage.setItem(target, isCurrentlyExpanded ? 'true' : 'false');
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

<style>
    .btn-toggle i {
        font-size: 16px; /* Adjust icon size */
        color: white; /* Set icon color */
    }

    .link-dark i {
        font-size: 14px; /* Adjust nested icon size */
        color: #007bff; /* Set icon color for nested items */
    }


    .list-unstyled .link-dark {
        font-size: 18px; 
        font-weight: normal;
        color: white;
        text-decoration: none;
    }

        .list-unstyled .link-dark:hover {
            background-color: #007bff;
            color: white;
        }

    .btn-toggle {
        background-color: transparent;
        border: none;
        font-size: 18px;
        font-weight: 500; 

        color: white;
        display: flex;
        align-items: center;
        width: 100%;
        text-align: left;
        padding: 8px 0;
        outline: none;
    }

        .btn-toggle:focus {
            outline: none; 
            box-shadow: none; 
        }

        .btn-toggle::before {
            content: "\1F896";
            font-size: 20px;
            margin-right: 10px;
            transition: transform 0.3s;
            color: white;
        }

        .btn-toggle[aria-expanded="true"]::before {
            content: "\1F897";
        }

        .btn-toggle:hover {
            background-color: #007bff;
            color: white;
        }

            .btn-toggle:hover::before {
                color: white;
            }

    #home-toggle.btn-toggle::before {
        content: "";
    }

    .sidebar {
        position: fixed; 
        top: 0;
        left: 0;
        height: 100vh; 
        width: 320px; 
        background-color: white; 
        color: white;
        flex-shrink: 0;
    }

    .container-fluid {
        margin-left: 320px; 
        background-color: #fdfdfd;
    }


    .list-unstyled.fw-normal.pt-2 li a {
        padding: 5px 15px;
        font-size: 16px; 
        display: block;
        text-decoration: none;

    }

    footer {
        background-color: #f8f9fa;
        padding: 10px;
        text-align: center;
        width: 100%;
        margin-top: auto;
    }

    .social-icons a {
        margin: 0 5px;
        color: #333;
        text-decoration: none;
    }

        .social-icons a:hover {
            color: #007bff;
        }

    .list-unstyled > .mb-1 {
        border-bottom: 1px solid grey; 
        padding-bottom: 10px;
        margin-bottom: 10px;
    }


    .list-unstyled > li {
        padding-bottom: 10px; 
        margin-bottom: 10px;
    }

    .list-unstyled.fw-normal.pt-2 li {
        padding-bottom: 10px;
        margin-bottom: 10px;
    }

        .list-unstyled.fw-normal.pt-2 li:last-child {
            border-bottom: none; 
            margin-bottom: 0; 
        }

        .list-unstyled.fw-normal.pt-2 li:first-child {
        }


</style>
</html>
