    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


<script>
    document.addEventListener('DOMContentLoaded', function () {
    const searchButton = document.getElementById('search-toggle');
    const closeButton = document.getElementById('closeSearch-page1');
    const searchOverlay = document.getElementById('searchOverlay-page1');
    const searchInput = document.getElementById('searchInput-page1');
    const assetsTable = document.getElementById('assetsTable-page1');
    const assetsTableBody = document.getElementById('assetsTableBody-page1');

    let allData = []; // To store fetched data (assets, users, and offices)

    // Open search overlay and fetch data
    searchButton.addEventListener('click', () => {
        searchOverlay.style.display = 'block'; // Show the overlay
        searchInput.focus(); // Focus the search bar

        if (allData.length === 0) {
            fetch('/Home/GetAllData')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Error fetching data');
                    }
                    return response.json();
                })
                .then(data => {
                    allData = data; // Store fetched data
                })
                .catch(error => {
                    console.error('Error fetching data:', error);
                });
        }
    });

    // Close search overlay when clicking the close button
    closeButton.addEventListener('click', () => {
        clearSearch(); // Clear and close the search
    });

    // Close search overlay when clicking outside of the search area
    document.addEventListener('click', (event) => {
        if (
            !searchOverlay.contains(event.target) && // If click is outside the overlay
            event.target !== searchButton // And not on the search button
        ) {
            clearSearch(); // Close the overlay
        }
    });

    // Prevent clicks inside the overlay from closing it
    searchOverlay.addEventListener('click', (event) => {
        event.stopPropagation(); // Stop the click from bubbling up
    });

    // Clear search bar and table content
    function clearSearch() {
        searchOverlay.style.display = 'none'; // Hide the overlay
        searchInput.value = ''; // Clear search input
        assetsTable.style.display = 'none'; // Hide the table
        assetsTableBody.innerHTML = ''; // Clear table content
    }

    // Filter data based on search query
    searchInput.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim();

        if (!query) {
            assetsTable.style.display = 'none'; // Hide the table if no query
            return;
        }

        const filteredData = allData.filter(item =>
            Object.values(item).some(value =>
                String(value).toLowerCase().includes(query)
            )
        );

        populateTable(filteredData); // Populate the table with filtered results
    });

    // Populate the table with data
    function populateTable(filteredData) {
        assetsTableBody.innerHTML = ''; // Clear table content

        if (filteredData.length === 0) {
            assetsTableBody.innerHTML = `<tr><td colspan="4">No results found</td></tr>`;
            return;
        }

        filteredData.forEach(item => {
            const row = document.createElement('tr');

            // Assign row class for coloring
            if (item.type === 'Asset') {
                row.className = 'type-asset';
                row.innerHTML = `
                    <td>${item.description || ''}</td>
                    <td>${item.manufacturer || ''}</td>
                    <td>${item.assetNumber || ''}</td>
                    <td>${item.serialNumber || ''}</td>
                `;

                // Add click event for Asset rows
                row.addEventListener('click', () => {
                    window.location.href = `/Assets/EditAsset/${item.assetID}`;
                });
            } else if (item.type === 'Office') {
                row.className = 'type-office';
                row.innerHTML = `
                    <td>${item.officeName || ''}</td>
                    <td>${item.location || ''}</td>
                    <td></td>
                    <td></td>
                `;

                // Add click event for Office rows
                row.addEventListener('click', () => {
                    window.location.href = `/Offices/EditOffice/${item.officeID}`;
                });
            } else if (item.type === 'User') {
                row.className = 'type-user';
                row.innerHTML = `
                    <td>${item.fullName || ''}</td>
                    <td>${item.email || ''}</td>
                    <td></td>
                    <td></td>
                `;

                // Add click event for User rows
                row.addEventListener('click', () => {
                    window.location.href = `/Users/EditUser/${item.userID}`;
                });
            }

            // Append the row to the table body
            assetsTableBody.appendChild(row);
        });

        assetsTable.style.display = 'table'; // Show the table
    }
});

</script>





    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const collapsibleMenuIds = ['assets-collapse', 'loans-collapse', 'damages-collapse', 'disposals-collapse', 'users-collapse'];

            // Function to save menu state to localStorage
            function saveMenuState(id, isOpen) {
                localStorage.setItem(id, isOpen ? 'true' : 'false');
            }

            // Function to restore menu state
            function restoreMenuState() {
                collapsibleMenuIds.forEach(id => {
                    const state = localStorage.getItem(id); // Get state from localStorage
                    const collapseElement = document.getElementById(id);

                    if (state === 'true') {
                        // Manually open the collapsible menu
                        collapseElement.classList.add('show');
                        collapseElement.previousElementSibling.setAttribute('aria-expanded', 'true');
                    } else {
                        collapseElement.classList.remove('show');
                        collapseElement.previousElementSibling.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            // Add event listeners to all collapsible buttons to save their state on toggle
            collapsibleMenuIds.forEach(id => {
                const button = document.querySelector(`[data-bs-target="#${id}"]`);
                const collapseElement = document.getElementById(id);

                collapseElement.addEventListener('shown.bs.collapse', () => {
                    saveMenuState(id, true); // Menu is open
                });

                collapseElement.addEventListener('hidden.bs.collapse', () => {
                    saveMenuState(id, false); // Menu is closed
                });
            });

            // Restore the saved state on page load
            restoreMenuState();
        });


    </script>



</body>
