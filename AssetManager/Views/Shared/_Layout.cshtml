<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asset Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.7.2/font/bootstrap-icons.min.css" integrity="sha384-Qas6B3lNjWxC/Z+z69Jp3Byc9LvAedS2C8A11yI+/jRj9+vN7y+vn1ddvCk4E+i3" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.5.0/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="icon" type="image/x-icon" href="~/images/favicon-32x32.png" />

</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">
        <div class="d-flex flex-column flex-shrink-0 p-3 bg-dark sidebar" style="width: 320px;">
            <a href="@Url.Action("Index", "Home")"
               class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-dark text-decoration-none">
                <svg class="bi me-2" width="40" height="32"><use xlink:href="#bootstrap"></use></svg>
                <span class="display-5 text-white">Asset Manager</span>
            </a>
            <hr>

            <ul class="list-unstyled">
 <li class="mb-1">
    <button id="home-toggle" class="btn btn-toggle align-items-center rounded" onclick="openSearch()">
        <span><i class="bi bi-search me-3 ms-4"></i> Search</span>
    </button>
</li>


                </li>
                <li class="mb-1">
                    <button id="home-toggle" class="btn btn-toggle align-items-center rounded" onclick="location.href='@Url.Action("Index", "Home")'">
                        <span><i class="bi bi-house-door-fill me-3 ms-4"></i> Home</span>
                    </button>

                </li>

                <li class="mb-1">
