<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asset</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="d-flex" style="min-height: 100vh;">
        <div class="d-flex flex-column flex-shrink-0 p-3 bg-light sidebar" style="width: 280px;">
            <a href="@Url.Action("Index", "Home")"
               class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-dark text-decoration-none">
                <svg class="bi me-2" width="40" height="32"><use xlink:href="#bootstrap"></use></svg>
                <span class="fs-4">Asset Management</span>
            </a>
            <hr>

            <ul class="list-unstyled">
                <li class="mb-1">
                    <a id="home-toggle" asp-controller="Home" asp-action="Index" class="btn btn-toggle align-items-center rounded">
                        Home
                    </a>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed" data-bs-toggle="collapse" data-bs-target="#assets-collapse" aria-expanded="false">
                        Manage Assets
                    </button>
                    <div class="collapse" id="assets-collapse">
                        <ul class="list-unstyled fw-normal pt-2">
                            <li><a asp-controller="Assets" asp-action="Index" class="link-dark rounded">View All Assets</a></li>
                            <li><a asp-controller="Assets" asp-action="AddAsset" class="link-dark rounded">Add New Asset</a></li>
                            <li><a asp-controller="Assets" asp-action="AllDamagedAssets" class="link-dark rounded">View Damaged Assets</a></li>


                        </ul>
                    </div>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed" data-bs-toggle="collapse" data-bs-target="#checkedout-collapse" aria-expanded="false">
                        Loans
                    </button>
                    <div class="collapse" id="checkedout-collapse">
                        <ul class="list-unstyled fw-normal pt-2">
                            <li><a asp-controller="CheckedOutAssets" asp-action="ViewAvailableAssets" class="link-dark rounded">New Loan</a></li>
                            <li><a asp-controller="CheckedOutAssets" asp-action="Index" class="link-dark rounded">On Loan</a></li>
                            <li><a asp-controller="CheckedOutAssets" asp-action="ReturnedAssets" class="link-dark rounded">Returned Assets</a></li>
                        </ul>
                    </div>
                </li>

                <li class="mb-1">
                    <button class="btn btn-toggle align-items-center rounded collapsed" data-bs-toggle="collapse" data-bs-target="#users-collapse" aria-expanded="false">
                        Manage Users
                    </button>
                    <div class="collapse" id="users-collapse">
                        <ul class="list-unstyled fw-normal pt-2">
                            <li><a asp-controller="Users" asp-action="Index" class="link-dark rounded">View All Users</a></li>
                            <li><a asp-controller="Users" asp-action="AddUser" class="link-dark rounded">Add New User</a></li>
                        </ul>
                    </div>
                </li>
            </ul>
        </div>

        <div class="container-fluid">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer>
        <div class="social-icons">
            <a href="https://facebook.com" target="_blank"><i class="bi bi-facebook"></i></a>
            <a href="https://twitter.com" target="_blank"><i class="bi bi-twitter"></i></a>
            <a href="https://linkedin.com" target="_blank"><i class="bi bi-linkedin"></i></a>
        </div>
        <p>&copy; 2024 Your Company. All Rights Reserved.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var collapsibles = document.querySelectorAll('.btn-toggle');

            collapsibles.forEach(function (button) {
                var target = button.getAttribute('data-bs-target');

                var isExpanded = localStorage.getItem(target);
                if (isExpanded === 'true') {
                    var collapseElement = document.querySelector(target);
                    var bsCollapse = new bootstrap.Collapse(collapseElement, {
                        toggle: false
                    });
                    bsCollapse.show();
                }

                button.addEventListener('click', function () {
                    var isCurrentlyExpanded = button.getAttribute('aria-expanded') === 'true';
                    localStorage.setItem(target, isCurrentlyExpanded ? 'true' : 'false');
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

<style>
    /* Sidebar Link Styles */
    .list-unstyled .link-dark {
        font-size: 18px; /* Larger font for submenu */
        font-weight: normal;
        color: black;
        text-decoration: none;
    }

        .list-unstyled .link-dark:hover {
            background-color: #007bff;
            color: white;
        }

    /* Sidebar Button Styles */
    .btn-toggle {
        background-color: transparent;
        border: none;
        font-size: 18px; /* Increased font size */
        font-weight: bold;
        color: black;
        display: flex;
        align-items: center;
        width: 100%;
        text-align: left;
        padding: 8px 0;
        outline: none;
    }

        .btn-toggle:focus {
            outline: none; /* Removes blue border on click */
            box-shadow: none; /* Removes any focus outline */
        }

        .btn-toggle::before {
            content: "\27A4";
            font-size: 20px;
            margin-right: 10px;
            transition: transform 0.3s;
            color: black;
        }

        .btn-toggle[aria-expanded="true"]::before {
            content: "\25BC";
        }

        .btn-toggle:hover {
            background-color: #007bff;
            color: white;
        }

            .btn-toggle:hover::before {
                color: white;
            }

    #home-toggle.btn-toggle::before {
        content: "";
    }

    /* Sidebar */
    .sidebar {
        position: relative;
        height: 100vh;
    }

    /* Spacing and style adjustments for submenu items */
    .list-unstyled.fw-normal.pt-2 li a {
        padding: 5px 15px;
        font-size: 16px; /* Slightly larger submenu items */
        display: block;
        text-decoration: none;
    }

    /* Footer Styles */
    footer {
        background-color: #f8f9fa;
        padding: 10px;
        text-align: center;
        width: 100%;
        margin-top: auto;
    }

    .social-icons a {
        margin: 0 5px;
        color: #333;
        text-decoration: none;
    }

        .social-icons a:hover {
            color: #007bff;
        }

    .list-unstyled > li {
        border-bottom: 1px solid #ddd; /* Light gray line */
        padding-bottom: 10px; /* Space between item content and border */
        margin-bottom: 10px; /* Space below each item */
    }

    /* Removes the border on the last submenu item in each list */
    .list-unstyled.fw-normal.pt-2 li {
        border-bottom: 1px solid #ddd; /* Adds the line to all items */
        padding-bottom: 10px;
        margin-bottom: 10px;
    }

        .list-unstyled.fw-normal.pt-2 li:last-child {
            border-bottom: none; /* Removes the line only for the last item */
            margin-bottom: 0; /* Removes extra spacing below the last item */
        }

        .list-unstyled.fw-normal.pt-2 li:first-child {
            border-top: 1px solid #ddd;
        }


</style>
</html>
