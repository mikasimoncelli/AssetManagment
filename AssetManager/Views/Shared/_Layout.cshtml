<div class="search-overlay" id="searchOverlay" style="overflow-x: auto">
    <div style="position: relative; width: 100%; text-align: center; margin-bottom: 20px;">
        <input
            type="text"
            id="searchInput"
            class="search-bar"
            placeholder="Search for assets, users, or offices..."
        />
        <button id="closeSearch" onclick="closeSearch()">Close</button>
    </div>
    <div class="table-responsive">
<table id="assetsTable" class="modern-table table table-bordered">
    <thead>
        <tr>
            <th>Type</th>
            <th>Description</th>
            <th>Manufacturer</th>
            <th>Asset Number</th>
            <th>Serial Number</th>
            <th>Office Name</th>
            <th>Office Location</th>
            <th>Full Name</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody id="assetsTableBody">
        <!-- Rows will be dynamically added -->
    </tbody>
</table>

    </div>
</div>






    <footer>
        <div class="social-icons">
            <a href="https://facebook.com" target="_blank"><i class="bi bi-facebook"></i></a>
            <a href="https://twitter.com" target="_blank"><i class="bi bi-twitter"></i></a>
            <a href="https://linkedin.com" target="_blank"><i class="bi bi-linkedin"></i></a>
        </div>
        <p>&copy; 2024 Your Company. All Rights Reserved.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var collapsibles = document.querySelectorAll('.btn-toggle');

            collapsibles.forEach(function (button) {
                var target = button.getAttribute('data-bs-target');

                var isExpanded = localStorage.getItem(target);
                if (isExpanded === 'true') {
                    var collapseElement = document.querySelector(target);
                    var bsCollapse = new bootstrap.Collapse(collapseElement, {
                        toggle: false
                    });
                    bsCollapse.show();
                }

                button.addEventListener('click', function () {
                    var isCurrentlyExpanded = button.getAttribute('aria-expanded') === 'true';
                    localStorage.setItem(target, isCurrentlyExpanded ? 'true' : 'false');
                });
            });
        });


document.addEventListener('DOMContentLoaded', function () {
    const searchButton = document.getElementById('search-toggle');
    const closeButton = document.getElementById('closeSearch');
    const searchOverlay = document.getElementById('searchOverlay');
    const searchInput = document.getElementById('searchInput');
    const assetsTable = document.getElementById('assetsTable');
    const assetsTableBody = document.getElementById('assetsTableBody');

    let allData = []; // To store fetched data (assets, users, and offices)

    // Open search overlay and fetch data
    searchButton.addEventListener('click', () => {
        searchOverlay.style.display = 'block'; // Show the overlay
        searchInput.focus(); // Focus the search bar

        if (allData.length === 0) {
            fetch('/Home/GetAllData')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Error fetching data');
                    }
                    return response.json();
                })
                .then(data => {
                    allData = data; // Store fetched data
                })
                .catch(error => {
                    console.error('Error fetching data:', error);
                });
        }
    });

    // Close search overlay when clicking the close button
    closeButton.addEventListener('click', () => {
        clearSearch(); // Clear and close the search
    });

    // Close search overlay when clicking outside of the search area
    document.addEventListener('click', (event) => {
        if (
            !searchOverlay.contains(event.target) && // If click is outside the overlay
            event.target !== searchButton // And not on the search button
        ) {
            clearSearch(); // Close the overlay
        }
    });

    // Prevent clicks inside the overlay from closing it
    searchOverlay.addEventListener('click', (event) => {
        event.stopPropagation(); // Stop the click from bubbling up
    });

    // Clear search bar and table content
    function clearSearch() {
        searchOverlay.style.display = 'none'; // Hide the overlay
        searchInput.value = ''; // Clear search input
        assetsTable.style.display = 'none'; // Hide the table
        assetsTableBody.innerHTML = ''; // Clear table content
    }

    // Filter data based on search query
    searchInput.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim();

        if (!query) {
            assetsTable.style.display = 'none'; // Hide the table if no query
            return;
        }

        const filteredData = allData.filter(item =>
            Object.values(item).some(value =>
                String(value).toLowerCase().includes(query)
            )
        );

        populateTable(filteredData); // Populate the table with filtered results
    });

    // Populate the table with data
    function populateTable(filteredData) {
        assetsTableBody.innerHTML = ''; // Clear table content

        if (filteredData.length === 0) {
            assetsTableBody.innerHTML = `<tr><td colspan="4">No results found</td></tr>`;
            return;
        }

        filteredData.forEach(item => {
            const row = document.createElement('tr');

            // Assign row class for coloring
            if (item.type === 'Asset') {
                row.className = 'type-asset';
                row.innerHTML = `
                    <td>${item.description || ''}</td>
                    <td>${item.manufacturer || ''}</td>
                    <td>${item.assetNumber || ''}</td>
                    <td>${item.serialNumber || ''}</td>
                `;

                // Add click event for Asset rows
                row.addEventListener('click', () => {
                    window.location.href = `/Assets/EditAsset/${item.assetID}`;
                });
            } else if (item.type === 'Office') {
                row.className = 'type-office';
                row.innerHTML = `
                    <td>${item.officeName || ''}</td>
                    <td>${item.location || ''}</td>
                    <td></td>
                    <td></td>
                `;

                // Add click event for Office rows
                row.addEventListener('click', () => {
                    window.location.href = `/Offices/EditOffice/${item.officeID}`;
                });
            } else if (item.type === 'User') {
                row.className = 'type-user';
                row.innerHTML = `
                    <td>${item.fullName || ''}</td>
                    <td>${item.email || ''}</td>
                    <td></td>
                    <td></td>
                `;

                // Add click event for User rows
                row.addEventListener('click', () => {
                    window.location.href = `/Users/EditUser/${item.userID}`;
                });
            }

            // Append the row to the table body
            assetsTableBody.appendChild(row);
        });

        assetsTable.style.display = 'table'; // Show the table
    }
});





    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

<style>
/* Search Overlay Styles */
.search-overlay {
    display: none; /* Hidden by default */
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7); /* Semi-transparent background */
    z-index: 1000; /* Ensure it overlays other elements */
    justify-content: center;
    align-items: flex-start;
    padding-top: 100px;
}

/* Search Bar Styling */
.search-bar {
    width: 60%;
    max-width: 800px;
    margin: 0 auto;
    padding: 10px;
    font-size: 18px;
    border: none;
    border-radius: 5px;
    background-color: #fff;
    color: #333;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}

/* Close Button Styling */
#closeSearch {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: transparent;
    border: none;
    color: #fff;
    font-size: 18px;
    cursor: pointer;
}

/* Search Results Container */
.results-container {
    display: none; /* Hidden until results are shown */
    margin-top: 20px;
    position: absolute;
    width: 60%;
    max-width: 500px;
    background-color: #fff;
    border-radius: 4px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    padding: 10px;
    max-height: 300px;
    overflow-y: auto;
    z-index: 2001; /* Ensure it's above the overlay */
}

/* Individual Result Item */
.result-item {
    padding: 10px;
    font-size: 16px;
    color: #333;
    cursor: pointer;
    border-bottom: 1px solid #ddd;
    transition: background-color 0.3s ease;
}

.result-item:hover {
    background-color: #f0f0f0;
}
/* Placeholder for "No Results" */
.results-container p {
    text-align: center;
    font-size: 18px;
    color: #666;
    margin: 20px 0;
}


    




