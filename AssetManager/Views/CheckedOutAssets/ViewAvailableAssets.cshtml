@model IEnumerable<AssetManager.Models.CheckedOutAsset>

<div class="container-fluid" style="min-height: 100vh; padding: 0 20px;">
    <h3 class="text-center mt-4 mb-4">Available Assets</h3>

    <!-- Global Search and Reset Filters -->
    <div class="row justify-content-center mb-3">
        <div class="col-md-10">
            <div class="input-group mb-3">
                <input type="text" id="searchInput" class="form-control" placeholder="Search assets..." onkeyup="applyGlobalSearch()" style="margin-right: 20px;" />
                <button type="button" class="btn btn-primary" onclick="resetAllFilters()">Reset Search</button>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="table-responsive">
                @foreach (var equipmentGroup in ((IEnumerable<Asset>)ViewBag.availableAssets).GroupBy(a => a.EquipmentType))
                {
                    <!-- Equipment Type Header -->
                    <div class="equipment-type-section">
                        <h4 class="text-center mt-4 mb-3" style="color: #343a40; padding-bottom: 5px;">@equipmentGroup.Key</h4>

                        <table class="table table-bordered text-center table-sm asset-table">
                            <thead>
                                <tr>
                                    <th class="equal-width">
                                        <div style="color: black;">Description</div>
                                        <select onchange="applyColumnFilter(this, 0)">
                                            <option value="">All</option>
                                            @foreach (var desc in equipmentGroup.Select(a => a.Description).Distinct())
                                            {
                                                <option value="@desc">@desc</option>
                                            }
                                        </select>
                                    </th>
                                    <th class="equal-width">
                                        <div style="color: black;">Manufacturer</div>
                                        <select onchange="applyColumnFilter(this, 1)">
                                            <option value="">All</option>
                                            @foreach (var manufacturer in equipmentGroup.Select(a => a.Manufacturer).Distinct())
                                            {
                                                <option value="@manufacturer">@manufacturer</option>
                                            }
                                        </select>
                                    </th>
                                    <th class="equal-width">
                                        <div style="color: black;">Asset Number</div>
                                        <select onchange="applyColumnFilter(this, 2)">
                                            <option value="">All</option>
                                            @foreach (var assetNum in equipmentGroup.Select(a => a.AssetNumber).Distinct())
                                            {
                                                <option value="@assetNum">@assetNum</option>
                                            }
                                        </select>
                                    </th>
                                    <th class="equal-width">
                                        <div style="color: black;">Serial Number</div>
                                        <select onchange="applyColumnFilter(this, 3)">
                                            <option value="">All</option>
                                            @foreach (var serial in equipmentGroup.Select(a => a.SerialNumber).Distinct())
                                            {
                                                <option value="@serial">@serial</option>
                                            }
                                        </select>
                                    </th>
                                    <th class="equal-width">
                                        <div style="color: black;">Office Name</div>
                                        <select onchange="applyColumnFilter(this, 4)">
                                            <option value="">All</option>
                                            @foreach (var officeName in equipmentGroup.Select(a => a.Office.OfficeName).Distinct())
                                            {
                                                <option value="@officeName">@officeName</option>
                                            }
                                        </select>
                                    </th>
                                    <th class="equal-width">
                                        <div style="color: black;">Office Location</div>
                                        <select onchange="applyColumnFilter(this, 5)">
                                            <option value="">All</option>
                                            @foreach (var location in equipmentGroup.Select(a => a.Office.Location).Distinct())
                                            {
                                                <option value="@location">@location</option>
                                            }
                                        </select>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asset in equipmentGroup)
                                {
                                    <tr onclick="window.location.href='@Url.Action("AddNewCheckedOutAsset", "CheckedOutAssets", new { id = asset.AssetID })'">
                                        <td>@asset.Description</td>
                                        <td>@asset.Manufacturer</td>
                                        <td>@asset.AssetNumber</td>
                                        <td>@asset.SerialNumber</td>
                                        <td>@asset.Office.OfficeName</td>
                                        <td>@asset.Office.Location</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    const filterValues = {};

        // ... existing JavaScript functions remain unchanged
</script>

<style>
    .equipment-type-section {
        margin-bottom: 30px;
    }


    h4 {
        color: #333;
        font-weight: bold;
        border-bottom: 2px solid #007bff;
        padding-bottom: 5px;
        margin-bottom: 20px;
    }

    .equal-width {
        width: 16.6%;
    }

    tr {
        cursor: pointer;
    }

        tr:hover {
            background-color: #f5f5f5;
        }

    th {
        cursor: pointer;
        background-color: #f8f9fa; /* Changed header background to a light grey for readability */
    }

        th:hover {
            background-color: #e9ecef;
        }
</style>
