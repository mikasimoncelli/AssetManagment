@model IEnumerable<AssetManager.Models.CheckedOutAsset>
@{
    ViewData["Title"] = "Available Assets";
}

<div class="container-wrapper">
    <div class="form-container-small">

        <h3 class="text-center mb-4" style="border: 1px">Available Assets For Loan</h3>
        <p class="text-muted mt-2 text-center" style="font-size: 0.875rem;">Please select asset type to view availble assets for loan. Optionally select a location.</p>
        <div class="row justify-content-center mb-3">
            <div class="col-md-5">
                <label for="assetTypeDropdown" class="form-label">Select Asset Type:</label>
                <select id="assetTypeDropdown" class="form-control mb-3" onchange="applyFilters()">
                    <option value="All">All Types</option> 
                    @foreach (var type in ((IEnumerable<Asset>)ViewBag.availableAssets).Select(a => a.EquipmentType).Distinct())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            <div class="col-md-5">
                <label for="officeDropdown" class="form-label">Select Office:</label>
                <select id="officeDropdown" class="form-control mb-3" onchange="applyFilters()">
                    <option value="Any">Any</option>
                    @foreach (var office in ((IEnumerable<Asset>)ViewBag.availableAssets).Select(a => a.Office.OfficeName).Distinct())
                    {
                        <option value="@office">@office</option>
                    }
                </select>
            </div>
        </div>

        <div id="noResultsMessage" class="text-center mt-4" style="display: none;">
            <p>Sorry, no results.</p>
        </div>

        <div id="assetsSection" style="display: none;">
            <div class="table-responsive">
                @foreach (var equipmentGroup in ((IEnumerable<Asset>)ViewBag.availableAssets).GroupBy(a => a.EquipmentType))
                {
                    <div class="equipment-type-section" data-type="@equipmentGroup.Key" style="display: none;">
                        <h5 class="mt-4 mb-3" style="color: #343a40; padding-bottom: 5px;">
                            @equipmentGroup.Key</h5>

                        <table class="table table-bordered text-center table-sm asset-table">
                            <thead>
                                <tr style="background-color: #0b3d91; color: #fff;">
                                    <th>Description</th>
                                    <th>Manufacturer</th>
                                    <th>Asset Number</th>
                                    <th>Serial Number</th>
                                    <th>Office Name</th>
                                    <th>Office Location</th>
                                </tr>
                            </thead>
                            <tbody id="assetsTableBody">
                                @foreach (var asset in equipmentGroup)
                                {
                                    <tr class="asset-row" data-type="@asset.EquipmentType" data-office="@asset.Office.OfficeName" onclick="window.location.href='@Url.Action("AddNewCheckedOutAsset", "CheckedOutAssets", new { id = asset.AssetID })'">
                                        <td>@asset.Description</td>
                                        <td>@asset.Manufacturer</td>
                                        <td>@asset.AssetNumber</td>
                                        <td>@asset.SerialNumber</td>
                                        <td>@asset.Office.OfficeName</td>
                                        <td>@asset.Office.Location</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function applyFilters() {
        const selectedType = document.getElementById("assetTypeDropdown").value;
        const selectedOffice = document.getElementById("officeDropdown").value;

        // Check if the default "All Types" option is selected
        if (selectedType === "All") {
            document.getElementById("assetsSection").style.display = "none"; // Hide table
            document.getElementById("noResultsMessage").style.display = "none"; // Hide no results message
            return; // Exit function if "All Types" is selected
        }

        // Only show the results if an asset type is selected
        if (selectedType) {
            document.getElementById("assetsSection").style.display = "block";
            filterAssets(selectedType, selectedOffice);
        } else {
            document.getElementById("assetsSection").style.display = "none";
            document.getElementById("noResultsMessage").style.display = "none";
        }
    }

    function filterAssets(selectedType, selectedOffice) {
        let hasResults = false;

        // Hide all equipment sections initially
        document.querySelectorAll(".equipment-type-section").forEach(section => {
            section.style.display = "none";
        });

        // Show only the matching equipment section
        const equipmentSection = document.querySelector(`.equipment-type-section[data-type="${selectedType}"]`);
        if (equipmentSection) {
            equipmentSection.style.display = "block";
            equipmentSection.querySelectorAll(".asset-row").forEach(row => {
                const assetOffice = row.getAttribute("data-office");

                // Show all rows if "Any" is selected, otherwise match specific office
                const isVisible = (selectedOffice === "Any" || assetOffice === selectedOffice);
                row.style.display = isVisible ? "" : "none";

                if (isVisible) hasResults = true;
            });
        }

        // Show or hide the no results message based on whether there are matching results
        document.getElementById("assetsSection").style.display = hasResults ? "block" : "none";
        document.getElementById("noResultsMessage").style.display = hasResults ? "none" : "block";
    }
</script>

<style>
    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;

    }

    .form-container {
        width: 1500px;
        padding: 50px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
        margin-top: 20px;
        max-height: 80vh;
        overflow-y: auto;
    }

    .asset-table {
        width: 100%;
        border: solid 1px #ddd;
        margin: 0 auto;
    }

    th, td {
        cursor: pointer;
        padding: 8px;
    }

        th:hover, tr:hover {
            background-color: #dcdcdc;
        }

    .equipment-type-section {
        margin-bottom: 30px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
        text-align: center;
    }
</style>
