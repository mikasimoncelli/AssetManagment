@model IEnumerable<AssetManager.Models.CheckedOutAsset>
@{
    ViewData["Title"] = "All Loans";
}

<div class="container-wrapper">
    <div class="form-container">
        <div class="logo-top-right">
            <img src="~/images/Favicon.jpg" alt="Company Logo" class="img-fluid">
        </div>

        <div class="row mb-4 align-items-center">
            <div class="col-sm">
                <!-- Small black label -->
                <p class="mb-0 ms-5" style="font-size: 1rem; color: black;">Total Loans:</p>
                <!-- Large blue number below the label -->
                <h2 class="mb-0 ms-5" style="font-size: 5rem; color: #0b3d91;">@ViewBag.LoansCount</h2>
            </div>
            <div class="col-md-auto text-center">
                <h2 class="display-4 mx-auto" style="width: fit-content;">Assets On Loan</h2>
            </div>

            <div class="col"></div>

        </div>

    <!-- Global Search and Filter -->
    <div class="row justify-content-center mb-3">
        <div class="col-md-10">
            <!-- Type Filter Dropdown -->
            <h6 for="assetTypeDropdown" class="form-label">Filter by Asset Type:</h6>
            <select id="assetTypeDropdown" class="form-control mb-3" onchange="filterAssetType()">
                <option value="">All Asset Types</option>
                @if (ViewBag.checkedOutAssets != null)
                {
                    @foreach (var type in ((IEnumerable<AssetManager.Models.CheckedOutAsset>)ViewBag.checkedOutAssets)
                   .Select(c => c.Asset.EquipmentType).Distinct())
                    {
                        <option value="@type">@type</option>
                    }
                }
            </select>

            <!-- Search Bar and Reset Button -->
            <div class="input-group mb-3">
                <input type="text" id="searchInput" class="form-control" placeholder="Search assets..." onkeyup="applyGlobalSearch()" style="margin-right: 20px;" />
                <button type="button" class="btn btn-primary" onclick="resetAllFilters()">Reset Search</button>
            </div>
        </div>
    </div>

    <!-- Table Containers for each Equipment Type -->
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="table-responsive">
                @if (ViewBag.checkedOutAssets != null)
                {
                    @foreach (var equipmentGroup in ((IEnumerable<AssetManager.Models.CheckedOutAsset>)ViewBag.checkedOutAssets)
                   .GroupBy(c => c.Asset.EquipmentType))
                    {
                        <!-- Individual Table for Each Equipment Type -->
                        <div class="equipment-type-section" data-type="@equipmentGroup.Key">
                            <h4 class="text-center mt-4 mb-3 display-6" style="color: #343a40; padding-bottom: 5px;">@($"{equipmentGroup.Key}")s</h4>

                            <table class="table table-bordered text-center table-sm asset-table">
                                <thead>
                                        <tr style="background-color: #0b3d91; color: #fff;">
                                        <th>Date Lent Out</th>
                                        <th>Checked Out ID</th>
                                        <th>Equipment Type</th>
                                        <th>Description</th>
                                        <th>User First Name</th>
                                        <th>User Last Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var asset in equipmentGroup)
                                    {
                                        <tr onclick="window.location.href='@Url.Action("EditCheckedOutAsset", "CheckedOutAssets", new { checkedoutid = asset.CheckedOutID })'">
                                            <td>@asset.DateLentOut.ToString("yyyy-MM-dd")</td>
                                            <td>@asset.CheckedOutID</td>
                                            <td>@asset.Asset.EquipmentType</td>
                                            <td>@(asset.Asset != null ? asset.Asset.Description : "Unknown Asset")</td>
                                            <td>@(asset.User != null ? asset.User.FirstName : "Unknown User")</td>
                                            <td>@(asset.User != null ? asset.User.LastName : "Unknown User")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    <p>No checked-out assets to display.</p>
                }
            </div>
        </div>
    </div>
</div>

<script>
    // Filter by asset type
    function filterAssetType() {
        const selectedType = document.getElementById("assetTypeDropdown").value.toLowerCase();
        document.querySelectorAll(".equipment-type-section").forEach(section => {
            const type = section.getAttribute("data-type").toLowerCase();
            section.style.display = selectedType && type !== selectedType ? "none" : "block";
            });
        }

    // Global search function with type table hiding
        function applyGlobalSearch() {
        const searchValue = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll(".equipment-type-section").forEach(section => {
            const rows = section.querySelectorAll("tbody tr");
            let rowMatchCount = 0;

            rows.forEach(row => {
                const rowText = Array.from(row.cells).map(cell => cell.textContent.toLowerCase()).join(" ");
                const isVisible = rowText.includes(searchValue);
                    row.style.display = isVisible ? "" : "none";
                if (isVisible) rowMatchCount++;
            });

            // Hide the section if no rows match
            section.style.display = rowMatchCount > 0 ? "block" : "none";
        });
        }

        // Reset all filters
        function resetAllFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('assetTypeDropdown').value = '';
            document.querySelectorAll(".equipment-type-section").forEach(section => {
                section.style.display = "block";
                section.querySelectorAll("tbody tr").forEach(row => row.style.display = "");
            });
        }
</script>

<style>


        .container-wrapper {
            display: flex;
            justify-content: center;
            width: 100%;
            padding: 20px;
        }

        .form-container {
            width: 2100px;
            padding: 20px;
            border: 2px solid #ddd;
            border-radius: 8px;
            background-color: #fdfdfd;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
        }

        .container-fluid {
            background-color: #f8f9fa;
        }
    .asset-table {
        width: 100%;
        border: solid 1px #ddd;
    }

    th, td {
        cursor: pointer;
        padding: 8px;
    }

        th:hover, tr:hover {
            background-color: #dcdcdc;
        }

    .equipment-type-section {
        margin-bottom: 30px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

        .logo-top-right {
            position: absolute;
            top: 40px; /* Adjust as needed */
            right: 90px; /* Adjust as needed */
        }

            .logo-top-right img {
                max-width: 100px; /* Adjust the size as needed */
                height: auto;
            }
</style>
