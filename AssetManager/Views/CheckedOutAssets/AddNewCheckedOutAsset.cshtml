@model AssetManager.Models.Asset
@{
    var users = ViewBag.Users as List<User>;
}

<div class="container-wrapper">
    <form method="post" action="@Url.Action("AddNewCheckedOutAsset", "CheckedOutAssets")">
        <div class="form-container">
            <h1 class="text-center display-4">Assign Equipment to Staff Member</h1>
            <h5 class="text-center">@Model.Manufacturer - @Model.Description</h5>
            <p class="text-center">Please double-check all details are correct.</p>

            <h6 class="section-title">Loan Details</h6>
            <label for="DueDate">Select User:</label>

            <input type="text" id="userSearchInput" class="form-control" placeholder="Search for a user..." onkeyup="searchUsers()" />
            <ul id="userList" class="list-group mt-2" style="display: none;">
                @foreach (var user in users)
                {
                    <li class="list-group-item list-group-item-action"
                        data-user-id="@user.UserID"
                        data-first-name="@user.FirstName"
                        data-last-name="@user.LastName"
                        data-email="@user.Email"
                        onclick="selectUser(this)">
                        @user.FirstName @user.LastName
                    </li>
                }
            </ul>

            <div id="userDetails" class="mt-4" style="display: none;">
                <h6>Selected User Details</h6>
                <div class="form-group row">
                    <div class="col-md-6">
                        <label>First Name:</label>
                        <p id="userFirstName" class="form-control-plaintext"></p>
                    </div>
                    <div class="col-md-6">
                        <label>Last Name:</label>
                        <p id="userLastName" class="form-control-plaintext"></p>
                    </div>
                    <div class="col-md-12">
                        <label>Email:</label>
                        <p id="userEmail" class="form-control-plaintext"></p>
                    </div>
                </div>
                <button type="button" class="btn btn-secondary mt-3" onclick="deselectUser()">Deselect User</button>
            </div>
            <br />

            <div class="form-group row">
                <div class="col-md-6">
                    <label for="DueDate">Due Date (Optional):</label>
                    <input type="date" class="form-control" name="DueDate" id="DueDate" />
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-12">
                    <label for="Notes">Notes:</label>
                    <textarea class="form-control" id="Notes" name="Notes" rows="4" placeholder="Enter any additional notes here..."></textarea>
                </div>
            </div>

            <h6 class="section-title">Equipment Details</h6>
            <div class="form-group row">
                <div class="col-md-6">
                    <input type="hidden" name="assetID" value="@Model.AssetID" />
                    <input type="hidden" id="userID" name="UserID" />
                    <label>Description:</label>
                    <p class="form-control-plaintext">@Model.Description</p>
                </div>
                <div class="col-md-6">
                    <label>Manufacturer:</label>
                    <p class="form-control-plaintext">@Model.Manufacturer</p>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>Asset Number:</label>
                    <p class="form-control-plaintext">@Model.AssetNumber</p>
                </div>
                <div class="col-md-6">
                    <label>Serial Number:</label>
                    <p class="form-control-plaintext">@Model.SerialNumber</p>
                </div>
            </div>

            <h6 class="section-title">Office Details</h6>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>Office Name:</label>
                    <p class="form-control-plaintext">@Model.Office?.OfficeName</p>
                </div>
                <div class="col-md-6">
                    <label>Location:</label>
                    <p class="form-control-plaintext">@Model.Office?.Location</p>
                </div>
            </div>

    

       

   

            <div class="button-group">
                <button type="button" class="btn btn-primary" onclick="confirmSave()">Save Changes</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function searchUsers() {
            const searchInput = document.getElementById("userSearchInput").value.toLowerCase();
            const userList = document.getElementById("userList");
            const userListItems = Array.from(userList.querySelectorAll("li"));

            console.log("Search input:", searchInput); // Log input
            console.log("User list items count:", userListItems.length); // Log items count

            // Show or hide the list based on input
            userList.style.display = searchInput ? "block" : "none";

            let matchesFound = false;
            userListItems.forEach(item => {
                const firstName = item.getAttribute("data-first-name").toLowerCase();
                const lastName = item.getAttribute("data-last-name").toLowerCase();
                const fullName = `${firstName} ${lastName}`;

                if (fullName.includes(searchInput)) {
                    item.style.display = ""; // Show matching item
                    matchesFound = true;
                } else {
                    item.style.display = "none"; // Hide non-matching item
                }
            });

            // Hide list if no matches found
            if (!matchesFound) {
                userList.style.display = "none";
            }
        }

        function selectUser(userElement) {
            document.getElementById("userFirstName").textContent = userElement.dataset.firstName;
            document.getElementById("userLastName").textContent = userElement.dataset.lastName;
            document.getElementById("userEmail").textContent = userElement.dataset.email;
            document.getElementById("userDetails").style.display = "block";
            document.getElementById("userSearchInput").value = "";
            document.getElementById("userList").style.display = "none";
            document.getElementById("userID").value = userElement.dataset.userId;
        }

        function deselectUser() {
            document.getElementById("userFirstName").textContent = "";
            document.getElementById("userLastName").textContent = "";
            document.getElementById("userEmail").textContent = "";
            document.getElementById("userDetails").style.display = "none";
            document.getElementById("userSearchInput").value = "";
            document.getElementById("userList").style.display = "none";
        }

        function confirmSave() {
            const userConfirmed = confirm("Are you sure you want to save this asset as checked-out?");
            if (userConfirmed) {
                alert("Checked-out asset saved successfully");
                document.querySelector("form").submit();
            }
        }
    </script>
}

<style>
    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;
    }

    .form-container {
        width: 1500px;
        padding: 50px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    .text-center {
        margin-bottom: 30px;
    }

    .section-title {
        border-bottom: 2px solid #ccc;
        margin-top: 30px;
        margin-bottom: 20px;
        padding-bottom: 10px;
        font-size: 1.1rem;
        font-weight: 500;
    }

    label {
        font-weight: bold;
        color: #333;
    }

    .form-control-plaintext {
        background-color: #e9ecef;
        border: 1px solid #ccc;
        padding: 15px;
        border-radius: 4px;
    }

    .form-control {
        background-color: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 12px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

        .btn-primary:hover, .btn-secondary:hover {
            opacity: 0.9;
        }

    .list-group-item {
        cursor: pointer;
    }

        .list-group-item:hover {
            background-color: #e9ecef;
        }
</style>
