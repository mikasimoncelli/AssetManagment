@model AssetManager.Models.CheckedOutAsset

<div class="center-wrapper">
    <form asp-action="EditCheckedOutAsset" method="post">
        <input type="hidden" name="CheckedOutID" value="@Model.CheckedOutID" />

        <div class="form-container full-width">
            <h4 class="text-center">Update Checked-Out Equipment</h4>
            <h5 class="text-center">@Model.Asset.Manufacturer - @Model.Asset.Description</h5>
            <p class="text-center">Please review all details before making changes.</p>

            <!-- Asset Information Section -->
            <h5 class="mt-4">Asset Details</h5>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>Asset Description:</label>
                    <p class="form-control-plaintext">@Model.Asset.Description</p>
                </div>
                <div class="col-md-6">
                    <label>Equipment Type:</label>
                    <p class="form-control-plaintext">@Model.Asset.EquipmentType</p>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>Serial Number:</label>
                    <p class="form-control-plaintext">@Model.Asset.SerialNumber</p>
                </div>
                <div class="col-md-6">
                    <label>Asset Number:</label>
                    <p class="form-control-plaintext">@Model.Asset.AssetNumber</p>
                </div>
            </div>

            <!-- User Information Section -->
            <h5 class="mt-4">User Details</h5>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>User Name:</label>
                    <p class="form-control-plaintext">@Model.User.FirstName @Model.User.LastName</p>
                </div>
                <div class="col-md-6">
                    <label>Email:</label>
                    <p class="form-control-plaintext">@Model.User.Email</p>
                </div>
            </div>

            <!-- Office Information Section -->
            <h5 class="mt-4">Office Details</h5>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>Office Name:</label>
                    <p class="form-control-plaintext">@Model.Asset.Office.OfficeName</p>
                </div>
                <div class="col-md-6">
                    <label>Location:</label>
                    <p class="form-control-plaintext">@Model.Asset.Office.Location</p>
                </div>
            </div>

            <!-- Input Fields for Due Date and Date Returned -->
            <h5 class="mt-4">Update Details</h5>
            <div class="form-group row">
                <div class="col-md-6">
                    <label for="DueDate">Due Date:</label>
                    <input type="date" class="form-control" id="DueDate" name="DueDate"/>
                </div>
                <div class="col-md-6">
                    <label for="DateReturned">Date Returned:</label>
                    <input type="date" class="form-control" id="DateReturned" name="DateReturned" value="@Model.DateReturned?.ToString("yyyy-MM-dd")" />
                </div>
            </div>


            <!-- Save button -->
            <button type="submit" class="btn btn-primary btn-block mt-4">Save Changes</button>
        </div>
    </form>
</div>

<style>
    .center-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
        margin-top: 25px;
        padding-top: 25px;
    }

    .form-container.full-width {
        padding: 30px;
        border: 1px solid #ccc;
        border-radius: 10px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        background-color: #f9f9f9;
    }

    .list-group-item {
        cursor: pointer;
    }

        .list-group-item:hover {
            background-color: #e9ecef;
        }

    label {
        font-weight: bold;
    }
</style>
