@model AssetManager.Models.CheckedOutAsset

<div class="container-wrapper">
    <form asp-action="EditCheckedOutAsset" method="post">
        <input type="hidden" name="CheckedOutID" value="@Model.CheckedOutID" />

        <div class="form-container">
            <h1 class="text-center display-4">Update Loan Details</h1>
            <h5 class="text-center">@Model.Asset.Manufacturer - @Model.Asset.Description</h5>

            <h6 class="section-title">Asset Details</h6>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>Asset Description:</label>
                    <p class="form-control-plaintext">@Model.Asset.Description</p>
                </div>
                <div class="col-md-6">
                    <label>Equipment Type:</label>
                    <p class="form-control-plaintext">@Model.Asset.EquipmentType</p>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>Serial Number:</label>
                    <p class="form-control-plaintext">@Model.Asset.SerialNumber</p>
                </div>
                <div class="col-md-6">
                    <label>Asset Number:</label>
                    <p class="form-control-plaintext">@Model.Asset.AssetNumber</p>
                </div>
            </div>

            <h6 class="section-title">Office Details</h6>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>Office Name:</label>
                    <p class="form-control-plaintext">@Model.Asset.Office?.OfficeName</p>
                </div>
                <div class="col-md-6">
                    <label>Location:</label>
                    <p class="form-control-plaintext">@Model.Asset.Office?.Location</p>
                </div>
            </div>

            <h6 class="section-title">User Details</h6>
            <div class="form-group row">
                <div class="col-md-6">
                    <label>User Name:</label>
                    <p class="form-control-plaintext">@Model.User.FirstName @Model.User.LastName</p>
                </div>
                <div class="col-md-6">
                    <label>Email:</label>
                    <p class="form-control-plaintext">@Model.User.Email</p>
                </div>
            </div>

            <h6 class="section-title">Update Details</h6>
            <div class="form-group row">
                <div class="col-md-6">
                    <label for="DueDate">Due Date:</label>
                    <input type="date" class="form-control" id="DueDate" name="DueDate" value="@Model.DueDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-6">
                    <label for="DateReturned">Date Returned:</label>
                    <input type="date" class="form-control" id="DateReturned" name="DateReturned" value="@Model.DateReturned?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <p>Please review all details before making changes.</p>

            <div class="button-group">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="AllCheckedOutAssets" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </form>
</div>

<style>
    .container-wrapper {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 20px;
    }

    .form-container {
        width: 1000px;
        padding: 50px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #fdfdfd;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

    .text-center {
        margin-bottom: 30px;
    }

    .section-title {
        border-bottom: 2px solid #ccc;
        margin-top: 30px;
        margin-bottom: 20px;
        padding-bottom: 10px;
        font-size: 1.1rem;
        font-weight: 500;
    }

    label {
        font-weight: bold;
        color: #333;
    }

    .form-control-plaintext {
        background-color: #e9ecef;
        border: 1px solid #ccc;
        padding: 15px;
        border-radius: 4px;
    }

    .form-control {
        background-color: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 12px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .button-group {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: #fff;
        border: none;
        padding: 12px 24px;
        border-radius: 4px;
    }

        .btn-primary:hover, .btn-secondary:hover {
            opacity: 0.9;
        }
</style>
