@model IEnumerable<AssetManager.Models.CheckedOutAsset>

<div class="container-wrapper">
    <div class="form-container">
        <h1 class="text-center mt-4 mb-4 display-4">All Returned Assets</h1>

    <!-- Filter and Search aligned with table -->
    <div class="row justify-content-center mb-3">
        <div class="col-md-10">
            <!-- Filter Dropdown aligned with left edge of table -->
            <h6 for="assetTypeDropdown" class="form-label">Filter by Asset Type:</h6>
            <select id="assetTypeDropdown" class="form-control mb-3" onchange="filterAssetType()">
                <option value="">All Asset Types</option>
                @foreach (var type in ((IEnumerable<AssetManager.Models.CheckedOutAsset>)ViewBag.returnedCheckedOutAssets)
                .Select(a => a.Asset.EquipmentType).Distinct())
                {
                    <option value="@type">@type</option>
                }
            </select>

            <!-- Search Bar and Reset Button, also aligned with table edge -->
            <h6 for="searchInput" class="form-label">Search for Asset:</h6>
            <div class="input-group mb-3">
                <input type="text" id="searchInput" class="form-control" placeholder="Search assets..." onkeyup="applyGlobalSearch()" />
                <div class="input-group-append">
                    <button type="button" class="btn btn-primary" onclick="resetAllFilters()">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="table-responsive">
                <!-- Table for Returned Assets grouped by Asset Type -->
                @if (ViewBag.returnedCheckedOutAssets != null)
                {
                    @foreach (var equipmentGroup in ((IEnumerable<AssetManager.Models.CheckedOutAsset>)ViewBag.returnedCheckedOutAssets)
                   .GroupBy(a => a.Asset.EquipmentType))
                    {
                        <div class="equipment-type-section" data-type="@equipmentGroup.Key">
                            <h4 class="text-center mt-4 mb-3" style="color: #343a40; padding-bottom: 5px;">@equipmentGroup.Key</h4>

                            <table class="table table-bordered text-center table-sm assetTable">
                                <thead>
                                    <tr style="background-color: #0d6efd; color: #fff;">
                                        <th>First Name</th>
                                        <th>Last Name</th>
                                        <th>Asset Type</th>
                                        <th>Description</th>
                                        <th>Serial Number</th>
                                        <th>Asset Number</th>
                                        <th>Date Checked Out</th>
                                        <th>Date Returned</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var asset in equipmentGroup)
                                    {
                                        <tr>
                                            <td>@(asset.User != null ? asset.User.FirstName : "Unknown")</td>
                                            <td>@(asset.User != null ? asset.User.LastName : "Unknown")</td>
                                            <td>@(asset.Asset != null ? asset.Asset.EquipmentType : "Unknown")</td>
                                            <td>@(asset.Asset != null ? asset.Asset.Description : "Unknown")</td>
                                            <td>@(asset.Asset != null ? asset.Asset.SerialNumber : "Unknown")</td>
                                            <td>@(asset.Asset != null ? asset.Asset.AssetNumber : "Unknown")</td>
                                            <td>@asset.DateLentOut.ToString("yyyy-MM-dd")</td>
                                            <td>@(asset.DateReturned?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    <p>No returned assets available.</p>
                }
            </div>
        </div>
    </div>
</div>

<script>
    // Filter by asset type
    function filterAssetType() {
        const selectedType = document.getElementById("assetTypeDropdown").value.toLowerCase();
        document.querySelectorAll(".equipment-type-section").forEach(section => {
            const type = section.getAttribute("data-type").toLowerCase();
            section.style.display = selectedType && type !== selectedType ? "none" : "block";
        });
    }

    // Global search function with type table hiding
    function applyGlobalSearch() {
        const searchValue = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll(".equipment-type-section").forEach(section => {
            const rows = section.querySelectorAll("tbody tr");
            let rowMatchCount = 0;

            rows.forEach(row => {
                const rowText = Array.from(row.cells).map(cell => cell.textContent.toLowerCase()).join(" ");
                const isVisible = rowText.includes(searchValue);
                row.style.display = isVisible ? "" : "none";
                if (isVisible) rowMatchCount++;
            });

            // Hide the section if no rows match
            section.style.display = rowMatchCount > 0 ? "block" : "none";
        });
    }

    // Reset all filters
    function resetAllFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('assetTypeDropdown').value = '';
        document.querySelectorAll(".equipment-type-section").forEach(section => {
            section.style.display = "block";
            section.querySelectorAll("tbody tr").forEach(row => row.style.display = "");
        });
    }
</script>

<style>

        .container-wrapper {
            display: flex;
            justify-content: center;
            width: 100%;
            padding: 20px;
        }

        .form-container {
            width: 2100px;
            padding: 50px;
            border: 2px solid #ddd;
            border-radius: 8px;
            background-color: #fdfdfd;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
        }

        .container-fluid {
            background-color: #f8f9fa;
        }

    .assetTable {
        width: 100%;
        border: solid 1px #ddd;
    }

    th, td {
        cursor: pointer;
        padding: 8px;
    }

        th:hover, tr:hover {
            background-color: #dcdcdc;
        }

    .equipment-type-section {
        margin-bottom: 30px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }
</style>
